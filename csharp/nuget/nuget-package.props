<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">3.0.0-rc.1</Version>

    <Authors>Ash Vardanian</Authors>
    <Company>Unum</Company>
    <Description>One Proximity Graph for Search, Sparse Products &amp; Attention, across RAM, VRAM &amp; NVMe</Description>
    <!-- Search keywords, semicolon-separated: each is matched on its own, so a phrase would never hit. -->
    <PackageTags>vector-search;similarity-search;nearest-neighbors;hnsw;embeddings;clustering;simd;gpu</PackageTags>
    <PackageId>Cloud.Unum.USearch</PackageId>

    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/unum-cloud/USearch</PackageProjectUrl>
    <PackageLicenseExpression Condition="'$(PackageLicenseFile)' == ''">Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Copyright>Copyright (c) Unum Cloud</Copyright>
    <RepositoryUrl>https://github.com/unum-cloud/USearch</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <PackageIcon>unum.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeLibDir)runtimes\**\*.*" Pack="true" PackagePath="runtimes" />
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath=""/>
    <None Include="$(RepoRoot)assets\unum.png" Pack="true" PackagePath=""/>
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath=""/>
  </ItemGroup>

  <!-- Package validation https://learn.microsoft.com/en-us/dotnet/fundamentals/package-validation/overview?WT.mc_id=DT-MVP-5003978 -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <EnablePackageValidation Condition="'$(EnablePackageValidation)' == ''">true</EnablePackageValidation>
  </PropertyGroup>

</Project>
