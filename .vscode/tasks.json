{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Host Debug",
      "detail": "Unoptimized C++ and C suites, sanitizers armed",
      "command": "cmake --preset host_debug && cmake --build --preset host_debug",
      "args": [],
      "type": "shell",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Host Release",
      "detail": "Every CPU target, optimized",
      "command": "cmake --preset host_release && cmake --build --preset host_release",
      "args": [],
      "type": "shell",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build Host Profile",
      "detail": "The profiling configuration bench/README.md measures with",
      "command": "cmake --preset host_profile && cmake --build --preset host_profile",
      "args": [],
      "type": "shell",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build CUDA RelWithDebInfo",
      "detail": "Everything including CUDA, narrowed to the host GPU - the tree the language server reads",
      "command": "cmake --preset cuda_relwithdebinfo && cmake --build --preset cuda_relwithdebinfo",
      "args": [],
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$nvcc", "$gcc"]
    },
    {
      "label": "Test CUDA RelWithDebInfo",
      "detail": "CTest over the cuda_relwithdebinfo tree",
      "command": "ctest --preset cuda_relwithdebinfo",
      "args": [],
      "type": "shell",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Swift Build",
      "type": "swift",
      "args": ["build", "--build-tests"],
      "env": {},
      "cwd": "${workspaceFolder}",
      "group": "build"
    }
  ]
}
