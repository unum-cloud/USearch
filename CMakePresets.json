{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja, a build tree named after the preset, and a compilation database for the language server. No compiler is pinned here: the developer presets inherit `clang`, and CI rows override with -D CMAKE_CXX_COMPILER. Export CMAKE_CXX_COMPILER_LAUNCHER=ccache and CMAKE_CUDA_COMPILER_LAUNCHER=ccache to cache objects, the `.cu` units included.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OPTIMIZE_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "description": "Clang, and `lld`, which links the template-heavy targets several times faster than `bfd`.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "library",
      "hidden": true,
      "description": "The C 99 library alone - what the language bindings and packages consume.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USEARCH_BUILD_TEST": "OFF",
        "USEARCH_BUILD_BENCH": "OFF",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_DENSE_DTYPES": "11"
      }
    },
    {
      "name": "wasm",
      "hidden": true,
      "description": "The C library and its test under a WebAssembly toolchain; the C++ suite and benchmarks stay native.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "OFF",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_USE_JEMALLOC": "OFF",
        "USEARCH_DENSE_DTYPES": "11"
      }
    },
    {
      "name": "host_debug",
      "inherits": [
        "base",
        "clang"
      ],
      "displayName": "Host Debug - unit tests with sanitizers",
      "description": "Unoptimized C++ and C suites; the compiler wiring arms the leak sanitizer here.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "OFF",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_BUILD_CUDA": "OFF"
      }
    },
    {
      "name": "host_check",
      "inherits": [
        "base",
        "clang"
      ],
      "displayName": "Host Check - fastest compile cycle",
      "description": "Does it still compile, nothing more. `-O0` is the one flag that moves the needle on these instantiation grids: measured per shard, -O3 and -O1 both cost ~9.8s while -O0 costs 3.5s, against a 2.8s front-end floor.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O0 -Xptxas -O0 -DNDEBUG",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "ON",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_BUILD_CUDA": "OFF"
      }
    },
    {
      "name": "cuda_check",
      "inherits": "host_check",
      "displayName": "CUDA Check - fastest compile cycle with the `.cu` units",
      "description": "Same as `host_check`, plus the `.cu` units, with `ptxas` at `-O0` too, since optimizing each class unit's kernels is what dominates their build.",
      "cacheVariables": {
        "USEARCH_BUILD_CUDA": "ON",
        "USEARCH_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "host_relwithdebinfo",
      "inherits": [
        "base",
        "clang"
      ],
      "displayName": "Host RelWithDebInfo - optimized tests with symbols",
      "description": "Optimized, with full DWARF for stepping through the suites.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "OFF",
        "USEARCH_BUILD_CUDA": "OFF"
      }
    },
    {
      "name": "host_release",
      "inherits": [
        "base",
        "clang"
      ],
      "displayName": "Host Release - every CPU target",
      "description": "The full CPU matrix: C++ suite, benchmarks, the C 99 library and its test.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "ON",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_BUILD_CUDA": "OFF"
      }
    },
    {
      "name": "host_profile",
      "inherits": [
        "base",
        "clang"
      ],
      "displayName": "Host Profile - benchmarks under perf",
      "description": "The profiling tree behind bench/README.md: full optimization, plus the symbols `perf` needs to attribute samples.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG",
        "USEARCH_BUILD_TEST": "OFF",
        "USEARCH_BUILD_BENCH": "ON",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_BUILD_CUDA": "OFF"
      }
    },
    {
      "name": "host_tsan",
      "inherits": [
        "base",
        "gcc"
      ],
      "displayName": "Host TSan - concurrency suites under ThreadSanitizer",
      "description": "GCC & -fsanitize=thread over RelWithDebInfo - the Debug wiring arms ASan & LSan, which TSan cannot share a process with. -O1 keeps the instrumented suites tolerable, and the mutex annotations in sanitizers.hpp light up under this preset alone. Built with GCC: Clang here ships no compiler-rt.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O1 -g -DNDEBUG -fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -DNDEBUG -fsanitize=thread -fno-omit-frame-pointer",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "OFF",
        "USEARCH_BUILD_LIB_C": "OFF",
        "USEARCH_BUILD_CUDA": "OFF"
      }
    },
    {
      "name": "cuda_relwithdebinfo",
      "inherits": [
        "base",
        "clang"
      ],
      "displayName": "CUDA RelWithDebInfo - everything, CUDA included",
      "description": "The iteration tree, and the only one covering the `.cu` units - so `.clangd` reads its database. Optimized enough to run, with line tables instead of full DWARF and the fat binary narrowed to the host GPU.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O2 -lineinfo -DNDEBUG",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "ON",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_BUILD_CUDA": "ON",
        "USEARCH_CUDA_ARCHITECTURES": "native"
      }
    },
    {
      "name": "cuda_trace",
      "inherits": "cuda_relwithdebinfo",
      "displayName": "CUDA Trace - where the build time goes",
      "description": "Emits a .json next to every object; open them in a flame-graph viewer or aggregate with ClangBuildAnalyzer to see which instantiations dominate.",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG -ftime-trace"
      }
    },
    {
      "name": "cuda_release",
      "inherits": "cuda_relwithdebinfo",
      "displayName": "CUDA Release - every architecture, Ampere through Blackwell",
      "description": "Same targets as `cuda_relwithdebinfo`, at Release and emitting every architecture rather than the host GPU - what shipping artifacts and cross-machine runs need.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USEARCH_CUDA_ARCHITECTURES": "80;89;90a;100f;120f"
      }
    },
    {
      "name": "rocm_relwithdebinfo",
      "inherits": "base",
      "displayName": "ROCm RelWithDebInfo - everything, the AMD arms included",
      "description": "ROCm's Clang compiles every unit, the AMD ones device-only into embedded code objects and host-only around them, so the library still loads without `libamdhip64`. Narrowed to MI300's gfx942.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/opt/rocm/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/rocm/llvm/bin/clang++",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "OFF",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_BUILD_CUDA": "OFF",
        "USEARCH_BUILD_ROCM": "ON",
        "USEARCH_ROCM_ARCHITECTURES": "gfx942"
      }
    },
    {
      "name": "rocm_release",
      "inherits": "rocm_relwithdebinfo",
      "displayName": "ROCm Release - every AMD class, CDNA3 through CDNA5",
      "description": "Same targets as `rocm_relwithdebinfo`, at Release and embedding code objects for every AMD class - what shipping artifacts need.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USEARCH_ROCM_ARCHITECTURES": "gfx942;gfx950;gfx1250"
      }
    },
    {
      "name": "host_library",
      "inherits": [
        "base",
        "library"
      ],
      "displayName": "Host Library - the C 99 library alone, for packaging"
    },
    {
      "name": "linux_arm64_library",
      "inherits": [
        "base",
        "library"
      ],
      "displayName": "Linux ARM64 Library - the C 99 library through Clang and LLD",
      "toolchainFile": "${sourceDir}/cmake/toolchain-aarch64-llvm.cmake"
    },
    {
      "name": "android_arm64_library",
      "inherits": [
        "base",
        "library"
      ],
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_ANDROID_STL_TYPE": "c++_static",
        "ANDROID_PLATFORM": "21",
        "ANDROID_ABI": "arm64-v8a"
      }
    },
    {
      "name": "android_armv7_library",
      "inherits": [
        "base",
        "library"
      ],
      "toolchainFile": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_ANDROID_STL_TYPE": "c++_static",
        "ANDROID_PLATFORM": "21",
        "ANDROID_ABI": "armeabi-v7a"
      }
    },
    {
      "name": "wasm32_emscripten_release",
      "inherits": [
        "base",
        "wasm"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm32-emscripten.cmake",
      "cacheVariables": {
        "CMAKE_CROSSCOMPILING_EMULATOR": "node"
      }
    },
    {
      "name": "wasm64_emscripten_release",
      "inherits": [
        "base",
        "wasm"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm64-emscripten.cmake",
      "cacheVariables": {
        "CMAKE_CROSSCOMPILING_EMULATOR": "node"
      }
    },
    {
      "name": "wasm32_wasi_release",
      "inherits": [
        "base",
        "wasm"
      ],
      "toolchainFile": "${sourceDir}/cmake/toolchain-wasm32-wasi.cmake"
    },
    {
      "name": "windows_x64_release",
      "inherits": [
        "base",
        "windows"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "OFF",
        "USEARCH_BUILD_LIB_C": "ON",
        "USEARCH_DENSE_DTYPES": "11"
      }
    },
    {
      "name": "windows_arm64_library",
      "inherits": [
        "base",
        "windows",
        "library"
      ],
      "generator": "Visual Studio 17 2022",
      "architecture": "ARM64"
    }
  ],
  "buildPresets": [
    {
      "name": "host_debug",
      "configurePreset": "host_debug",
      "jobs": 0
    },
    {
      "name": "host_check",
      "configurePreset": "host_check",
      "jobs": 0
    },
    {
      "name": "cuda_check",
      "configurePreset": "cuda_check",
      "jobs": 0
    },
    {
      "name": "host_relwithdebinfo",
      "configurePreset": "host_relwithdebinfo",
      "jobs": 0
    },
    {
      "name": "host_release",
      "configurePreset": "host_release",
      "jobs": 0
    },
    {
      "name": "host_profile",
      "configurePreset": "host_profile",
      "jobs": 0
    },
    {
      "name": "host_tsan",
      "configurePreset": "host_tsan",
      "jobs": 0
    },
    {
      "name": "cuda_relwithdebinfo",
      "configurePreset": "cuda_relwithdebinfo",
      "jobs": 0
    },
    {
      "name": "cuda_trace",
      "configurePreset": "cuda_trace",
      "jobs": 0
    },
    {
      "name": "cuda_release",
      "configurePreset": "cuda_release",
      "jobs": 0
    },
    {
      "name": "rocm_relwithdebinfo",
      "configurePreset": "rocm_relwithdebinfo",
      "jobs": 0
    },
    {
      "name": "rocm_release",
      "configurePreset": "rocm_release",
      "jobs": 0
    },
    {
      "name": "host_library",
      "configurePreset": "host_library",
      "jobs": 0
    },
    {
      "name": "linux_arm64_library",
      "configurePreset": "linux_arm64_library",
      "jobs": 0
    },
    {
      "name": "android_arm64_library",
      "configurePreset": "android_arm64_library",
      "jobs": 0
    },
    {
      "name": "android_armv7_library",
      "configurePreset": "android_armv7_library",
      "jobs": 0
    },
    {
      "name": "wasm32_emscripten_release",
      "configurePreset": "wasm32_emscripten_release",
      "jobs": 0,
      "targets": [
        "usearch_static",
        "usearch_test_c"
      ]
    },
    {
      "name": "wasm64_emscripten_release",
      "configurePreset": "wasm64_emscripten_release",
      "jobs": 0,
      "targets": [
        "usearch_static",
        "usearch_test_c"
      ]
    },
    {
      "name": "wasm32_wasi_release",
      "configurePreset": "wasm32_wasi_release",
      "jobs": 0,
      "targets": [
        "usearch_static",
        "usearch_test_c"
      ]
    },
    {
      "name": "windows_x64_release",
      "configurePreset": "windows_x64_release",
      "jobs": 0,
      "configuration": "Release"
    },
    {
      "name": "windows_arm64_library",
      "configurePreset": "windows_arm64_library",
      "jobs": 0,
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    },
    {
      "name": "host_debug",
      "inherits": "base",
      "configurePreset": "host_debug"
    },
    {
      "name": "host_relwithdebinfo",
      "inherits": "base",
      "configurePreset": "host_relwithdebinfo"
    },
    {
      "name": "host_release",
      "inherits": "base",
      "configurePreset": "host_release"
    },
    {
      "name": "host_tsan",
      "inherits": "base",
      "configurePreset": "host_tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1 second_deadlock_stack=1"
      }
    },
    {
      "name": "cuda_relwithdebinfo",
      "inherits": "base",
      "configurePreset": "cuda_relwithdebinfo"
    },
    {
      "name": "wasm32_emscripten_release",
      "inherits": "base",
      "configurePreset": "wasm32_emscripten_release",
      "filter": {
        "include": {
          "name": "^usearch_test_c$"
        }
      }
    },
    {
      "name": "wasm64_emscripten_release",
      "inherits": "base",
      "configurePreset": "wasm64_emscripten_release",
      "filter": {
        "include": {
          "name": "^usearch_test_c$"
        }
      }
    },
    {
      "name": "wasm32_wasi_release",
      "inherits": "base",
      "configurePreset": "wasm32_wasi_release",
      "filter": {
        "include": {
          "name": "^usearch_test_c$"
        }
      }
    },
    {
      "name": "windows_x64_release",
      "inherits": "base",
      "configurePreset": "windows_x64_release",
      "configuration": "Release"
    }
  ],
  "workflowPresets": [
