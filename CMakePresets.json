{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Ninja, a build tree named after the preset, and a compilation database for the language server. No compiler is pinned here: the developer presets inherit `clang`, and CI rows override with -D CMAKE_CXX_COMPILER. Export CMAKE_C_COMPILER_LAUNCHER, CMAKE_CXX_COMPILER_LAUNCHER and CMAKE_CUDA_COMPILER_LAUNCHER, like `ccache`, to cache objects.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_OPTIMIZE_DEPENDENCIES": "ON",
        "CMAKE_C_COMPILER_LAUNCHER": "$env{CMAKE_C_COMPILER_LAUNCHER}",
        "CMAKE_CXX_COMPILER_LAUNCHER": "$env{CMAKE_CXX_COMPILER_LAUNCHER}",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "$env{CMAKE_CUDA_COMPILER_LAUNCHER}"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "description": "Clang, linking through the platform's own linker.",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "llvm",
      "hidden": true,
      "inherits": "clang",
      "description": "Clang and `lld`, which links the template-heavy targets several times faster than `bfd`.",
      "cacheVariables": {
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=lld"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "darwin",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "wasm",
      "hidden": true,
      "description": "The C library and its test under a WebAssembly toolchain; the C++ suite and benchmarks stay native.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_SHARED": "ON",
        "USEARCH_DENSE_DTYPES": "11"
      }
    },
    {
      "name": "debug",
      "inherits": [
        "base",
        "llvm"
      ],
      "displayName": "Host Debug - unit tests with sanitizers",
      "description": "Unoptimized C++ and C suites; the compiler wiring arms the leak sanitizer here.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "check",
      "inherits": [
        "base",
        "llvm"
      ],
      "displayName": "Host Check - fastest compile cycle, warnings as errors",
      "description": "Does it still compile without a warning, nothing more. `-O0` is the one flag that moves the needle on these instantiation grids: measured per shard, -O3 and -O1 both cost ~9.8s while -O0 costs 3.5s, against a 2.8s front-end floor.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O0 -g0 -DNDEBUG",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O0 -Xcicc -O1 -Xptxas -O0 -DNDEBUG",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "ON",
        "USEARCH_BUILD_SHARED": "ON",
        "USEARCH_WERROR": "ON"
      }
    },
    {
      "name": "cuda_check",
      "inherits": "check",
      "displayName": "CUDA Check - fastest compile cycle with the `.cu` units",
      "description": "Same as `check`, plus the `.cu` units, with `cicc` and `ptxas` at `-O0` too, since optimizing each class unit's kernels is what dominates their build.",
      "cacheVariables": {
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "USEARCH_CUDA_ARCH": "native"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": [
        "base",
        "llvm"
      ],
      "displayName": "Host RelWithDebInfo - optimized tests with symbols",
      "description": "Optimized, with full DWARF for stepping through the suites.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "USEARCH_BUILD_TEST": "ON"
      }
    },
    {
      "name": "release",
      "inherits": [
        "base",
        "clang"
      ],
      "displayName": "Host Release - every CPU target",
      "description": "The full CPU matrix: C++ suite, benchmarks, the C 99 library and its test.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "ON",
        "USEARCH_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "profile",
      "inherits": [
        "base",
        "llvm"
      ],
      "displayName": "Host Profile - benchmarks under perf",
      "description": "The profiling tree behind bench/README.md: full optimization, plus the symbols `perf` needs to attribute samples.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG",
        "USEARCH_BUILD_BENCH": "ON",
        "USEARCH_BUILD_SHARED": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": [
        "base",
        "gcc"
      ],
      "displayName": "Host TSan - concurrency suites under ThreadSanitizer",
      "description": "GCC & -fsanitize=thread over RelWithDebInfo - the Debug wiring arms ASan & LSan, which TSan cannot share a process with. -O1 keeps the instrumented suites tolerable, and the mutex annotations in sanitizers.hpp light up under this preset alone. Built with GCC: Clang here ships no compiler-rt.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O1 -g -DNDEBUG -fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -DNDEBUG -fsanitize=thread -fno-omit-frame-pointer",
        "USEARCH_BUILD_TEST": "ON"
      }
    },
    {
      "name": "cuda",
      "inherits": [
        "base",
        "llvm"
      ],
      "displayName": "CUDA RelWithDebInfo - everything, CUDA included",
      "description": "The iteration tree, and the only one covering the `.cu` units - so `.clangd` reads its database. Optimized enough to run, with line tables instead of full DWARF and the fat binary narrowed to the host GPU.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG",
        "CMAKE_CUDA_FLAGS_RELWITHDEBINFO": "-O2 -lineinfo -DNDEBUG",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "USEARCH_BUILD_TEST": "ON",
        "USEARCH_BUILD_BENCH": "ON",
        "USEARCH_BUILD_SHARED": "ON",
        "USEARCH_CUDA_ARCH": "native"
      }
    },
    {
      "name": "cuda_trace",
      "inherits": "cuda",
      "displayName": "CUDA Trace - where the build time goes",
      "description": "Emits a .json next to every object; open them in a flame-graph viewer or aggregate with ClangBuildAnalyzer to see which instantiations dominate.",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -gline-tables-only -DNDEBUG -ftime-trace"
      }
    },
    {
      "name": "cuda_release",
      "inherits": "cuda",
      "displayName": "CUDA Release - every architecture, Ampere through Blackwell",
      "description": "Same targets as `cuda`, at Release and emitting every architecture rather than the host GPU - what shipping artifacts and cross-machine runs need.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CXX_FLAGS": "-ffile-prefix-map=${sourceDir}=.",
        "CMAKE_CUDA_FLAGS": "-Xcompiler=-ffile-prefix-map=${sourceDir}=.",
        "USEARCH_CUDA_ARCH": "all"
      }
    },
    {
      "name": "machine",
      "hidden": true,
      "inherits": [
        "base",
        "linux",
        "llvm"
      ],
      "description": "One machine: its CPU floor, every kernel-library capability spelled as 1 or 0, and its one GPU code.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "USEARCH_BUILD_TEST": "OFF",
        "USEARCH_BUILD_BENCH": "OFF",
        "USEARCH_BUILD_SHARED": "ON",
        "USEARCH_MULTIVERSIONED": "OFF"
      }
    },
