PROJECT_NAME           = USearch
OUTPUT_DIRECTORY       = ../build/
INPUT                  = ../c/usearch ../cpp/usearch
EXCLUDE                = ../c/usearch/usearch.h
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cuh
EXTENSION_MAPPING      = cuh=C++
EXCLUDE_SYMBOLS        = *_ Arrow*
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = USEARCH_EXPORT=
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_ID_STYLE      = GITHUB
BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_PROGRAMLISTING     = NO
INPUT_FILTER           = "sed -E 's/^( [*]  )@(author|date) .*/\1/'"
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
