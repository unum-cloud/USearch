# Stages every version site a release stamps at one version, then applies a sed edit to one of them.
stage_release_fixture() { # stage_release_fixture <version> [<relative-path> <sed-expression>]
    create_fixture_repository
    local version=$1 core=${1%%-*} major minor patch
    IFS=. read -r major minor patch <<< "$core"
    (
        cd "$fixture_directory" || exit 1
        mkdir -p mojo java csharp/nuget c/usearch src_stub
        printf '%s\n' "$version" > VERSION
        printf '{\n  "name": "usearch",\n  "version": "%s",\n}\n' "$version" > package.json
        printf '[package]\nname = "usearch"\nversion = "%s"\n' "$version" > Cargo.toml
        printf '[workspace]\nversion = "%s"\n\n[package]\nversion = "%s"\n' "$version" "$version" > pixi.toml
        printf '[package]\nversion = "%s"\n' "$version" > mojo/pixi.toml
        printf '.{\n    .version = "%s",\n}\n' "$version" > build.zig.zon
        printf "def usearchVersion = '%s'\nimplementation name: 'usearch', version: '%s', ext: 'jar'\n" "$version" "$version" > java/README.md
        printf "<Project>\n    <Version Condition=\"'\$(Version)' == ''\">%s</Version>\n</Project>\n" "$version" > csharp/nuget/nuget-package.props
        printf 'let release = "https://github.com/unum-cloud/USearch/releases/download/v%s"\n' "$version" > Package.swift
        printf 'project(\n    usearch\n    VERSION %s\n)\n' "$core" > CMakeLists.txt
        printf '#define USEARCH_VERSION_MAJOR %s\n#define USEARCH_VERSION_MINOR %s\n#define USEARCH_VERSION_PATCH %s\n' \
            "$major" "$minor" "$patch" > c/usearch/types.h
        printf 'char const* usearch_version_name(void) { return "%s"; }\n' "$core" > src_stub/types.cpp
        [ $# -lt 3 ] || { sed "$3" "$2" > "$2.edited" && mv "$2.edited" "$2"; }
        git add -A
    ) || exit 1
    release_fixture_staged=1
}

