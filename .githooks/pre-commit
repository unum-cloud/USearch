# endregion USearch Rules

# region Parallel Judging

# This region is identical in every hook that judges staged files one at a time; edit them all together.

git rev-parse --verify HEAD > /dev/null 2>&1 || exit 0

results_directory=$(mktemp -d)
trap 'rm -rf "$results_directory"' EXIT

# Splits a zero-context diff into files numbered in diff order from `ordinal + 1`: its hunks, its added lines,
# their numbers, and the `--lines` ranges clang-format takes, where a hunk that only deletes covers one line.
split_diff_by_path='
    /^diff --git / {
        close(diff); close(added); close(lines); close(ranges); ++ordinal; hunk = 0
        diff = directory ordinal ".diff"; added = directory ordinal ".added"
        lines = directory ordinal ".lines"; ranges = directory ordinal ".ranges"
        next
    }
    /^@@/ {
        hunk = 1
        split($3, range, ",")
        start = substr(range[1], 2) + 0
        count = (range[2] == "") ? 1 : range[2] + 0
        for (line = start; line < start + count; ++line) print line > lines
        printf "--lines=%d:%d\n", start, start + (count ? count : 1) - 1 > ranges
    }
    hunk { print > diff }
    hunk && /^\+/ { print > added }'

# Lists the staged paths, writes their blobs under `index/` and splits their diff, one git process each, so
# no check asks git again; `git diff` lists paths in the same order whether it prints names or hunks.
read_staged_paths() {
    staged_paths=()
    while IFS= read -r -d '' staged_path; do staged_paths+=("$staged_path"); done \
        < <(git diff --cached --name-only -z --find-renames --diff-filter=ACMR)
    [ ${#staged_paths[@]} -eq 0 ] || printf '%s\0' "${staged_paths[@]}" |
        git checkout-index --prefix="$results_directory/index/" -z --stdin
    git diff --cached --unified=0 --find-renames --diff-filter=ACMR | "$fastest_awk" -v directory="$results_directory/" "$split_diff_by_path"
}

# Deals the paths round-robin to one worker per core, each running `judge_path` into a numbered report, then
# prints the reports in path order, so the output reads exactly as a serial run's would.
judge_paths_in_parallel() { # judge_paths_in_parallel <path>...
    local worker worker_count ordinal
    worker_count=$(getconf _NPROCESSORS_ONLN 2> /dev/null || echo 4)
    [ "$worker_count" -le $# ] || worker_count=$#
    for ((worker = 0; worker < worker_count; ++worker)); do
        (
            ordinal=0
            for staged_path in "$@"; do
                ordinal=$((ordinal + 1))
                [ $(((ordinal - 1) % worker_count)) -eq "$worker" ] || continue
                # A selftest carries one violation per rule by design.
                [ "$staged_path" = .githooks/selftest ] || judge_path > "$results_directory/$ordinal"
            done
            echo "$rejection_count" > "$results_directory/count-$worker"
        ) &
    done
    wait
    for ((ordinal = 1; ordinal <= $#; ++ordinal)); do
        [ ! -f "$results_directory/$ordinal" ] || cat "$results_directory/$ordinal"
    done
    for ((worker = 0; worker < worker_count; ++worker)); do
        rejection_count=$((rejection_count + $(cat "$results_directory/count-$worker")))
    done
}

# Runs the staged-mode judging: the checks over the whole commit start first and overlap the per-path
# workers, and still report after them.
judge_staged_paths() {
    read_staged_paths
    (
        run_tree_checks > "$results_directory/tree"
        echo "$rejection_count" > "$results_directory/count-tree"
    ) &
    judge_paths_in_parallel ${staged_paths[@]+"${staged_paths[@]}"}
    cat "$results_directory/tree"
    rejection_count=$((rejection_count + $(cat "$results_directory/count-tree")))
}

# endregion Parallel Judging

# region Dispatch

# Points the checks at one path's files and loads its added lines, their numbers and its text; fails when the
# path adds nothing. A mode without a diff judges its added lines as one.
load_path_files() {
    staged_diff_path=$results_directory/$ordinal.diff
    staged_lines_path=$results_directory/$ordinal.lines
    staged_ranges_path=$results_directory/$ordinal.ranges
    [ -s "$results_directory/$ordinal.added" ] || return 1
    [ -f "$staged_diff_path" ] || staged_diff_path=$results_directory/$ordinal.added
    staged_added_text=$(< "$results_directory/$ordinal.added")
    staged_added_unquoted_path=$results_directory/$ordinal.added
    staged_file_text=$(< "$staged_text_path")
    if speaks_c_comments "$staged_path"; then
        staged_code_path=$results_directory/$ordinal.code
        staged_added_code_path=$results_directory/$ordinal.added-code
        staged_added_unquoted_path=$results_directory/$ordinal.added-unquoted
        blank_c_comments_preserving_columns < "$staged_text_path" > "$staged_code_path"
        scan_staged_file_marking_added_lines 'FNR in added { print "+" $0 }' "$staged_code_path" > "$staged_added_code_path"
        blank_c_comments_preserving_columns literals < "$staged_text_path" |
            scan_staged_file_marking_added_lines 'FNR in added { print "+" $0 }' - > "$staged_added_unquoted_path"
    fi
}

# `--all-lines <path>...` judges whole working-tree files as though every line outside a function body were
# added, and `--changed-lines <path>...` judges the lines they changed since HEAD; both skip the formatters
# and the checks over the commit as a whole. With no arguments the hook judges what is staged.
if [ "${1:-}" = --changed-lines ]; then
    shift
    judge_path() {
        [ -f "$staged_path" ] || return 0
        git diff HEAD --unified=0 -- "$staged_path" |
            "$fastest_awk" -v directory="$results_directory/" -v ordinal=$((ordinal - 1)) "$split_diff_by_path"
        staged_text_path=$staged_path
        load_path_files || return 0
        run_shared_checks
        run_project_checks
    }
    judge_paths_in_parallel "$@"
elif [ "${1:-}" = --all-lines ]; then
    shift
    judge_path() {
        [ -f "$staged_path" ] || return 0
        staged_file_text=$(< "$staged_path")
        [ -n "$staged_file_text" ] || return 0
        printf '%s\n' "$(lines_outside_function_bodies)" > "$results_directory/$ordinal.lines"
        "$fastest_awk" -v added="$results_directory/$ordinal.added" 'NR == FNR { kept[$1]; next } FNR in kept { print "+" $0 > added }' \
            "$results_directory/$ordinal.lines" "$staged_path"
        staged_text_path=$staged_path
        load_path_files || return 0
        run_shared_checks
        run_project_checks
    }
    judge_paths_in_parallel "$@"
else
    judge_path() {
        check_generated_artifacts
        staged_text_path=$results_directory/index/$staged_path
        load_path_files || return 0
        run_shared_checks
        run_shared_formatters
        run_project_checks
    }
    judge_staged_paths
fi

# endregion Dispatch

if [ "$rejection_count" -ne 0 ]; then
    echo ""
    echo "pre-commit: $rejection_count check(s) failed"
    echo "Fix the staged changes and commit again. Bypass knowingly with: git commit --no-verify"
    exit 1
fi
exit 0
