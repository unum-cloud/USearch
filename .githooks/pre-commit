# region USearch Rules

# Narrows shared checks to the inputs their rules were written for, without touching the pinned regions:
# each shared function keeps its text under a `shared_` name, and the wrapper below it judges the paths
# the rule fits. Dynamic scope lets a wrapper hand the shared check a narrower `staged_added_text`.
for shared_check in check_void_discards check_tsdoc_tag_syntax check_type_suffixes scan_binding_prose check_rust_use_groups; do
    eval "shared_$(declare -f "$shared_check")"
done

# The JavaScript and Python glue compiles as C11, where `[[maybe_unused]]` needs C23.
check_void_discards() {
    case "$staged_path" in javascript/*.c | python/*.c) return 0 ;; esac
    shared_check_void_discards
}

# JSDoc braces its types, which TSDoc forbids; only TypeScript is judged by TSDoc.
check_tsdoc_tag_syntax() {
    case "$staged_path" in *.js | *.mjs | *.cjs) return 0 ;; esac
    shared_check_tsdoc_tag_syntax
}

# A `template <...>` line that opens a record, an alias or a function declares no variable template.
check_type_suffixes() {
    local staged_added_text=$staged_added_text
    staged_added_text=$(printf '%s\n' "$staged_added_text" | "$fastest_awk" '
        function release(   index_) { for (index_ = 1; index_ <= held; ++index_) print kept[index_]; held = 0 }
        /^\+[[:space:]]*template[[:space:]]*</ { release(); held = 1; kept[1] = $0; next }
        held && /^\+[[:space:]]*(typename|class |std::|requires|[A-Za-z_]+ [A-Za-z_]+_|>)/ &&
            !/^\+[[:space:]]*(struct|class)[[:space:]]+[A-Za-z_]+[[:space:]]*(final[[:space:]]*)?([:{]|$)/ { kept[++held] = $0; next }
        held {
            record = /^\+[[:space:]]*(struct|class)[[:space:]]/ && !/^\+[[:space:]]*(struct|class)[[:space:]]+[A-Za-z_]+_t[[:space:]:{]/
            if (record || /^\+[[:space:]]*using[[:space:]]/ || /^\+[^=(]*\(/) kept[1] = "+"
            release()
        }
        { print }
        END { release() }')
    shared_check_type_suffixes
}

# A fenced code block in Go docs is a `//` line indented by a tab, and reads as code, not prose.
scan_binding_prose() {
    local prose_source=$staged_text_path staged_text_path
    case "$staged_path" in
    *.go)
        staged_text_path=$results_directory/$ordinal.go-prose
        [ -f "$staged_text_path" ] || "$fastest_awk" '/^[[:space:]]*\/\/\t/ { print ""; next } { print }' "$prose_source" > "$staged_text_path"
        ;;
    *) staged_text_path=$prose_source ;;
    esac
    shared_scan_binding_prose "$@"
}

# This project's own crate is `usearch`; the shared dispatch passes NumKong's, which would judge `use numkong::`
# an own-crate import.
check_rust_use_groups() {
    shared_check_rust_use_groups usearch "$2"
}

# The dependency-free core: include/usearch/basic/ram_index.hpp and its transitive utilities/
# suppliers ship as a standalone header-only library, standard-library and OS headers only, no
# submodules. The supplier set is computed from the includes themselves, so a new supplier joins the
# checked set the moment the RAM tier names it, and hardware wrappers like utilities/ram_device.hpp
# or the NVMe tier's utilities/nvme_device.hpp, which include CUDA or ForkUnion, never enter it.
dependency_free_core_files() {
    local closure frontier next supplier fresh
    # Space-separated throughout: the membership probes below match " $staged_path " against this
    # list.
    closure="include/usearch/basic/ram_index.hpp"
    frontier=$closure
    while [ -n "$frontier" ]; do
        next=$(grep -h '#[[:space:]]*include[[:space:]]*"usearch/utilities/' $frontier 2>/dev/null |
            sed 's/.*"\(usearch\/utilities\/[^"]*\)".*/include\/\1/' | sort -u)
        fresh=""
        for supplier in $next; do
            case " $closure " in
            *" $supplier "*) ;;
            *)
                closure="$closure $supplier"
                fresh="$fresh $supplier"
                ;;
            esac
        done
        frontier=$fresh
    done
    printf '%s' "$closure"
}
core_files=$(dependency_free_core_files)

check_dependency_free_core() {
    local foreign quoted
    foreign=$(printf '%s\n' "$staged_added_text" | grep -E \
        '#[[:space:]]*include[[:space:]]*<(numkong|forkunion|stringzilla|smashtable|yyjson|fmt|benchmark|cuda|thrust|cub)[/.>]' || true)
    [ -z "$foreign" ] || reject_with_reason "$foreign" \
        "$staged_path lives in the dependency-free core, basic/ and its utilities/ suppliers, but includes" \
        "            a sibling or third-party library; standard and OS headers only:"
    quoted=$(printf '%s\n' "$staged_added_text" | grep -E '#[[:space:]]*include[[:space:]]*"' |
        grep -vE '"usearch/((utilities|basic)/|types\.h")' || true)
    [ -z "$quoted" ] || reject_with_reason "$quoted" \
        "$staged_path lives in the dependency-free core, basic/ and its utilities/ suppliers, but quotes" \
        "            a header outside those two directories:"
}

# The abbreviation reads ID and IDs in prose, never id, ids, Id or Ids. Only comment text is
# weighed: code spans, `@code` and `@verbatim` bodies, quoted strings, URLs, Doxygen parameter names
# and identifiers like `node_id`, `.id` or `->id` keep their spelling.
ids_miscased_pattern='(^|[^[:alnum:]_.:])(id|ids|Id|Ids)([^[:alnum:]_(]|$)'
check_ids_capitalized() {
    local miscased
    miscased=$(printf '%s\n' "$staged_added_text" | "$fastest_awk" '
        { line = substr($0, 2); gsub(/https?:\/\/[^[:space:]]*/, "", line) }
        line ~ /@end(code|verbatim)/ { code = 0; next }
        line ~ /@(code|verbatim)/ { code = 1; next }
        code { next }
        line ~ /^[[:space:]]*(\/\/|\/\*|\*)/ { print line; next }
        { position = index(line, "//"); if (position) print substr(line, position) }' |
        sed -E 's/`[^`]*`//g; s/"[^"]*"//g; s/->/ _arrow_/g; s/@(p|c|a|ref|param|tparam)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*//g' |
        grep -E "$ids_miscased_pattern" || true)
    [ -z "$miscased" ] || reject_with_reason "$miscased" \
        "$staged_path writes id or ids in a comment; the abbreviation is ID, plural IDs:"
}

# The same rule for Markdown prose, skipping fenced and indented code the added lines open
# themselves.
check_ids_capitalized_prose() {
    local miscased
    miscased=$(printf '%s\n' "$staged_added_text" |
        "$fastest_awk" '/^\+[[:space:]]*```/ { fenced = !fenced; next } !fenced && !/^\+(    |\t)/' |
        sed -E 's#https?://[^[:space:]]*##g; s/`[^`]*`//g; s/"[^"]*"//g; s/->/ _arrow_/g; s/^\+//' |
        grep -E "$ids_miscased_pattern" || true)
    [ -z "$miscased" ] || reject_with_reason "$miscased" "$staged_path writes id or ids; the abbreviation is ID, plural IDs:"
}

# GPU rows live in flat matrices and flat columns, so the old "plane" names neither prose nor
# identifiers in the sources that touch device storage. Hyphenated compounds like `tangent-plane`
# and words like `hyperplane` pass.
planes_pattern='(^|[^[:alnum:]-])[Pp]lanes?([^[:alnum:]-]|$)'
check_flat_storage_wording() {
    local planes
    planes=$(printf '%s\n' "$staged_added_text" | grep -E "$planes_pattern" || true)
    [ -z "$planes" ] || reject_with_reason "$planes" \
        "$staged_path calls device row storage a plane; write flat matrix or flat column:"
}

# Markdown paragraphs are separated by one blank line, so a run of two carries no meaning and only
# shows as noise in a diff. Fenced blocks keep whatever they hold.
check_blank_line_runs() {
    local runs
    runs=$("$fastest_awk" '
        /^```/ || /^~~~/ { fence = !fence }
        !fence && /^[[:space:]]*$/ { blanks++; if (blanks > 1) print NR ": consecutive blank lines"; next }
        { blanks = 0 }
    ' "$staged_text_path" || true)
    [ -z "$runs" ] || reject_with_reason "$runs" \
        "$staged_path separates paragraphs with more than one blank line; Markdown needs exactly one:"
}

# A `#pragma region` earns its markers only around a stretch worth folding: one shorter than 30
# lines belongs in its neighbour, so the outline stays a few meaningful sections rather than many
# tiny ones.
check_region_lengths() {
    local short
    short=$(< "$staged_text_path" "$fastest_awk" '
        /^[[:space:]]*#pragma[[:space:]]+region/ { opened[++depth] = NR; name[depth] = $0 }
        /^[[:space:]]*#pragma[[:space:]]+endregion/ && depth {
            if (NR - opened[depth] - 1 < 30) printf "line %d: %s\n", opened[depth], name[depth]
            depth--
        }')
    [ -z "$short" ] || reject_with_reason "$short" \
        "$staged_path has a #pragma region shorter than 30 lines; fold it into its neighbour:"
}

# Namespaces mirror directories. A nameless `namespace {` hides helpers in a scope no path names,
# and a namespace no directory backs, like `stub::shapes` for `src_stub/shapes.cpp`, invents
# structure the tree does not have. Allowed names: `unum`, `usearch`, the sibling libraries' roots,
# a directory on the file's path, where `src_stub` answers for `stub`, and a directory beside the
# file. A header under `include/usearch/<dir>/` opens exactly `unum::usearch::<dir>`; only
# `utilities/types.hpp` also opens the parent and the sibling roots, to declare the `nk`, `fu`, `sz`
# & `st` aliases every directory shares.
check_namespace_directories() {
    local directory=${staged_path%/*} depth allowed name misplaced="" modality=""
    [ "$directory" = "$staged_path" ] && directory=.
    allowed=" unum usearch ashvardanian numkong stringzilla forkunion smashtable "
    for name in $(printf '%s\n' "$directory" | tr '/' '\n'); do allowed="$allowed$name ${name##*_} "; done
    # Directories beside the file as the index holds them, so a commit may add one along with its
    # first file.
    depth=$(printf '%s\n' "$directory" | "$fastest_awk" -F/ '{ print ($0 == "." ? 0 : NF) }')
    for name in $(git ls-files -- "$directory/" | "$fastest_awk" -F/ -v depth="$depth" 'NF > depth + 1 { print $(depth + 1) }' |
        sort -u); do
        allowed="$allowed$name "
    done
    case "$staged_path" in
    include/usearch/*/*)
        modality=${staged_path#include/usearch/}
        modality=${modality%%/*}
        ;;
    esac
    while IFS=: read -r line opened; do
        if [ -z "$opened" ]; then
            misplaced="${misplaced}line $line: a nameless namespace
"
            continue
        fi
        if [ -n "$modality" ]; then
            case "$opened" in
            "unum::usearch::$modality") ;;
            unum::usearch | ashvardanian | numkong | stringzilla | forkunion | smashtable)
                [ "$staged_path" = include/usearch/utilities/types.hpp ] ||
                    misplaced="${misplaced}line $line: namespace $opened, not unum::usearch::$modality
" ;;
            *) misplaced="${misplaced}line $line: namespace $opened, not unum::usearch::$modality
" ;;
            esac
            continue
        fi
        for name in $(printf '%s\n' "$opened" | tr ':' '\n'); do
            [ -z "$name" ] && continue
            case "$allowed" in
            *" $name "*) ;;
            *) misplaced="${misplaced}line $line: namespace $name
" ;;
            esac
        done
    done < <("$fastest_awk" '/^[[:space:]]*namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/ {
            opened = $0; sub(/^[[:space:]]*namespace[[:space:]]*/, "", opened); sub(/[[:space:]]*\{.*/, "", opened)
            print NR ":" opened }' "$staged_text_path")
    [ -z "$misplaced" ] || reject_with_reason "${misplaced%$'\n'}" \
        "$staged_path opens a namespace no directory backs; use the directory's namespace, and \`static\` for file-local helpers:"
}

# Rust modules mirror files. An inline `mod name { .. }` or a `#[path = ..]` remap names a module no
# file backs; only the unit tests, `#[cfg(test)] mod tests`, stay inline.
check_rust_modules() {
    local inline
    inline=$("$fastest_awk" '
        /^[[:space:]]*#\[cfg\(test\)\]/ { testing = NR; next }
        /^[[:space:]]*#\[path[[:space:]]*=/ { printf "line %d: #[path] remap\n", NR }
        /^[[:space:]]*(pub(\([a-z]+\))?[[:space:]]+)?mod[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\{/ {
            name = $0; sub(/.*mod[[:space:]]+/, "", name); sub(/[[:space:]]*\{.*/, "", name)
            if (!(name == "tests" && testing == NR - 1)) printf "line %d: inline mod %s\n", NR, name
        }' "$staged_text_path")
    [ -z "$inline" ] || reject_with_reason "$inline" \
        "$staged_path declares a module no file backs; move its items to the file root or into their own file:"
}

# A verb's argument struct reads in the order the call works: what it reads, what it writes, the
# arena those outputs land in, then the knobs that shape the work and the handlers that observe it.
# So the output views, the arrays handed back through a double pointer, and `written`/`required`
# form one block right before `arena`, a plain `scalar` describes an input and never follows it, and
# an `outputs_*` knob never precedes it.
check_verb_field_order() {
    local misordered
    misordered=$(< "$staged_text_path" "$fastest_awk" '
        { sub(/\/\*.*\*\//, "") }
        /\/\*/ { commenting = 1 }
        commenting { if (/\*\//) commenting = 0; next }
        /^typedef struct usearch_[a-z0-9_]+_t \{/ { opened = NR; count = 0; next }
        opened && /^\} usearch_[a-z0-9_]+_t;/ {
            name = $2; sub(/;$/, "", name); arena = 0
            for (field = 1; field <= count; ++field) if (names[field] == "arena" && types[field] == "usearch_arena_t") arena = field
            if (arena) {
                block = arena
                while (block > 1 && output[block - 1]) block--
                for (field = 1; field <= count; ++field) {
                    if (output[field] && field < block)
                        printf "line %d: %s.%s lands apart from the outputs before arena\n", opened, name, names[field]
                    if (field > arena && (output[field] || names[field] == "scalar"))
                        printf "line %d: %s.%s follows arena\n", opened, name, names[field]
                    if (field < arena && names[field] ~ /^outputs_/)
                        printf "line %d: %s.%s precedes arena\n", opened, name, names[field]
                }
            }
            opened = 0; next
        }
        opened && /;[[:space:]]*$/ {
            line = $0; sub(/;[[:space:]]*$/, "", line); sub(/^[[:space:]]+/, "", line)
            field_name = line; sub(/.*[[:space:]*]/, "", field_name)
            field_type = line; sub(/[A-Za-z0-9_]+$/, "", field_type); sub(/[[:space:]*]+$/, "", field_type)
            pointer = line ~ /\*[[:space:]]*[A-Za-z0-9_]+$/
            ++count; names[count] = field_name; types[count] = field_type
            output[count] = pointer && (field_type ~ /_view_t$/ || field_type == "size_t" ||
                                        line ~ /\*\*[[:space:]]*[A-Za-z0-9_]+$/)
        }')
    [ -z "$misordered" ] || reject_with_reason "$misordered" \
        "$staged_path orders a verb's fields out of reads, writes, arena, knobs and observers:"
}

# Tests assert what a value is, not what its rendering happens to contain. A substring of a repr or
# a message passes on a wrong value that spells the fragment and breaks on a harmless rewording;
# compare the whole repr, the fields, the exception type or the very object raised instead.
check_substring_assertions() {
    local fragments
    fragments=$(printf '%s\n' "$staged_added_text" | grep -nE \
        'pytest\.raises\([^)]*match=|["'"'"'] in (repr|str)\(|(repr|str)\([^)]*\)\.(startswith|endswith)\(|\.to_string\(\)\.(contains|starts_with|ends_with)\(|\.message\.(contains|starts_with|ends_with)\(' || true)
    [ -z "$fragments" ] || reject_with_reason "$fragments" \
        "$staged_path asserts on a fragment of a repr or a message; compare the whole value, its fields, or the exception:"
}

# @copydoc belongs to the family header, where each backend is declared once beside the verb it
# copies from. In a backend's own file it duplicates that link at the definition, so the same
# sentence arrives twice and a reader learns nothing about the backend in front of them. Say what
# this backend does differently, or say nothing and let the declaration speak.
check_copydoc_in_backend() {
    case "${staged_path##*/}" in
    serial.* | westmere.* | goldmont.* | haswell.* | skylake.* | icelake.* | \
        neon.* | neonaes.* | neonsha.* | sve.* | sve2.* | sve2aes.* | \
        cuda.* | kepler.* | hopper.* | blackwell.* | rocm.* | cdna.* | \
        lasx.* | powervsx.* | rvv.* | rvvcrypto.* | v128.* | v128relaxed.*) ;;
    *) return ;;
    esac
    local copied
    copied=$(printf '%s\n' "$staged_added_text" | grep -n '@copydoc' || true)
    [ -z "$copied" ] || reject_with_reason "$copied" \
        "$staged_path is a backend file carrying @copydoc; document the declaration in the family header," \
        "            and leave this one a note on what this backend does differently, or nothing:"
}

# Doxygen never parses a `//` comment, so a command there, like `@p count` or `@c select_diverse`,
# prints literally and reads as noise. Plain comments name code in backticks, or in prose; the
# commands belong in `/** */` docblocks.
check_doxygen_in_line_comments() {
    local tagged
    tagged=$(printf '%s\n' "$staged_added_text" | grep -E '(^\+|[^:])//[^/!]' |
        grep -E '//[^/!].*[[:space:]]@(brief|param|tparam|returns?|ref|see|note|c|p|b)\b' || true)
    [ -z "$tagged" ] || reject_with_reason "$tagged" \
        "$staged_path uses a Doxygen command in a // comment, which Doxygen never parses; quote code in backticks:"
}

# A `//!` trailer documents nothing an editor shows on hover, and C and C++ have no use for it: a
# member takes a `/** ... */` line above it, and a note on a statement is a plain `//` comment.
check_doxygen_trailers() {
    local trailers
    trailers=$(printf '%s\n' "$staged_added_text" | grep -nE '//!' || true)
    [ -z "$trailers" ] || reject_with_reason "$trailers" \
        "$staged_path documents with a //! trailer; write /** ... */ above a member, or // after a statement:"
}

# The full `unum::usearch::` spelling belongs to three places: the alias and `using` lines, the
# lines opening and closing a nested `unum::usearch::<dir>` namespace, and the specializations of
# foreign templates, `std::hash<unum::usearch::utilities::uuid_t>` and its call operator or
# `fmt::formatter<...>`, which have to name the type from outside. Everywhere else the name is
# already in scope, through an alias like `us::` or `dense::`, the directive a translation unit
# opened with, or the enclosing namespace.
check_qualified_namespace() {
    local spelled
    spelled=$(printf '%s\n' "$staged_added_text" |
        grep -vE '^\+[[:space:]]*(\*|//|/\*)' |
        grep -vE 'namespace [a-z_]+ = unum::usearch(::[a-z_]+)*;|(using )?namespace unum::usearch(::[a-z_]+)*( \{|;)$|^\+\} // namespace unum::usearch' |
        grep -vE 'struct (std|fmt)::[A-Za-z_]+<unum::usearch::|operator\(\)\(unum::usearch::' |
        grep -E 'unum::usearch::' || true)
    [ -z "$spelled" ] || reject_with_reason "$spelled" \
        "$staged_path spells unum::usearch:: in full; the name is already in scope through an alias like \`us\`," \
        "            a \`using\` directive, or the enclosing namespace; only std::hash<unum::usearch::utilities::uuid_t> earns it:"
}

# The namespaces a C++ source opens at file scope, as `line:name`, reading past comments, literals,
# and preprocessor lines; an anonymous namespace prints as `<anonymous>`.
top_level_namespaces() { # top_level_namespaces < source
    "$fastest_awk" '
        continued { continued = ($0 ~ /\\$/); next }
        {
            code = ""
            for (i = 1; i <= length($0); ++i) {
                c = substr($0, i, 1)
                pair = substr($0, i, 2)
                if (state == "block") { if (pair == "*/") { state = ""; ++i } continue }
                if (state != "") {
                    if (c == "\\") ++i
                    else if (c == state) state = ""
                    continue
                }
                if (pair == "//") break
                if (pair == "/*") { state = "block"; ++i; continue }
                if (c == "\"" || c == "'\''") { state = c; continue }
                code = code c
            }
            if (state != "block") state = ""
            if (code ~ /^[[:space:]]*#/) { continued = ($0 ~ /\\$/); next }
            if (depth == 0 && match(code, /(^|[^A-Za-z0-9_])namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/)) {
                name = substr(code, RSTART, RLENGTH)
                sub(/^.*namespace[[:space:]]*/, "", name)
                sub(/[[:space:]]*\{$/, "", name)
                print NR ":" (name == "" ? "<anonymous>" : name)
            }
            depth += gsub(/\{/, "{", code) - gsub(/\}/, "}", code)
        }'
}

# Inside `unum::usearch::test::<dir>` or `unum::usearch::bench::<dir>` the library's
# `unum::usearch::<dir>` is already visible through the directive the shared harness header opens,
# so `usearch::<dir>::` or `us::<dir>::` there only repeats it; lines past the closing brace, like
# specializations of library templates, still qualify. The whole staged file, since the namespace is
# context, reporting only the lines the commit added.
check_harness_library_qualified() {
    grep -qE '^namespace unum::usearch::(test|bench)::[a-z_]+ \{' "$staged_text_path" || return 0
    local spelled
    spelled=$("$fastest_awk" -v path="$staged_path" '
        NR == FNR { added[$1 + 0]; next }
        /^namespace unum::usearch::(test|bench)::[a-z_]+ \{/ {
            inside = $2; sub(/^unum::usearch::/, "", inside)
            directory = inside; sub(/^[a-z]+::/, "", directory)
            next
        }
        /^\} \/\/ namespace / { inside = ""; next }
        inside != "" && (FNR in added) && $0 !~ /^[[:space:]]*(\*|\/\/|\/\*)/ &&
            (" " $0) ~ ("[^A-Za-z0-9_:](unum::usearch|usearch|us)::" directory "::") {
            printf "%s:%d: spells usearch::%s:: inside %s\n", path, FNR, directory, inside
        }' "$staged_lines_path" "$staged_text_path")
    local first=${spelled%%$'\n'*}
    [ -z "$spelled" ] || reject_with_reason "$spelled" "$staged_path ${first#*: }; the library namespace is already visible:"
}

# A namespace opens once per file: closing it only to reopen it splits its body around whatever sits
# between, usually an include that belongs in the preamble. The one gap allowed holds a `fmt::` or
# `std::` specialization, which has to follow the type it formats or hashes and precede the first
# use, all outside the namespace. The whole staged file, since the namespace is context.
check_namespace_reopened() {
    local namespaces reopened
    namespaces=$(top_level_namespaces < "$staged_text_path")
    [ -n "$namespaces" ] || return 0
    reopened=$(printf '%s\n' "$namespaces" |
        "$fastest_awk" -F: -v path="$staged_path" '
            NR == FNR {
                name = substr($0, index($0, ":") + 1)
                if (name in opened) reopening[$1 + 0] = name
                opened[name]
                next
            }
            { lines[FNR] = $0 }
            END {
                for (line in reopening) {
                    foreign = 0
                    for (gap = line - 1; gap > 0 && lines[gap] !~ ("^\\} // namespace " reopening[line] "$"); --gap)
                        if (lines[gap] ~ /^struct (fmt|std)::[a-z_]+</) foreign = 1
                    if (!foreign) printf "%s:%d: reopens namespace %s\n", path, line, reopening[line]
                }
            }' - "$staged_text_path")
    [ -z "$reopened" ] || reject_with_reason "$reopened" \
        "$staged_path reopens namespace ${reopened##*namespace }; keep includes in the preamble and open each namespace once:"
}

# The Layers section of CONTRIBUTING.md: what each layer of include/ and tools/ may include or embed.
# Utilities sit below every design, basic and dense stay apart, a modality reaches neither dense nor
# a C header, and a tool reaches only the utilities.
check_layer_includes() {
    local own allowed reaching layered='[a-z_]+/'
    own=${staged_path#include/usearch/}
    own=${own%%/*}
    case "$staged_path" in
    include/usearch/utilities/*) allowed='utilities/' ;;
    include/usearch/basic/* | include/usearch/dense/*) allowed="(utilities|$own)/" ;;
    include/usearch/sequence/* | include/usearch/shapes/* | include/usearch/geospatial/*)
        allowed="(utilities|basic|$own)/"
        layered='([a-z_]+/|[a-z_]+_index\.h")'
        ;;
    # Tools reach the utilities for drives, files and our own format; engines stay behind the C ABI.
    tools/*) allowed='utilities/' ;;
    *) return 0 ;;
    esac
    reaching=$(grep -nE "^[[:space:]]*#[[:space:]]*(include|embed)[[:space:]]*\"usearch/$layered" "$staged_text_path" |
        grep -vE "\"usearch/${allowed}" || true)
    [ -z "$reaching" ] || reject_with_reason "$reaching" \
        "$staged_path reaches past its layer; see Layers in CONTRIBUTING.md:"
}

# Function-like ALL_CAPS macros: every macro here is object-like, include guards, config flags and
# platform shims. Preprocessor codegen hides the very lines a reader greps for, so write the
# expansion out; a truly unavoidable file-local generator is snake_case_ plus #undef.
check_function_like_macros() {
    local generators
    generators=$(printf '%s\n' "$staged_added_text" | grep -E '^\+[[:space:]]*#[[:space:]]*define[[:space:]]+[A-Z][A-Z0-9_]*\(' || true)
    [ -z "$generators" ] || reject_with_reason "$generators" \
        "$staged_path defines a function-like ALL_CAPS macro; write the expansion out, or name a" \
        "            file-local generator snake_case_ and #undef it after use:"
}

# Spelled-out byte spans in C++ sources: `types.hpp` names them once, `bytes_span_t` for mutable
# runs and `bytes_view_t` for read-only ones, over the house `byte_t = std::byte`.
check_spelled_byte_spans() {
    local spelled
    spelled=$(printf '%s\n' "$staged_added_text" |
        grep -vE 'using bytes_(span|view)_t =' |
        grep -E 'std::span<(std::byte|byte_t)( const)?>' || true)
    [ -z "$spelled" ] || reject_with_reason "$spelled" \
        "$staged_path spells out a byte span; use bytes_span_t / bytes_view_t from types.hpp:"
}

# Triple-chevron launches report nothing at the call: a bad configuration, too much shared memory or
# a missing image surfaces as a sticky error at whichever call reads it next. `cuda_launch` answers
# the launch's own status.
check_chevron_launches() {
    local chevrons
    chevrons=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns | grep -E '<<<' || true)
    [ -z "$chevrons" ] || reject_with_reason "$chevrons" \
        "$staged_path launches a kernel with <<<>>>; call cuda_launch from utilities/vram_nvidia_device.hpp, which returns" \
        "            the launch's status_t:"
}

# A function that opens with `auto` and names its result after the signature buries the one thing a
# reader scans a header for. Spell the type first, qualifying it where an out-of-class definition
# needs it. Lambdas, deduction guides and `requires` clauses keep their arrows, since they have no
# other spelling, so the rejected shapes are a declaration opening with `auto`, and a wrapped
# signature whose continuation line opens with the arrow. Member access binds its arrow tight, which
# is what separates `index->search` from a return type.
check_trailing_returns() {
    local trailing
    trailing=$(printf '%s\n' "$staged_added_text" |
        grep -nE '^\+[[:space:]]*((static|inline|constexpr|friend)[[:space:]]+)*auto[[:space:]]+[A-Za-z_].*->[[:space:]]|^\+[[:space:]]*->[[:space:]]' |
        grep -vE '\[[^]]*\][[:space:]]*\(|requires|concept' || true)
    [ -z "$trailing" ] || reject_with_reason "$trailing" \
        "$staged_path declares a trailing return type; write \`status_t insert(key_t key)\`," \
        "            not \`auto insert(key_t key) -> status_t\`:"
}

# Redundant result annotations in C++ sources: `status_t` and `expected` carry a type-level
# `[[nodiscard]]`, so repeating it on a signature returning them is noise the type already enforces;
# the attribute on a function should mean something the type cannot say.
check_redundant_nodiscard() {
    local redundant
    redundant=$(printf '%s\n' "$staged_added_text" |
        grep -E '\[\[nodiscard\]\][[:space:]]+((static|inline|constexpr|virtual)[[:space:]]+)*(status_t|expected<)' |
        grep -vE 'struct|enum' || true)
    [ -z "$redundant" ] || reject_with_reason "$redundant" \
        "$staged_path repeats [[nodiscard]] on a status_t/expected signature; both types are" \
        "            marked [[nodiscard]] themselves, so drop the annotation:"
}

# A hand-rolled ceiling division, `(value + divisor - 1) / divisor`, re-derives what the shared
# vocabulary already names. Use `divide_round_up` from usearch/utilities/types.hpp.
check_hand_ceils() {
    local ceils
    ceils=$(printf '%s\n' "$staged_added_text" | grep -vE 'divide_round_up|round_up_to_multiple' |
        grep -E '\([^()]+\+[^()]+-[[:space:]]*1[[:space:]]*\)[[:space:]]*/' || true)
    [ -z "$ceils" ] || reject_with_reason "$ceils" \
        "$staged_path hand-rolls a ceiling division; write divide_round_up(value, divisor) from usearch/utilities/types.hpp:"
}

# C's limit macros, `INFINITY`, `NAN`, `SIZE_MAX`, `PTRDIFF_MAX`, `FLT_MAX` and kin, name what
# `std::numeric_limits` spells per type, so a C++ line writes `lowest()`, `max()`, `quiet_NaN()` or
# `infinity()`. Preprocessor lines, comments and string literals stay out; the C sources keep the
# macros.
check_c_limit_macros() {
    local macros
    macros=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*(#|//|/\*|\*( |/|$))' | sed -E 's/"([^"\\]|\\.)*"//g' |
        grep -E '\b(INFINITY|NAN|HUGE_VALF?|SIZE_MAX|PTRDIFF_(MAX|MIN)|U?INT(8|16|32|64)?_(MAX|MIN)|U?L?LONG_(MAX|MIN)|(FLT|DBL)_(MAX|MIN|EPSILON))\b' || true)
    [ -z "$macros" ] || reject_with_reason "$macros" \
        "$staged_path spells a C limit macro; write std::numeric_limits<type>::lowest(), max(), quiet_NaN() or infinity():"
}

# The C library's math functions are spelled through `std::`, so overload resolution picks the
# `float` or `double` flavour and no `<math.h>` macro shadows them; a bare `sqrt(` or a global
# `::atan2(` reaches the C symbol. Members, other qualified calls and a like-named function's own
# definition pass. `round` stays out, since the walks name their callables so.
libc_math_names='sqrt|cbrt|pow|exp|exp2|expm1|log|log2|log10|log1p|sin|cos|tan|asin|acos|atan|atan2|sinh|cosh|tanh|asinh|acosh|atanh|hypot|fabs|fmod|remainder|floor|ceil|trunc|lround|llround|nearbyint|rint|fma|fmin|fmax|fdim|copysign|ldexp|frexp|modf|scalbn|ilogb|logb|erf|erfc|tgamma|lgamma'
check_bare_libc_math() {
    local bare
    bare=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*(#|//|/\*|\*( |/|$))' |
        sed -E 's/"([^"\\]|\\.)*"//g; s://.*$::' |
        grep -E "(^\+|[^A-Za-z0-9_:.>]|(^\+|[^A-Za-z0-9_])::)($libc_math_names)[[:space:]]*\(" |
        grep -vE "\b(void|auto|bool|float|double|[a-z0-9_]+_t)[[:space:]]+($libc_math_names)[[:space:]]*\(" || true)
    [ -z "$bare" ] || reject_with_reason "$bare" \
        "$staged_path calls a C math function bare; spell it std::sqrt(x) or std::atan2(y, x):"
}

# `std::min` / `std::max` re-derive what the shared vocabulary already names, and the parenthesized
# `(std::min<...>)` spelling exists only to dodge the `windows.h` min/max macros, a ritual that
# `min_of` / `max_of` remove outright. Library code says what it means; tests and benches, where the
# standard algorithms are the subject rather than the tool, are dispatched elsewhere.
check_hand_minmax() {
    local rolled
    rolled=$(printf '%s\n' "$staged_added_text" | grep -nE '\(?std::(min|max)[<(]' || true)
    [ -z "$rolled" ] || reject_with_reason "$rolled" \
        "$staged_path uses std::min/std::max; write min_of(left, right) from usearch/utilities/types.hpp:"
}

# `fu::preferred_yield_t` and `fu::preferred_atomic_ref` are for a unit that dispatches nothing;
# every unit under include/ and src/ takes the probe lists, where they resolve to the newest
# buildable rung. A lock takes `fu::spin_mutex_t`; a class's waiter and reference come from
# `waiter_of` and `atomic_ref_for_cpu_class`.
check_preferred_aliases() {
    local hits
    hits=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E '\bfu::preferred_(yield_t|atomic_ref)\b' || true)
    [ -z "$hits" ] || reject_with_reason "$hits" \
        "$staged_path names a ForkUnion alias meant for units that dispatch nothing; a lock takes fu::spin_mutex_t," \
        "            a class's waiter is waiter_of<class_>, its reference atomic_ref_for_cpu_class<class_>:"
}

# A two-way structured binding is an `expected` taken apart, so its halves read `[thing, status]`:
# the status half is `status` or `<verb>_status`, never a participle, and the payload half never
# carries the suffix. A `std::pair` binds under the same rule; `[first, second]` says nothing
# either.
check_expected_bindings() {
    local participle suffixed
    participle=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E 'auto( const)?&? \[[a-z_]+, [a-z_]+\] =' |
        grep -vE 'auto( const)?&? \[[a-z_]+, (status|[a-z]+(_[a-z]+)*_status)\] =' || true)
    suffixed=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E 'auto( const)?&? \[[a-z_]+_status, ' || true)
    [ -z "$participle$suffixed" ] || reject_with_reason "$participle$suffixed" \
        "$staged_path binds an expected as [payload, participle]; the status half is \`status\` or \`<verb>_status\`:"
}

# C stdio printing in C++ sources: tests and headers print through fmt::. The C bindings under c/
# keep their stdio; the dispatch below only routes C++ translation units here.
check_printf() {
    local prints
    prints=$(printf '%s\n' "$staged_added_text" | grep -E '\b(std::)?(f|s)?printf[[:space:]]*\(|\bputs[[:space:]]*\(' || true)
    [ -z "$prints" ] || reject_with_reason "$prints" \
        "$staged_path prints through the C stdio family; write fmt::println(\"{} rows\", count):"
}

# A `fmt::print` whose literal does not end in a newline is half a line, and the other half arrives
# in a second call; `fmt::styled` and `fmt::join` fold both halves into one `println`. A literal
# opening with a carriage return is a redraw, never a fragment.
check_partial_prints() {
    local partial
    partial=$(printf '%s\n' "$staged_added_text" | grep -E 'fmt::print\(' | grep -vE '\\n"' | grep -vE 'fmt::print\("\\r' || true)
    [ -z "$partial" ] || reject_with_reason "$partial" \
        "$staged_path prints half a line; fold it into one fmt::println, with fmt::styled or fmt::join:"
}

# Rejects a print to stdout in a test body: the harness owns stdout, and a test only reports
# failures to stderr, so a passing run reads the same in every sibling.
check_test_bodies_quiet() {
    local prints
    prints=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns |
        grep -nE '\b(print_line|fmt::println|fmt::print|printf|puts)[[:space:]]*\(|\bstd::cout\b|\bfprintf[[:space:]]*\([[:space:]]*stdout\b' |
        grep -vE '\([[:space:]]*stderr\b' || true)
    [ -z "$prints" ] || reject_with_reason "$prints" \
        "$staged_path prints to stdout from a test body; report failures to stderr and leave progress" \
        "            to the harness:"
}

# C++ iostreams, `std::cout`, `std::ifstream`, `std::ostringstream` and the rest of the
# `std::*stream` family, are banned wholesale: locale-dependent, allocation-happy, and verbose.
# Printing goes through fmt::, file reading through the C stdio family or mmap views.
check_stl_streams() {
    local streams
    streams=$(printf '%s\n' "$staged_added_text" |
        grep -E 'std::[a-z_]*stream|std::(cout|cerr|cin|clog|endl)\b|#[[:space:]]*include[[:space:]]*<(iostream|sstream|fstream|ostream|istream|iomanip)>' || true)
    [ -z "$streams" ] || reject_with_reason "$streams" \
        "$staged_path uses C++ iostreams; print through fmt::, read files through C stdio or mmap:"
}

# The `std::ranges` algorithms and views are deep concept-checked templates that every unit
# including the library pays to instantiate, and since C++20 libstdc++'s `<algorithm>` drags all of
# them in. Library code copies with `std::memcpy`, fills with a loop or `std::memset`, and searches
# through the house `lower_bound`.
check_ranges_templates() {
    local hits
    hits=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*(//|/\*|\*( |/|$))' |
        grep -E '\bstd::(ranges|views)::|#[[:space:]]*include[[:space:]]*<(ranges|algorithm)>' || true)
    [ -z "$hits" ] || reject_with_reason "$hits" \
        "$staged_path pulls the std::ranges templates into the library; copy with std::memcpy, fill with a loop" \
        "            or std::memset, and include neither <algorithm> nor <ranges>:"
}

# Reinterpreting copies in C++ sources: a `memcpy` between two objects whose byte count is one
# object's `sizeof` is a type pun, and `std::bit_cast` states it outright. Byte moves keep their
# memcpy: a runtime-sized bulk copy, or one object serialized into or out of a byte run.
check_memcpy_type_puns() {
    local puns
    # A pun takes the address of both objects and a lone `sizeof(...)` byte count; a copy whose
    # source or destination is a byte pointer is a serialization and passes.
    puns=$(printf '%s\n' "$staged_added_text" | grep -E '\bmemcpy[[:space:]]*\([[:space:]]*&[^,]*,[[:space:]]*&' |
        grep -E ',[[:space:]]*sizeof[[:space:]]*\([^)]*\)[[:space:]]*\)' || true)
    [ -z "$puns" ] || reject_with_reason "$puns" \
        "$staged_path reinterprets one object through memcpy; write \`auto bits = std::bit_cast<u64_t>(value);\`:"
}

# A range rebuilt from its own parts, `{x.data(), x.size()}`,
# `{index->path().data(), index->path().size()}` or `std::span<T const>(x.data(), x.size())`, means
# a conversion or an accessor is missing: `std::vector` converts to `std::span`, NumKong spans
# convert to views, and containers can grow `begin()`/`end()`. Pass the range itself.
check_range_reconstruction() {
    # `types.hpp` hosts `to_span`, the very conversion this check points everyone to, so its own
    # definition is the one legitimate `.data()/.size()` reconstruction site.
    [ "$staged_path" = "include/usearch/utilities/types.hpp" ] && return 0
    local rebuilt
    # The range may be reached through calls and arrows, and rebuilt in braces or in a view's
    # parentheses
    rebuilt=$(printf '%s\n' "$staged_added_text" |
        grep -E '(\{|(span|string_view|_view_t|_span_t)(<.*>)?( const)?( [a-z_]+)? *\() *([A-Za-z_][A-Za-z0-9_.()>-]*)(\.|->)data\(\), *\6(\.|->)size\(\) *[})]' || true)
    [ -z "$rebuilt" ] || reject_with_reason "$rebuilt" \
        "$staged_path rebuilds a range from its own .data()/.size(); pass the range itself," \
        "            or add the missing accessor or conversion:"
}

# `.data()` as an emptiness probe reads as pointer plumbing; every NumKong tensor, view, and span,
# like the STL containers, spells it `empty()`.
check_data_null_probe() {
    local probes
    probes=$(printf '%s\n' "$staged_added_text" |
        grep -E '![A-Za-z_][A-Za-z0-9_.]*\.data\(\)|\.data\(\) *== *nullptr' || true)
    [ -z "$probes" ] || reject_with_reason "$probes" \
        "$staged_path probes emptiness through .data(); write \`if (values.empty())\`:"
}

# Subscripting a call's result chains two accessors where the container offers one:
# `matrix.row(i)[j]`, `pool.begin()[i]`, and `.data()[i]` all hide the same raw-pointer hop. Use the
# multi-index `operator()`, `matrix(i, j)`, or the container's own `operator[]`; a bare `.data()`
# pointer is reserved for one-time lifts handed to syscalls and SIMD kernels.
check_call_chained_subscript() {
    local chained
    # An identifier must sit against the opening parenthesis, so a dereference `(*owner)[i]` and an
    # array-reference parameter `(&ids)[width]` stay out of it; neither is a call.
    chained=$(printf '%s\n' "$staged_added_text" | grep -E '[A-Za-z0-9_>]\([^()]*\)\[' || true)
    [ -z "$chained" ] || reject_with_reason "$chained" \
        "$staged_path subscripts a call result; write matrix(row, column) or results[index]," \
        "            never results.data()[index]:"
}

# CUDA's `atomicAdd`-family intrinsics never name their memory order: they are relaxed at device
# scope, and a reader cannot tell whether that was chosen. Every shared word goes through
# `cuda_atomic_ref` with an explicit order, as weak as the protocol allows.
check_cuda_raw_atomics() {
    local raw
    raw=$(printf '%s\n' "$staged_added_text" |
        grep -E '(^|[^A-Za-z0-9_])atomic(Add|Sub|Or|And|Xor|CAS|Exch|Min|Max|Inc|Dec)(_block|_system)?\(' || true)
    [ -z "$raw" ] || reject_with_reason "$raw" \
        "$staged_path calls a CUDA atomic intrinsic; use cuda_atomic_ref with an explicit memory order:"
}

# A file every GPU vendor compiles names no vendor: its symbols are `dense::vram_*`, never a
# `cuda_`, `hip_` or `metal_` one, and its collectives come from the warp policy a kit names, never
# from one vendor's own.
check_vendor_neutral() {
    local named
    named=$(printf '%s\n' "$staged_added_text" | grep -E '(^|[^A-Za-z0-9_])(cuda|hip|metal)_[A-Za-z0-9_]' || true)
    [ -z "$named" ] || reject_with_reason "$named" \
        "$staged_path is shared by every GPU vendor; its symbols say vram_*, and a vendor's calls stay in its own tower:"
}

# A C verb serves every residency through the face its index holds and never asks which residency or
# vendor that is: no `is_vram_index`, no vendor enumerator, and no comparison of a `home_`,
# `residency_` or `packs_on_device_k` answer.
check_residency_branches() {
    local branching
    branching=$(printf '%s\n' "$staged_added_text" |
        grep -E 'is_(ram|vram|nvme)_index|gpu_vendor_of_index|gpu_vendor_t::|vendor_k|(home|residency)_[[:space:]]*==|residency[[:space:]]*!=[[:space:]]*ram_residency_k|(home|residency)_of<|(if|while)[[:space:]]*(constexpr[[:space:]]*)?\([^)]*packs_on_device_k|packs_on_device_k[[:space:]]*(==|!=|\?|&&|\|\|)|(==|!=|!|&&|\|\|)[[:space:]]*[A-Za-z_:<>]*packs_on_device_k' || true)
    [ -z "$branching" ] || reject_with_reason "$branching" \
        "$staged_path branches a C verb on residency or vendor; the face serves the verb or answers unsupported_k:"
}

check_deleted_verbs() {
    local deleted
    deleted=$(printf '%s\n' "$staged_added_text" | grep -E '= delete;' | grep -vE 'operator[[:space:]]*=' |
        grep -vE '^[+]?[[:space:]]*(explicit[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(' || true)
    [ -z "$deleted" ] || reject_with_reason "$deleted" \
        "$staged_path deletes a verb; a face keeps every verb, answering unsupported_k or device_k where it serves none:"
}

check_tower_isolation() {
    local vendor crossing
    # The device listing alone gathers every vendor's devices, so it alone includes every tower.
    [ "$staged_path" != include/usearch/utilities/vram_device.hpp ] || return 0
    vendor=$(basename "$staged_path" | sed -nE 's/^vram_(nvidia|amd|apple)_.*/\1/p')
    crossing=$(grep -nE '^[[:space:]]*#[[:space:]]*(include|embed)[[:space:]]*"usearch/[a-z_]+/vram_(nvidia|amd|apple)_' \
        "$staged_text_path" | grep -vE "vram_${vendor:-none}_" || true)
    [ -z "$crossing" ] || reject_with_reason "$crossing" \
        "$staged_path reaches into a vendor's tower; towers include only their own vendor, and shared headers none:"
}

# Calling a call's result the same way: `vectors.view()(range, slice)` reads as a typo and hides
# which object the second call lands on. NumKong's owning tensors slice themselves,
# `vectors(range, slice)`, and any other first result takes a name before it is called.
check_call_chained_call() {
    local chained
    chained=$(printf '%s\n' "$staged_added_text" | grep -E '[A-Za-z0-9_>]\(\)\(' | grep -v 'operator()(' || true)
    [ -z "$chained" ] || reject_with_reason "$chained" \
        "$staged_path calls a call result; slice an owning tensor directly, or name the first result:"
}

# The `&*iterator` antipattern: laundering an iterator through a reference into a pointer. Take the
# container's `data()`, or address the element itself.
check_iterator_laundering() {
    local laundered
    laundered=$(printf '%s\n' "$staged_added_text" | grep -E '&\*[A-Za-z_]' || true)
    [ -z "$laundered" ] || reject_with_reason "$laundered" \
        "$staged_path launders an iterator through &*; write \`values.data() + offset\`, or address the element:"
}

# Preprocessor conditionals a reader can match by eye: two levels at most, not counting the include
# guard, no `#elif` chain inside another chain, and an `#endif` that closes a pair names its
# condition, as in `#endif // !defined(USEARCH_DEFAULT_ALIGNMENT)`. A conditional is judged when any
# of its directives, or those of a conditional inside it, is an added line.
check_preprocessor_nesting() {
    local tangled
    tangled=$(scan_staged_file_marking_added_lines '
        pending != "" && NF {
            if ($1 == "#define" && $2 == pending) guarded = 1
            pending = ""
        }
        !/^[[:space:]]*#/ { next }
        {
            directive = $0
            sub(/^[[:space:]]*#[[:space:]]*/, "", directive)
            keyword = directive; sub(/[^a-z].*$/, "", keyword)
        }
        keyword ~ /^if(def|ndef)?$/ {
            ++level
            chain[level] = holds[level] = inner_chain[level] = 0
            touched[level] = (FNR in added)
            if (level == 1 && keyword == "ifndef" && !opened_any) { pending = directive; sub(/^ifndef[[:space:]]+/, "", pending); sub(/[[:space:]].*$/, "", pending) }
            opened_any = 1
            if (level > 1) holds[level - 1] = 1
            if (level - guarded > 2 && touched[level])
                printf "line %d: opens a third conditional level; fold two conditions into one line\n", FNR
            next
        }
        keyword == "elif" && level { chain[level] = 1; if (FNR in added) touched[level] = 1; next }
        keyword == "else" && level { if (FNR in added) touched[level] = 1; next }
        keyword == "endif" && level {
            if (FNR in added) touched[level] = 1
            is_guard = (level == 1 && guarded)
            if (!is_guard && touched[level] && chain[level] && inner_chain[level])
                printf "line %d: closes an #elif chain that holds another #elif chain\n", FNR
            if (!is_guard && touched[level] && holds[level] && $0 !~ /\/\/[[:space:]]*[^[:space:]]/)
                printf "line %d: closes a conditional that holds another; name it: #endif // <condition>\n", FNR
            if (level > 1) {
                if (chain[level]) inner_chain[level - 1] = 1
                if (touched[level]) touched[level - 1] = 1
            }
            if (is_guard) guarded = 0
            --level
            next
        }')
    [ -z "$tangled" ] || reject_with_reason "$tangled" \
        "$staged_path tangles its preprocessor conditionals; two levels at most, no #elif chain inside another," \
        "            and an #endif closing a nested pair names its condition:"
}

# A requires-clause names what it admits. Parentheses wrap only what the grammar needs them for, a
# comparison, a call or a negation, never names joined by && and ||; and a clause never opens with a
# negation: a fallback beside `requires X` stays unconstrained, since the constrained overload
# already wins wherever X holds.
check_requires_clauses() {
    local negated wrapped name='[A-Za-z_][A-Za-z0-9_:]*(<[^()&|]*>)?'
    negated=$(printf '%s\n' "$staged_added_text" | grep -E '^\+[^/*]*requires[[:space:]]*\([[:space:]]*!' || true)
    [ -z "$negated" ] || reject_with_reason "$negated" \
        "$staged_path opens a requires-clause with a negation; leave the fallback unconstrained, name the" \
        "            alternative as a concept of its own, or branch with if constexpr:"
    wrapped=$(printf '%s\n' "$staged_added_text" |
        grep -E "^\+[^/*]*requires[[:space:]]*\([[:space:]]*$name([[:space:]]*(&&|\|\|)[[:space:]]*$name)*[[:space:]]*\)[[:space:]]*\$" ||
        true)
    [ -z "$wrapped" ] || reject_with_reason "$wrapped" \
        "$staged_path wraps plain names in parentheses; write \`requires concept<type_> && other<type_>\`:"
}

# A const member that locks or writes hides a mutation behind its signature: such members are
# non-const, and a const reader only loads, through `standard_atomic_ref<T const>`, the one
# `const_cast` this allows. The whole file is judged, so touching one finishes its cleanup.
check_mutable_and_const_cast() {
    local hits
    hits=$(sed -E 's/"([^"\\]|\\.)*"//g' "$staged_text_path" | grep -nE '\bmutable\b|\bconst_cast\b' |
        grep -vE '^[0-9]+:[[:space:]]*(//|/\*|\*)' |
        grep -vF 'standard_atomic_ref(value_type_ const& word) noexcept : word_(const_cast<value_type_&>(word))' ||
        true)
    [ -z "$hits" ] || reject_with_reason "$hits" \
        "$staged_path writes through const; make the member that locks or writes non-const, a const reader loads" \
        "            through standard_atomic_ref<T const>, the only const_cast allowed:"
}

# Host threads managing GPUs in CUDA sources: fleets of NVLink-resident devices are orchestrated
# with per-device non-blocking streams and events from one host thread, kernel launches are already
# asynchronous, cross-device ordering is `cudaStreamWaitEvent`, and completion is an event-sync
# loop, so `std::thread` adds nothing but scheduling noise.
check_host_threads() {
    local threads
    threads=$(printf '%s\n' "$staged_added_text" |
        grep -E '\bstd::(thread|jthread|async)\b|#include[[:space:]]*<thread>|\bpthread_' || true)
    [ -z "$threads" ] || reject_with_reason "$threads" \
        "$staged_path spawns host threads in a GPU backend; orchestrate devices with per-device" \
        "            non-blocking cudaStream_t + cudaEvent_t from one host thread:"
}

# GCC atomic builtins fork the memory-model dialect. In-place words go through the class's ForkUnion
# atomic reference with an explicit `std::memory_order`, the same words the ForkUnion waiters
# monitor, so loads, stores and waits compose.
check_gcc_atomics() {
    local builtins
    builtins=$(printf '%s\n' "$staged_added_text" | grep -E '__atomic_[a-z_]+|__builtin_[a-z_]+|__ATOMIC_[A-Z_]+' || true)
    [ -z "$builtins" ] || reject_with_reason "$builtins" \
        "$staged_path uses a GCC atomic builtin; write atomic_ref_t {word}.load(std::memory_order_acquire) through" \
        "            the class's ForkUnion atomic reference, naming the memory order at every access:"
}

# A TSan unlock bracket hides the word's own atomics, so the raw release that pairs with a wait-free
# probe's `annotate_acquire` has to come right before `annotate_unlock*_started`, never inside the
# bracket, or the probe's edge vanishes under TSan.
check_annotate_release_before_unlock() {
    printf '%s\n' "$staged_added_text" | grep -q 'annotate_' || return 0
    local probed misplaced
    probed=$(grep -o 'annotate_acquire(&[a-z_]*' "$staged_text_path" | sed 's/.*(//' | sort -u | tr '\n' ' ')
    [ -n "$probed" ] || return 0
    misplaced=$("$fastest_awk" -v probed=" $probed" -v path="$staged_path" '
        /annotate_unlock(_shared)?_started\(&[a-z_]+\)/ {
            match($0, /&[a-z_]+/); word = substr($0, RSTART, RLENGTH); inside = 1
            if (index(probed, " " word " ") && previous !~ ("annotate_release\\(" word "\\)")) print path ":" NR ": " $0
        }
        /annotate_unlock(_shared)?_finished\(/ { inside = 0 }
        inside && /annotate_release\(/ { print path ":" NR ": " $0 }
        NF && $0 !~ /^[[:space:]]*\/\// { previous = $0 }
    ' "$staged_text_path")
    [ -z "$misplaced" ] || reject_with_reason "$misplaced" \
        "$staged_path misplaces the release of a probed word; write annotate_release(&word) immediately" \
        "            before annotate_unlock_started(&word), never inside the bracket:"
}

# An integer quotient compared against zero says `a < b` the long way round, and it reads as a
# second divisibility test beside the `%` it usually sits next to. Line comments are stripped first,
# so prose about a quotient never trips it.
check_quotient_compared_to_zero() {
    local quotients
    quotients=$(scan_staged_file_marking_added_lines '
        FNR in added {
            line = $0
            sub(/\/\/.*/, "", line)
            sub(/#.*/, "", line)
            if (line ~ /\/[[:space:]]*[A-Za-z_][A-Za-z0-9_.()]*[[:space:]]*[=!]=+[[:space:]]*0([^.0-9]|$)/)
                printf "%d:%s\n", FNR, $0
        }')
    [ -z "$quotients" ] || reject_with_reason "$quotients" \
        "$staged_path compares an integer quotient against zero; write \`numerator < denominator\`:"
}

# CMake spells every target, source and flag it means at the call that means it. Deriving one by
# replacing, slicing or matching out part of another string, or by editing a list in place, hides
# what the build compiles: pass each name as an argument instead, under a keyword where several
# kinds travel together. Building a list with `list(APPEND)` and testing a value with
# `if (... MATCHES ...)` stay free.
check_cmake_string_surgery() {
    local surgery
    surgery=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*#' |
        grep -iE '(^|[^A-Za-z0-9_])(string[[:space:]]*\([[:space:]]*(REPLACE|REGEX|SUBSTRING|STRIP|TOLOWER|TOUPPER)[[:space:]]|list[[:space:]]*\([[:space:]]*(TRANSFORM|FILTER|REMOVE_ITEM|REMOVE_AT|REMOVE_DUPLICATES|SUBLIST|POP_BACK|POP_FRONT|INSERT|JOIN|SORT|REVERSE)[[:space:]]|(get_filename_component|cmake_path)[[:space:]]*\()' ||
        true)
    [ -z "$surgery" ] || reject_with_reason "$surgery" \
        "$staged_path derives a name or flag by editing a string or a list; spell each one out at its call and pass it as" \
        "            an argument, as \`usearch_dense_dtype_sources(target BF16 a_bf16.cpp F16 a_f16.cpp)\` does:"
}

# The CPython bindings parse arguments and build results by hand: `PyArg_Parse*` and `Py_BuildValue`
# interpret a format string at runtime, so a wrong specifier is a crash rather than a compile error,
# and their error paths are the interpreter's rather than ours.
check_cpython_format_shortcuts() {
    local shortcuts
    shortcuts=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns |
        grep -E '\b(Py_BuildValue|PyArg_Parse[A-Za-z]*|PyArg_UnpackTuple)[[:space:]]*\(' || true)
    [ -z "$shortcuts" ] || reject_with_reason "$shortcuts" \
        "$staged_path calls a format-string shortcut of the C API; walk the arguments by hand and build results with" \
        "            PyDict_New / PyLong_FromSize_t and usearch_py_dict_steal_item:"
}

# `sys.version` is a display string whose shape is not contractual; every question about the running
# interpreter has a structured answer.
check_python_version_probe() {
    local probes
    probes=$(printf '%s\n' "$staged_added_text" | grep -nE 'sys\.version[^_]' || true)
    [ -z "$probes" ] || reject_with_reason "$probes" \
        "$staged_path parses \`sys.version\`, a human-readable string; use \`sys.version_info\` for" \
        "            comparisons or \`platform.python_version()\` for display:"
}

# A bare `np.ndarray` annotation hides the dtype a caller must pass or gets back.
check_python_array_annotations() {
    local bare
    bare=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*#' |
        grep -E '(->|:)[^=#]*\b(np|numpy)\.ndarray\b' || true)
    [ -z "$bare" ] || reject_with_reason "$bare" \
        "$staged_path annotates a bare np.ndarray; name the dtype, as npt.NDArray[np.float32], or take" \
        "            npt.ArrayLike for inputs:"
}

# A library type derives from none: a base couples one type's layout and lifetime to another's, so
# shared behavior is a member the type holds. Nor does library code lock through the standard
# mutexes and condition variables: it serializes through the ForkUnion locks and waiters its caller
# passes. A `std::formatter` specialization keeps its parent, since its qualified name never
# matches.
check_inheritance_and_locks() {
    local derived locks
    derived=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        grep -E '(^|[^A-Za-z0-9_])(struct|class)[[:space:]]+((alignas\([^)]*\)|\[\[[^]]*\]\])[[:space:]]+)*[A-Za-z_][A-Za-z0-9_]*(<[^;{]*>)?([[:space:]]+final)?[[:space:]]*:([^:]|$)|^\+[[:space:]]*:[[:space:]]*(public|protected|private|virtual)[[:space:]]' |
        grep -vE '(^|[^A-Za-z0-9_])enum[[:space:]]+(class|struct)[[:space:]]' || true)
    [ -z "$derived" ] || reject_with_reason "$derived" \
        "$staged_path derives one type from another in library code; hold the shared part as a member:"
    locks=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns |
        grep -E '\bstd::([a-z_]*mutex|lock_guard|unique_lock|shared_lock|scoped_lock|condition_variable[a-z_]*)\b|#[[:space:]]*include[[:space:]]*<(thread|mutex|shared_mutex|condition_variable)>' || true)
    [ -z "$locks" ] || reject_with_reason "$locks" \
        "$staged_path locks through the standard library in library code; take the ForkUnion lock or waiter the caller passes:"
}

# Shared words go through the class's ForkUnion atomic reference and waiter, which src/ picks per
# CPU class.
check_standard_atomics() {
    local atomics
    atomics=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns |
        grep -nE '\bstd::atomic(_ref|_flag)?\b|#[[:space:]]*include[[:space:]]*<atomic>|\.notify_(all|one)[[:space:]]*\(' || true)
    [ -z "$atomics" ] || reject_with_reason "$atomics" \
        "$staged_path uses a standard atomic; take the class's ForkUnion atomic reference and wait through its waiter:"
}

# An engine never sleeps or yields on its own schedule: how a thread waits, spinning, yielding or
# parking, is the caller's choice, so it waits through the waiter or pause src/ passes, and src/
# alone spells the sleep, a yielding waiter included, whether called or defaulted.
check_library_sleeps() {
    local sleeps
    sleeps=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        grep -E '(^|[^A-Za-z0-9_])(nanosleep|usleep|sleep|sched_yield)[[:space:]]*\(|\bsleep_(for|until)\b|\bstd::this_thread\b|standard_yield_t[[:space:]]*\{[[:space:]]*\}|=[[:space:]]*(fu::)?standard_yield_t\b' ||
        true)
    [ -z "$sleeps" ] || reject_with_reason "$sleeps" \
        "$staged_path sleeps or yields in an engine; wait through the waiter or pause src/ passes:"
}

# An engine takes kits, never the mask they were picked under: no `nk_capability_t` member, local or
# function parameter appears under include/, except a kit's own `capability_k`.
check_capability_masks_in_engines() {
    local masks
    masks=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns |
        grep -E '^\+[[:space:]]*((static|inline|constexpr)[[:space:]]+)*nk_capability_t([[:space:]]+const)?[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(;|=|\{)|[(,][[:space:]]*nk_capability_t([[:space:]]+const)?[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*([,)=]|$)' |
        grep -vE '[[:space:]]capability_k[[:space:]]*=' || true)
    [ -z "$masks" ] || reject_with_reason "$masks" \
        "$staged_path holds or takes a NumKong capability mask under include/; take the kits src/ picks under it:"
}

# Engines take kits, and `src/` alone picks them per class: nothing under `include/usearch/` names a
# class enum or a class unit, anywhere in the file, since the enums live in `src/lib.hpp`.
check_classes_out_of_engines() {
    local named
    named=$(grep -nE '(^|[^A-Za-z0-9_])(cpu|gpu)_class_t|_variants_' "$staged_code_path" || true)
    [ -z "$named" ] || reject_with_reason "$named" \
        "$staged_path names a CPU or GPU class under include/; an engine takes the kits src/ picks per class:"
}

# Tests and benchmarks reduce through NumKong, which accumulates in a fixed order and compensates
# Float64, instead of loops widening BFloat16 one element at a time: widen a buffer once with
# `nk::cast`, then reduce it with `nk::dot`, `nk::dots_unpacked` or `nk::reduce_moments`.
check_widened_accumulation() {
    local loops
    loops=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns | grep -E '\+=' |
        grep -E '__bfloat162float[[:space:]]*\(|__half2float[[:space:]]*\(' || true)
    [ -z "$loops" ] || reject_with_reason "$loops" \
        "$staged_path accumulates hand-widened BFloat16; widen once with nk::cast, then reduce with" \
        "            nk::dot, nk::dots_unpacked or nk::reduce_moments:"
}

# Rejects a concrete node ID width under the width-free directories, because the utilities and basic
# engines take `node_id_type_` and the concrete width lives in dense/types.hpp and src/. A member
# alias reading `node_id_t` off `node_id_type_` or off another type's alias is how a width arrives,
# so those two spellings pass, and so do uses of `node_id_t` in a file that declares the alias.
check_node_id_width() {
    local widths alias_uses='(^|[^A-Za-z0-9_])node_id_t([^A-Za-z0-9_]|$)|'
    # A file that declares the alias spells its own width, so its uses of the alias are not a concrete width.
    git show ":$staged_path" | grep -qE '^[[:space:]]*using node_id_t = (node_id_type_|typename [^;]+::node_id_t);' && alias_uses=
    widths=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns |
        grep -vE '^\+[[:space:]]*using node_id_t = (node_id_type_|typename [^;]+::node_id_t);' |
        grep -nE "${alias_uses}"'(^|[^A-Za-z0-9_])u32_t[[:space:]]+node([^A-Za-z0-9_]|$)|0xFFFFFFFF|static_cast<u32_t>\(node' || true)
    [ -z "$widths" ] || reject_with_reason "$widths" \
        "$staged_path names a node ID width; the utilities and basic engines take node_id_type_, and the concrete" \
        "            width lives in dense/types.hpp and src/:"
}

# Rejects `decltype` under include/ or src/, because a type is spelled by the alias that owns it, as
# Spelling Types in CONTRIBUTING.md says; a `decltype` makes every reader evaluate an expression to
# learn a type its author knew.
check_decltype() {
    local deduced
    deduced=$(grep -nE '(^|[^A-Za-z0-9_])decltype[[:space:]]*\(' "$staged_added_code_path" || true)
    [ -z "$deduced" ] || reject_with_reason "$deduced" \
        "$staged_path names a type through decltype; spell the owning alias, or add a member typedef where none" \
        "            exists, as Spelling Types in CONTRIBUTING.md says:"
}

# The brace stack every member check below shares: `kind[depth]` is "record" inside a struct, class
# or union body, "code" inside a function body, and "namespace" elsewhere, so a local or a parameter
# never counts as a member. The caller sets `code` to the line without comments before each step.
record_scope_awk='
    function step_scope(code,    position, character) {
        statement = statement " " code
        for (position = 1; position <= length(code); ++position) {
            character = substr(code, position, 1)
            if (character == "{") {
                ++depth
                if (kind[depth - 1] == "code") kind[depth] = "code"
                else if (statement ~ /(^|[^A-Za-z0-9_])(struct|class|union)([^A-Za-z0-9_]|$)/ &&
                         statement !~ /(^|[^A-Za-z0-9_])enum([^A-Za-z0-9_]|$)/ && statement !~ /\)/) kind[depth] = "record"
                else if (statement ~ /(^|[^A-Za-z0-9_])namespace([^A-Za-z0-9_]|$)/) kind[depth] = "namespace"
                else kind[depth] = "code"
                statement = ""
            } else if (character == "}") { if (depth > 0) delete kind[depth--]; statement = "" }
            else if (character == ";") statement = ""
        }
    }
'

# Rejects an added `bool` data member under include/ or src/, because an enum, a type or a protocol
# says what a flag would; a `static` or `constexpr` constant is a value, not a flag, and a local or
# a parameter is no member.
check_bool_members() {
    local flags
    flags=$(scan_staged_file_marking_added_lines "$record_scope_awk"'
        {
            if (kind[depth] == "record" && (FNR in added) &&
                $0 !~ /^[[:space:]]*bool[[:space:]]+operator/ && $0 !~ /^[[:space:]]*bool[^=;{(]*\(/ &&
                $0 ~ /^[[:space:]]*bool[[:space:]]+(const[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(=[^;]*|\{[^}]*\})?;[[:space:]]*$/)
                printf "line %d: %s\n", FNR, $0
            step_scope($0)
        }' "$staged_code_path")
    [ -z "$flags" ] || reject_with_reason "$flags" \
        "$staged_path adds a bool member; an enum, a type or a protocol says what a flag would:"
}

# Rejects a `std::unique_ptr<T>` member beside a `T *` or `T const *` member of the same T in one
# record, because the owner and the borrowed handle of one object are one member: ownership is a
# type, and borrowing is the absence of an owner. The whole file is read, since membership is
# context, and only added lines report.
check_owned_beside_borrowed() {
    local pairs
    pairs=$(scan_staged_file_marking_added_lines "$record_scope_awk"'
        function close_record(d,    key, parts) {
            for (key in owned) {
                split(key, parts, SUBSEP)
                if (parts[1] != d || !((d, parts[2]) in borrowed)) continue
                if (owned[key] in added) printf "line %d: %s\n", owned[key], text[owned[key]]
                if (borrowed[d, parts[2]] in added) printf "line %d: %s\n", borrowed[d, parts[2]], text[borrowed[d, parts[2]]]
            }
            for (key in owned) { split(key, parts, SUBSEP); if (parts[1] == d) delete owned[key] }
            for (key in borrowed) { split(key, parts, SUBSEP); if (parts[1] == d) delete borrowed[key] }
        }
        {
            text[FNR] = $0
            if (kind[depth] == "record") {
                if (match($0, /std::unique_ptr<[^;=]*>[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(=[^;]*|\{[^}]*\})?;/)) {
                    held = substr($0, RSTART + 16); sub(/[,>].*$/, "", held); gsub(/^[[:space:]]+|[[:space:]]+$|\[\]$/, "", held)
                    owned[depth, held] = FNR
                } else if (match($0, /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>]*([[:space:]]+const)?[[:space:]]*\*[[:space:]]*(const[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(=[^;]*|\{[^}]*\})?;/)) {
                    held = $0; sub(/^[[:space:]]*/, "", held); sub(/([[:space:]]+const)?[[:space:]]*\*.*$/, "", held)
                    borrowed[depth, held] = FNR
                }
            }
            closing = depth
            step_scope($0)
            if (depth < closing) close_record(closing)
        }' "$staged_code_path")
    [ -z "$pairs" ] || reject_with_reason "$pairs" \
        "$staged_path holds an owning unique_ptr beside a raw pointer to the same type; ownership is a type," \
        "            and a borrowed handle is the absence of an owner, so keep one member:"
}

# Rejects `f64_t` or `double` declaring a score, distance, accumulator or product under dense/,
# because every such type comes from NumKong's per-input result aliases, as Numeric Precision in
# CONTRIBUTING.md says; the C interface's `usearch_distance_t`, an explicit `multiply<f64_t>`, F64
# products, sums and totals over many products, which may widen, and comments are exempt.
check_dense_f64() {
    local widened
    widened=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns |
        grep -vE 'usearch_distance_t|multiply<f64_t>|products.*f64|f64.*products' |
        grep -nE '(^|[^A-Za-z0-9_])(f64_t|double)(([[:space:]]+const)?[[:space:]]*[*&]*[[:space:]]+|[[:space:]]*>[[:space:]]+)[A-Za-z_]*(score|distance|accumulat|product)[A-Za-z0-9_]*|using [A-Za-z_]*(score|distance|accumulat|product)[A-Za-z0-9_]* = (f64_t|double)' || true)
    [ -z "$widened" ] || reject_with_reason "$widened" \
        "$staged_path widens a score, distance, accumulator or product to F64; spell NumKong's per-input" \
        "            result alias, as Numeric Precision in CONTRIBUTING.md says:"
}

# Rejects a hot-entry struct added under include/ without a `static_assert(sizeof(` within five
# lines after its closing brace, because a struct a thread keeps or carries along a hot path is 8,
# 16 or 32 bytes, and the assertion beside the definition is what pins it; a name ending in
# `_entry_t`, `_match_t`, `_node_t`, `_flight` or `_payload` marks one.
check_hot_entry_asserts() {
    local unpinned
    unpinned=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) {
                if (!(line in added)) continue
                if (lines[line] !~ /^[[:space:]]*(template[[:space:]]*<[^>]*>[[:space:]]*)?struct[[:space:]]+(alignas\([^)]*\)[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*(_entry_t|_match_t|_node_t|_flight|_payload)([^A-Za-z0-9_]|$)/) continue
                if (lines[line] ~ /;[[:space:]]*$/ && lines[line] !~ /\{/) continue
                depth = 0; closing = 0
                for (scan = line; scan <= last; ++scan) {
                    code = lines[scan]
                    depth += gsub(/\{/, "{", code) - gsub(/\}/, "}", code)
                    if (depth <= 0 && lines[scan] ~ /\}/) { closing = scan; break }
                }
                if (!closing) continue
                pinned = 0
                for (scan = closing + 1; scan <= closing + 5 && scan <= last; ++scan)
                    if (lines[scan] ~ /static_assert[[:space:]]*\([[:space:]]*sizeof[[:space:]]*\(/) pinned = 1
                if (!pinned) printf "line %d: %s\n", line, lines[line]
            }
        }' "$staged_code_path")
    [ -z "$unpinned" ] || reject_with_reason "$unpinned" \
        "$staged_path adds a hot entry without pinning its size; a struct a thread carries along a hot path is 8, 16" \
        "            or 32 bytes, so write static_assert(sizeof(entry_t) == 16) right below it:"
}

# Rejects an identifier carrying a word from `identifier_words_refused` as a whole snake_case word,
# such as `join_every_shard`, `dirty_` or `landed_match_t`, because the Vocabulary table in
# CONTRIBUTING.md names each concept once. Comments and string literals are blanked first.
check_identifier_words() {
    local refused
    refused=$(sed -E 's/"([^"\\]|\\.)*"//g' "$staged_added_code_path" |
        "$fastest_awk" -v words="$identifier_words_refused" '
        BEGIN {
            count = split(words, list, " "); for (index_ = 1; index_ <= count; ++index_) banned[list[index_]] = 1
        }
        {
            line = substr($0, 2); rest = line
            while (match(rest, /[A-Za-z_][A-Za-z0-9_]*/)) {
                token = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
                if (token ~ /^fu_pool_/) continue # the ForkUnion C API spells its thread pools so
                total = split(tolower(token), parts, "_")
                for (part = 1; part <= total; ++part) {
                    if (!(parts[part] in banned)) continue
                    print "    " token ": " line
                    next
                }
            }
        }' || true)
    [ -z "$refused" ] || reject_with_reason "$refused" \
        "$staged_path names a concept by a refused word; the Vocabulary table in CONTRIBUTING.md names each one," \
        "            residency for home, await for join, picked for dirty, visited for seen, and so on:"
}

# Rejects an added data member whose name, trailing underscore stripped, is in
# `member_names_refused`, or ends in `_bits`, `_buffer` or `_bitset`, because a member names what it
# holds and when it holds it, as the Transient State rules in CONTRIBUTING.md say, never its type or
# a role word alone.
check_member_names() {
    local misnamed
    misnamed=$(refused="$member_names_refused" scan_staged_file_marking_added_lines "$record_scope_awk"'
        BEGIN { count = split(ENVIRON["refused"], list, " "); for (index_ = 1; index_ <= count; ++index_) banned[list[index_]] = 1 }
        {
            if (kind[depth] == "record" && (FNR in added) && $0 !~ /\(/ &&
                $0 !~ /^[[:space:]]*(using|typedef|return|static_assert|friend|static|constexpr)[[:space:]]/ &&
                match($0, /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>, ]*[[:space:]*&]+(const[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(=[^;]*|\{[^}]*\})?;[[:space:]]*$/)) {
                name = $0; sub(/[[:space:]]*(=[^;]*|\{[^}]*\})?;[[:space:]]*$/, "", name); sub(/.*[[:space:]*&]/, "", name)
                stem = name; sub(/_$/, "", stem)
                if ((stem in banned) || stem ~ /_(bits|buffer|bitset)$/) printf "line %d: %s\n", FNR, $0
            }
            step_scope($0)
        }' "$staged_code_path")
    [ -z "$misnamed" ] || reject_with_reason "$misnamed" \
        "$staged_path names a member by its type or a role word alone; say what it holds and when, as the Transient" \
        "            State rules in CONTRIBUTING.md do with picked_this_round_ and visited_:"
}

# Rejects `row`, `rows`, `vector`, `vectors`, `dimension`, `dimensions`, `norm`, `norms`, `head` and
# `heads` as identifiers under include/usearch/utilities/, because the utilities speak of entries,
# nodes, offsets and queries and know no dense vocabulary; the `nk::matrix_span` and
# `nk::vector_span` type spellings and comments are exempt.
check_utilities_vocabulary() {
    local dense_words
    dense_words=$(printf '%s\n' "$staged_added_text" | blank_c_comments_preserving_columns | sed -E 's/"([^"\\]|\\.)*"//g' |
        sed -E 's/nk::(matrix|vector)_span//g' |
        grep -nE '(^|[^A-Za-z0-9_])(rows?|vectors?|dimensions?|norms?|heads?)([^A-Za-z0-9_]|$)' || true)
    [ -z "$dense_words" ] || reject_with_reason "$dense_words" \
        "$staged_path speaks of rows, vectors, dimensions, norms or heads in a utility; the utilities know entries," \
        "            nodes, offsets and queries, and the dense words live in dense/:"
}

# The md5 of the lines between each shared region's `# region` and `# endregion` in NumKong's hook,
# which every sibling hook carries word for word.
shared_region_sums='Shared Helpers	0f47a409a3595919bb8c842cb2947d38
All Files	53c26430146a2f3695eb5998e4b1dc4c
Shared Dispatch	a11a5c81e82ee2814348080827a66f73
Parallel Judging	738b237daa7b91d37b6a535e0f073b9a'

# Rejects a pinned region of this hook whose text drifted from NumKong's copy, because Shared Helpers,
# All Files, Shared Dispatch and Parallel Judging are edited in every sibling hook together, and the
# sums above are what pins them.
check_shared_regions_match() {
    local name expected actual drifted=""
    while IFS=$'\t' read -r name expected; do
        actual=$("$fastest_awk" -v name="$name" '$0 == "# endregion " name { inside = 0 } inside { print } $0 == "# region " name { inside = 1 }' \
            "$staged_text_path" | { command -v md5sum > /dev/null 2>&1 && md5sum || md5; } | cut -d' ' -f1)
        [ "$actual" = "$expected" ] || drifted="$drifted$name: $actual, pinned $expected"$'\n'
    done <<< "$shared_region_sums"
    [ -z "$drifted" ] || reject_with_reason "${drifted%$'\n'}" \
        "$staged_path drifts from NumKong's shared regions; edit a shared region in every sibling" \
        "            hook together, and record the new sums in shared_region_sums:"
}

# Rejects a refused identifier word or member name missing from the Vocabulary table of
# CONTRIBUTING.md, because every word the hook refuses is documented beside the word that replaces
# it; the staged copy answers when one is staged, else the working one, and a tree without the file
# is a fixture.
check_vocabulary_table() {
    [ -f CONTRIBUTING.md ] || return 0
    local table word missing=""
    table=$({ git diff --cached --quiet -- CONTRIBUTING.md && cat CONTRIBUTING.md || git show :CONTRIBUTING.md; } |
        "$fastest_awk" '/^### Vocabulary/ { inside = 1; next } /^#/ { inside = 0 } inside && /^\|/')
    for word in $identifier_words_refused $member_names_refused; do
        printf '%s\n' "$table" | grep -qE "(^|[^A-Za-z0-9_])$word([^A-Za-z0-9_]|$)" || missing="$missing $word"
    done
    [ -z "$missing" ] || reject_with_reason "" \
        "CONTRIBUTING.md's Vocabulary table lacks the refused words:$missing;" \
        "            add each beside the word that replaces it"
}

# Counts the templates and concepts this commit adds net, because a design grows by removing
# abstractions before it adds them; it warns and never fails.
check_abstraction_growth() {
    local templates concepts
    read -r templates concepts <<< "$(git diff --cached --unified=0 | "$fastest_awk" '
        /^\+[[:space:]]*template[[:space:]]*</ { ++templates }
        /^-[[:space:]]*template[[:space:]]*</ { --templates }
        /^\+[[:space:]]*concept[[:space:]]/ { ++concepts }
        /^-[[:space:]]*concept[[:space:]]/ { --concepts }
        END { print templates + 0, concepts + 0 }')"
    [ "$templates" -le 0 ] && [ "$concepts" -le 0 ] ||
        echo "pre-commit: warning: this commit adds $templates templates and $concepts concepts net"
}

# The staged paths matching any of the given globs, NUL-delimited for the readers below.
staged_matching() { # staged_matching <glob>...
    local path pattern
    for path in ${staged_paths[@]+"${staged_paths[@]}"}; do
        for pattern in "$@"; do
            case "$path" in
            $pattern)
                printf '%s\0' "$path"
                break
                ;;
            esac
        done
    done
}

# Whether at least one staged path matches one of the given globs.
staged_any() { # staged_any <glob>...
    local path pattern
    for path in ${staged_paths[@]+"${staged_paths[@]}"}; do
        for pattern in "$@"; do
            case "$path" in
            $pattern) return 0 ;;
            esac
        done
    done
    return 1
}

# Rejects zig fmt drift on staged Zig sources; it skips without zig.
check_zig_format_clean() {
    command -v zig > /dev/null 2>&1 || return 0
    local zig_path
    while IFS= read -r -d '' zig_path; do
        zig fmt --check "$zig_path" > /dev/null 2>&1 ||
            reject_with_reason "" "$zig_path is not zig-fmt clean;" "            run: zig fmt $zig_path"
    done < <(staged_matching '*.zig')
}

# Rejects mojo format drift; `mojo format` has no check mode, so the gate formats a copy and
# compares.
check_mojo_format_clean() {
    command -v pixi > /dev/null 2>&1 && [ -f pixi.toml ] || return 0
    local mojo_path formatted_directory formatted
    while IFS= read -r -d '' mojo_path; do
        formatted_directory=$(mktemp -d) && formatted="$formatted_directory/copy.mojo"
        cp "$mojo_path" "$formatted"
        pixi run --quiet mojo format --quiet -l 120 "$formatted" > /dev/null 2>&1
        cmp -s "$mojo_path" "$formatted" ||
            reject_with_reason "" "$mojo_path is not mojo-format clean;" "            run: pixi run mojo format -l 120 $mojo_path"
        rm -rf "$formatted_directory"
    done < <(staged_matching '*.mojo')
}

# Rejects palantir-java-format drift. Spotless needs a Gradle far newer than some distributions
# ship, so the gate calls the same formatter Spotless would, out of the Gradle cache; a formatter
# that cannot parse the file says nothing about its formatting, as 2.97.0 rejects Java 21's
# `case X x when ...` guards, so only a clean run that disagrees is a failure.
check_java_format_clean() {
    local palantir_jar palantir_exports java_path formatted
    palantir_jar=$(ls "$HOME"/.gradle/caches/modules-2/files-2.1/com.palantir.javaformat/palantir-java-format/*/*/palantir-java-format-*.jar 2> /dev/null | tail -1)
    [ -n "$palantir_jar" ] && command -v java > /dev/null 2>&1 || return 0
    palantir_exports="--add-exports jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED"
    palantir_exports="$palantir_exports --add-exports jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED"
    palantir_exports="$palantir_exports --add-exports jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED"
    palantir_exports="$palantir_exports --add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED"
    palantir_exports="$palantir_exports --add-exports jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED"
    while IFS= read -r -d '' java_path; do
        formatted=$(mktemp)
        # shellcheck disable=SC2086
        if java $palantir_exports -cp "$palantir_jar" com.palantir.javaformat.java.Main "$java_path" \
            > "$formatted" 2> /dev/null && ! cmp -s "$formatted" "$java_path"; then
            reject_with_reason "" "$java_path is not palantir-java-format clean;" "            run: gradle spotlessApply"
        fi
        rm -f "$formatted"
    done < <(staged_matching '*.java')
}

# Rejects prettier drift on the JavaScript and TypeScript sources. Markdown is deliberately absent:
# prose here is one sentence per line and never wrapped, which prettier reflows into paragraphs.
check_prettier_clean() {
    [ -x node_modules/.bin/prettier ] || return 0
    local script_path
    while IFS= read -r -d '' script_path; do
        node_modules/.bin/prettier --check "$script_path" > /dev/null 2>&1 ||
            reject_with_reason "" "$script_path is not prettier clean;" "            run: npx prettier --write $script_path"
    done < <(staged_matching '*.ts' '*.js' '*.mjs' '*.cjs')
}

# Rejects spotless drift in Kotlin and Scala, which go through the same Gradle `spotless` that
# formats Java, since all three share one build; it resolves ktfmt and scalafmt itself, so the hook
# needs no tool of its own.
check_spotless_clean() {
    command -v gradle > /dev/null 2>&1 && [ -f build.gradle ] && staged_any '*.kt' '*.scala' || return 0
    gradle --quiet --offline spotlessCheck > /dev/null 2>&1 ||
        reject_with_reason "" "Kotlin or Scala is not spotless clean;" "            run: gradle spotlessApply"
}

# Rejects `dotnet format` whitespace drift. It takes a project, so the staged files are an
# `--include` filter over the solution; whitespace only, since the analyzer passes want a restore,
# which would turn a commit hook into a build.
check_dotnet_format_clean() {
    command -v dotnet > /dev/null 2>&1 && [ -f csharp/Cloud.Unum.USearch.sln ] || return 0
    local staged_csharp="" csharp_path
    while IFS= read -r -d '' csharp_path; do staged_csharp="$staged_csharp $csharp_path"; done < <(staged_matching '*.cs')
    [ -n "$staged_csharp" ] || return 0
    # shellcheck disable=SC2086
    dotnet format whitespace csharp/Cloud.Unum.USearch.sln --verify-no-changes --no-restore \
        --include $staged_csharp > /dev/null 2>&1 ||
        reject_with_reason "" "C# is not \`dotnet format\` clean;" \
            "            run: dotnet format whitespace csharp/Cloud.Unum.USearch.sln"
}

# A `usearch_sibling` pin, a Cargo git `rev` and the submodule's gitlink name the same commit, or a
# recursive clone, a plain one and a crate build different code. Every side is read from the index,
# so the comparison is against what this commit will actually record.
check_sibling_pins_agree() {
    git diff --cached --quiet -- CMakeLists.txt Cargo.toml numkong forkunion stringzilla smashtable 2> /dev/null && return 0
    local sibling pinned source recorded
    while read -r sibling pinned source; do
        recorded=$(git ls-files --stage -- "$sibling" | "$fastest_awk" '$1 == "160000" { print $2 }')
        [ -n "$recorded" ] || continue
        [ "$recorded" = "$pinned" ] || reject_with_reason "" \
            "$sibling pin has drifted; $source says ${pinned:0:12}, the submodule records ${recorded:0:12}"
    done < <(
        git show :CMakeLists.txt 2> /dev/null | "$fastest_awk" '
        /usearch_sibling\(/ { inside = 1; record = ""; sub(/.*usearch_sibling\(/, "") }
        inside { record = record " " $0 }
        inside && /\)/ {
            sub(/\).*/, "", record)
            count = split(record, fields, /[ \t]+/)
            name = ""; pin = ""
            for (i = 1; i <= count; ++i) {
                if (fields[i] == "") continue
                if (name == "") name = fields[i]
                if (fields[i] ~ /^[0-9a-f]{40}$/) pin = fields[i]
            }
            if (name != "" && pin != "") print name, pin, "CMakeLists.txt"
            inside = 0
        }'
        git show :Cargo.toml 2> /dev/null | sed -nE \
            's|.*git = "https://github.com/[^/"]+/([^/"]+)", rev = "([0-9a-f]{40})".*|\1 \2 Cargo.toml|p' |
            "$fastest_awk" '{ print tolower($1), $2, $3 }'
    )
}

