#!/usr/bin/env bash
#
# USearch pre-commit: enforce the house style on staged changes before they land.
#
# Each check is one function named after the rule it enforces, and prints why it fired. Line checks
# read the added lines of a staged file, so legacy code migrates on its own schedule; structural
# checks read the whole staged file and report only the lines the commit added. The dispatch loop at
# the bottom diffs every staged file once and routes it by extension. `.githooks/selftest` holds one
# fixture per rule.
#
# Every region between Project Settings and USearch Rules is shared with the sibling hooks, and
# `check_shared_regions_match` pins the sums of the four that stay word for word identical. Configuring
# the CMake build arms these hooks; see the `core.hooksPath` block in CMakeLists.txt.
#
# Bypass knowingly, which you almost never should, with: git commit --no-verify

set -u

# CITATION.cff cites the concept DOI, which spans every release, so it never carries a version.
if git show :CITATION.cff 2> /dev/null | grep -q '^version:'; then
    echo "pre-commit: CITATION.cff carries no version; the concept DOI spans every release." >&2
    exit 1
fi

export LC_ALL=C # Byte-wise regexes, immune to the committer's locale
unset FORCE_COLOR CLICOLOR_FORCE # Plain tool output, since the checks parse it by its colons

rejection_count=0

# region Project Settings

# The only lines that differ between the NumKong, StringZilla, USearch, ForkUnion, SmashTable, UCall, UStore
# and UForm hooks outside their own project region: whose hook this is, which prefix its own headers sit
# under, which namespace its harnesses open, which sibling names a comment may not cite as a justification,
# which abbreviations, identifier words and member names this codebase refuses, which directories take their
# node ID width from a template parameter, which library files are standard-container baselines, and which
# prefix names its code-generation macros.
project_name="USearch"
project_namespace="unum::usearch"
project_include_prefix="usearch"
sibling_projects='numkong|stringzilla|forkunion|smashtable|ucall|ustore|uform'
abbreviations_refused="hi lo bot acc accum tmp temp res bcast ext idx cnt buf len str val obj elem iter"
# Name prefixes of third-party APIs the code calls, whose abbreviations are not this project's to spell out.
third_party_identifier_prefixes=''
identifier_words_refused="landing landed lander join seat deal pool home plane dirty met seen"
member_names_refused="bits current state data flags tmp scratch bitset buffer"
width_free_directories="include/usearch/utilities include/usearch/basic"
rustfmt_command="cargo +nightly fmt"
std_collections_baseline_paths=''
# Uppercase non-cache CMake names this project publishes, and the third-party and toolchain inputs it sets.
cmake_published_variables="USEARCH_PUNNED_LIBRARIES USEARCH_PUNNED_OBJECTS"
cmake_third_party_variables="YYJSON_INSTALL THREADS_PREFER_PTHREAD_FLAG WASI_SDK_PATH WASI_SDK_PREFIX EMSCRIPTEN_SYSTEM_PROCESSOR \
    CPACK_ARCHIVE_COMPONENT_INSTALL CPACK_COMPONENT_INCLUDE_TOPLEVEL_DIRECTORY CPACK_COMPONENTS_ALL CPACK_GENERATOR \
    CPACK_PACKAGE_NAME CPACK_STRIP_FILES"
# The approved code-generation macro families are .clang-format's `StatementMacros`, from the staged copy so a
# commit approving a family carries it, else from the copy beside this hook, as the selftest's fixtures have none.
approved_codegen_macros=$({ git show :.clang-format 2>/dev/null || cat "$(dirname "$0")/../.clang-format"; } |
    awk '/^StatementMacros:/ { listed = 1; next } /^[^ ]/ { listed = 0 } listed { sub(/^ *- */, ""); print }')
codegen_macro_prefix=''
# Its macro prefix, the headers that alone read the compiler's platform predefines, and the predefines beyond
# the operating systems and compilers that its identity also answers.
macro_prefix="USEARCH"
identity_headers="c/usearch/types.h"
platform_predefines_refused=''

# endregion Project Settings

# region Shared Helpers

# mawk runs these programs fastest, then gawk; each program keeps to what gawk, mawk and BWK awk accept.
fastest_awk=$(command -v mawk || command -v gawk || echo awk)

# Prints the reason and the first offending lines. Counts rather than latches, because the selftest
# asserts that a bad fixture trips exactly one rule.
reject_with_reason() { # reject_with_reason <matches> <message-line>...
    local matches=$1
    shift
    local message_line
    for message_line in "$@"; do echo "pre-commit: $message_line"; done
    printf '%s\n' "$matches" | head -5
    rejection_count=$((rejection_count + 1))
}

# Line classes over `staged_added_text`, whose lines keep the diff's leading `+`: any comment marker, a
# documentation line that is `/**`, a docblock body line or `//`, and a docblock line alone.
added_comment_line_pattern='^\+[[:space:]]*(\*|/\*|//)'
added_documentation_line_pattern='^\+[[:space:]]*(/\*\*|\*([[:space:]]|$)|//)'
added_docblock_line_pattern='^\+[[:space:]]*(/\*\*|\*([[:space:]]|$))'
# Matches added text with a comment marker anywhere, which every rule behind it needs before it can fire.
added_comment_marker_regex=$'(^|\n)\\+[[:space:]]*\\*|//|/\\*'

# Predicates over one source line, available to every program `scan_staged_file_marking_added_lines` runs.
comment_structure_awk='
    function is_docblock_opener(line) { return line ~ /^[[:space:]]*\/\*\*/ }
    function is_comment_closer(line) { return line ~ /\*\/[[:space:]]*$/ }
    function is_empty_comment_line(line) { return line ~ /^[[:space:]]*\*[[:space:]]*$/ }
    function without_code_spans(text,    start, length_) {
        gsub(/`[^`]*`/, "C", text)
        gsub(/<\/tt>/, "\001", text); gsub(/<tt>[^\001]*\001/, "C", text)
        while ((start = index(text, "<code")) && (length_ = index(substr(text, start), "</code>")))
            text = substr(text, 1, start - 1) "C" substr(text, start + length_ + 6)
        return text
    }
'

# Buffers one comment paragraph and, at its end, reports each line that breaks mid-sentence while the next
# word would still fit under the paragraph's own measure: its widest other line, capped at 100. The caller
# defines `characters(text)`.
paragraph_room_awk='
    function first_word(text,    end_) {
        if (match(text, /^@(a|b|c|e|p|ref)[[:space:]]+[^[:space:]]+/)) return substr(text, 1, RLENGTH)
        if (text ~ /^`[^`]*`/) { match(text, /^`[^`]*`[^[:space:]]*/); return substr(text, 1, RLENGTH) }
        if (text ~ /^<tt>/ && (end_ = index(text, "</tt>"))) { match(substr(text, end_ + 5), /^[^[:space:]]*/); return substr(text, 1, end_ + 4 + RLENGTH) }
        sub(/[[:space:]].*$/, "", text); return text
    }
    function hold_paragraph_line(line, body, width) { ++held; held_line[held] = line; held_body[held] = body; held_width[held] = width }
    function report_paragraph_room(    index_, other, measure, word) {
        for (index_ = 1; index_ < held; ++index_) {
            if (held_body[index_] ~ /[.:;!?][])"`\047]*$/) continue
            if (!((held_line[index_] in added) || (held_line[index_ + 1] in added))) continue
            measure = 0
            for (other = 1; other <= held; ++other) if (other != index_ && held_width[other] > measure) measure = held_width[other]
            if (measure > 100) measure = 100
            word = first_word(held_body[index_ + 1])
            if (held_width[index_] + 1 + characters(word) <= measure) printf "line %d: room for `%s` from the next line\n", held_line[index_], word
        }
        held = 0
    }
'

# Runs an awk program over the staged file with `added[line]` preloaded, so a structural check sees the
# whole file as context and still reports only what this commit added; code checks use the comment-free copy.
scan_staged_file_marking_added_lines() { # scan_staged_file_marking_added_lines <awk-program> [source]
    "$fastest_awk" "$comment_structure_awk"'FILENAME == ARGV[1] { added[$1 + 0]; next } '"$1" "$staged_lines_path" "${2:-$staged_text_path}"
}

# Blanks C-family comments to spaces, keeping every line and column in place, so a code check never fires
# on a comment that merely names the construct it bans. String, character and raw string literals pass
# through; with `literals`, their contents blank instead and comments pass through, so prose checks skip data.
blank_c_comments_preserving_columns() { # blank_c_comments_preserving_columns [literals] < source
    "$fastest_awk" -v blanked="${1:-comments}" '
        function emit(span, kind) { if (kind == blanked) gsub(/./, " ", span); output = output span }
        {
            output = ""
            for (position = 1; position <= length($0); ++position) {
                character = substr($0, position, 1)
                pair = substr($0, position, 2)
                if (state == "raw") {
                    if (!(closing = index(substr($0, position), closer))) { emit(substr($0, position), "literals"); break }
                    emit(substr($0, position, closing - 1), "literals"); output = output closer
                    position += closing + length(closer) - 2; state = ""
                    continue
                }
                if (state == "block") {
                    if (!(closing = index(substr($0, position), "*/"))) { emit(substr($0, position), "comments"); break }
                    emit(substr($0, position, closing + 1), "comments"); position += closing; state = ""
                    continue
                }
                if (state == "string" || state == "character") {
                    if (character == "\\") { emit(substr($0, position, 2), "literals"); ++position }
                    else if ((state == "string" && character == "\"") || (state == "character" && character == "\047")) { state = ""; output = output character }
                    else emit(character, "literals")
                    continue
                }
                if (pair == "//") { emit(substr($0, position), "comments"); break }
                if (pair == "/*") { state = "block"; emit(pair, "comments"); ++position; continue }
                if (character == "\"" && substr($0, 1, position - 1) ~ /(^|[^A-Za-z0-9_])(u8|[uUL])?R$/ &&
                    match(substr($0, position + 1), /^[^()\\[:space:]]*\(/)) {
                    closer = ")" substr($0, position + 1, RLENGTH - 1) "\""
                    output = output substr($0, position, RLENGTH + 1); position += RLENGTH; state = "raw"
                    continue
                }
                if (character == "\"") state = "string"
                else if (character == "\047") state = "character"
                output = output character
            }
            if (state != "block" && state != "raw") state = ""
            print output
        }'
}

# Prints the line numbers of the staged file that sit outside every function body, because whole-file
# mode judges the documentation around code, not the working notes inside it.
lines_outside_function_bodies() {
    case "$staged_path" in
    *.h | *.hpp | *.c | *.cpp | *.cc | *.cu | *.cuh | *.hip | *.metal | *.pml | *.rs | *.go | *.swift | *.ts | *.mts | *.js | *.mjs | *.cjs)
        printf '%s\n' "$staged_file_text" | blank_c_comments_preserving_columns | "$fastest_awk" '
            {
                text = $0
                gsub(/"(\\.|[^"\\])*"/, "\"\"", text); gsub(/\047(\\.|[^\047\\])\047/, "\047\047", text)
                inside_at_start = (body_depth > 0)
                if (directive_continues || text ~ /^[[:space:]]*#/) {
                    directive_continues = (text ~ /\\[[:space:]]*$/)
                    if (!inside_at_start) print NR
                    next
                }
                for (position = 1; position <= length(text); ++position) {
                    character = substr(text, position, 1)
                    if (character == "{") {
                        tail = header; sub(/^.*\)/, "", tail)
                        if (body_depth > 0) kind = "body"
                        else if (header ~ /(^|[^A-Za-z0-9_])(namespace|extern)([^A-Za-z0-9_]|$)/ && header !~ /\(/) kind = "container"
                        else if (header ~ /(^|[^A-Za-z0-9_])(struct|class|union|enum)([^A-Za-z0-9_]|$)/ && header !~ /\)[[:space:]A-Za-z&]*$/) kind = "container"
                        else if (header ~ /\)/ && tail !~ /=/) kind = "body"
                        else kind = "other"
                        kinds[++depth] = kind; if (kind == "body") ++body_depth
                        header = ""
                    } else if (character == "}") {
                        if (depth > 0) { if (kinds[depth] == "body") --body_depth; --depth }
                        header = ""
                    } else if (character == ";") header = ""
                    else header = header character
                }
                header = header " "
                if (!(inside_at_start && body_depth > 0)) print NR
            }'
        ;;
    *.py | *.pyi)
        printf '%s\n' "$staged_file_text" | "$fastest_awk" '
            {
                indent = match($0, /[^[:space:]]/) - 1; blank = (indent < 0)
                if (!blank && !awaiting_colon) while (open_defs > 0 && indent <= def_indent[open_defs]) --open_defs
                inside = (open_defs > 0 && !awaiting_colon && (blank || indent > def_indent[open_defs]))
                if (awaiting_colon) { if ($0 ~ /:[[:space:]]*(#.*)?$/) { def_indent[++open_defs] = awaiting_indent; awaiting_colon = 0 } print NR; next }
                if ($0 ~ /^[[:space:]]*(async[[:space:]]+)?def[[:space:]]/) {
                    inside = 0; awaiting_indent = indent
                    if ($0 ~ /:[[:space:]]*(#.*)?$/) def_indent[++open_defs] = indent; else awaiting_colon = 1
                }
                if (!inside) print NR
            }'
        ;;
    *) printf '%s\n' "$staged_file_text" | "$fastest_awk" '{ print NR }' ;;
    esac
}

# endregion Shared Helpers

# region Doxygen Blocks

# Rejects a `@param` without an `[in]`, `[out]` or `[in,out]` direction, because the direction tells a reader
# whether the callee reads, writes, or mutates the argument.
check_param_has_direction() {
    local undirected
    undirected=$(printf '%s\n' "$staged_added_text" | grep -E '@param' | grep -vE '@param\[(in|out|in,out)\]' || true)
    [ -z "$undirected" ] || reject_with_reason "$undirected" \
        "$staged_path has a @param without an [in], [out] or [in,out] direction;" \
        "            write @param[in,out] for a mutated argument, never @param[inout]:"
}

# Rejects Markdown `__bold__` and `**bold**` in comments, because Doxygen prints them literally; C
# `__keyword__` spellings are exempt.
check_markdown_emphasis_absent_in_comments() {
    local emphasis
    emphasis=$(printf '%s\n' "$staged_added_text" | grep -E "$added_documentation_line_pattern" |
        sed -E 's,^\+[[:space:]]*(/\*\*|\*|//),,; s,\*/[[:space:]]*$,,' | grep -oE '\*\*[^*]+\*\*|__[A-Za-z0-9]([A-Za-z0-9 ,.-]*[A-Za-z0-9.])?__' |
        grep -vE '^__(restrict|inline|volatile|asm|attribute|builtin[A-Za-z0-9_]*|STDC)__$' |
        grep -vE '^__[a-z][a-z0-9_]*__$|^__[A-Z][A-Z0-9_]*__$' || true)
    [ -z "$emphasis" ] || reject_with_reason "$emphasis" \
        "$staged_path uses Markdown emphasis in a comment, which Doxygen prints literally;" \
        "            use @b for a 1-2 token emphasis, plain prose otherwise:"
}

# Rejects a Doxygen command glued to the previous character, as in `(@c foo)`, because a highlighter only
# sees a command that follows whitespace.
check_doxygen_command_not_glued() {
    local glued
    glued=$(printf '%s\n' "$staged_added_text" | grep -E "$added_documentation_line_pattern" |
        grep -E '[^[:space:]]@(brief|section|subsection|param|tparam|returns?|ref|sa|see|note|file|date|author|c|p|b)\b' || true)
    [ -z "$glued" ] || reject_with_reason "$glued" \
        "$staged_path glues a Doxygen command to the previous character;" \
        "            write \`as @c foo does\`, never \`(@c foo)\`:"
}

# Rejects Doxygen text aligned into columns by hand, as in `@brief  Text` or `@param[in] a     Text`, because
# such columns drift with the first edit; `check_tag_continuation_hanging_indent` covers continuation lines.
check_doxygen_columns_unaligned() {
    local aligned
    aligned=$(printf '%s\n' "$staged_added_text" | grep -E "$added_documentation_line_pattern" | grep -E \
        '@(brief|param|tparam|returns?|retval|note|warning|details|pre|post|sa|see|ref|c|p|b)(\[[a-z,]+\])?  +[^[:space:]]|@(t?param(\[[a-z,]+\])?|retval) +[A-Za-z_][A-Za-z0-9_.]*  +[^[:space:]]' ||
        true)
    [ -z "$aligned" ] || reject_with_reason "$aligned" \
        "$staged_path aligns Doxygen text into columns by hand;" \
        "            put one space after a command and after the name it documents:"
}

# Rejects `@sa` pointing at a URL and `@see` without one, because Doxygen treats the two alike and only this
# check keeps them scannable: `@sa` names an identifier, `@see` a URL, optionally after a title.
check_sa_names_identifiers_see_names_urls() {
    local mixed
    mixed=$(printf '%s\n' "$staged_added_text" | grep -E '@sa[[:space:]].*https?://|@see[[:space:]]' |
        grep -vE '@see[[:space:]].*https?://' || true)
    [ -z "$mixed" ] || reject_with_reason "$mixed" \
        "$staged_path mixes the cross-reference tags; @sa names an identifier, @see names a URL:"
}

# Rejects `@sa` or `@see` in the middle of a line, because both are block commands that start a paragraph;
# inline, a name reads as plain text or `@ref name`.
check_cross_references_start_their_line() {
    local inline
    inline=$(printf '%s\n' "$staged_added_text" | grep -E '^\+[[:space:]]*(\*|/\*\*)[[:space:]].*[^[:space:]*/][[:space:]]+@(sa|see)[[:space:]]' || true)
    [ -z "$inline" ] || reject_with_reason "$inline" \
        "$staged_path writes @sa or @see mid-line; start its own line, or name the symbol inline with @ref:"
}

# Rejects an equation whose terms each carry `@c`, because an equation reads as plain Unicode prose, and
# `@c` belongs to a name standing alone in a sentence; `@p` still marks a parameter inside a formula.
check_formula_terms_unmarked() {
    local marked_terms
    marked_terms=$(printf '%s\n' "$staged_added_text" | grep -E "$added_docblock_line_pattern" |
        grep -E '@c[[:space:]]+[^[:space:]]+[[:space:]]+(=|\+|-|\*|<|>|≤|≥|×|·)[[:space:]]*[^[:space:]]*[[:space:]]*@c[[:space:]]' || true)
    [ -z "$marked_terms" ] || reject_with_reason "$marked_terms" \
        "$staged_path marks the terms of an equation one by one; write it as plain Unicode prose," \
        "            as in size = 1 + size(left) + size(right):"
}

# Rejects `@section` without a `domain_topic` anchor and a title, because Doxygen binds the first token as the
# anchor, and anchors share one namespace across the project; a bare `references` or `u8` collides.
check_section_has_snake_case_identifier() {
    local sections
    sections=$(printf '%s\n' "$staged_added_text" | grep -E '@(section|subsection|subsubsection|page)[[:space:]]' |
        grep -vE '@(section|subsection|subsubsection|page)[[:space:]]+[a-z][a-z0-9]*(_[a-z0-9]+)+[[:space:]]+[^[:space:]]' || true)
    [ -z "$sections" ] || reject_with_reason "$sections" \
        "$staged_path adds a Doxygen section without a domain_topic anchor and a title;" \
        "            write @section dots_packing Packing Format, naming the file's domain first:"
}

# Rejects an `@section` anchor that another staged C-family file already uses, because Doxygen resolves
# every anchor project-wide and silently links a duplicate to whichever it met first.
check_section_anchor_unique() {
    local anchor duplicated=""
    for anchor in $(printf '%s\n' "$staged_added_text" |
        grep -oE '@(section|subsection|subsubsection|page)[[:space:]]+[a-z][a-z0-9_]*' | "$fastest_awk" '{print $2}'); do
        [ "$(git grep --cached -hoE "@(section|subsection|subsubsection|page)[[:space:]]+$anchor([[:space:]]|$)" -- \
            '*.c' '*.h' '*.hpp' '*.cpp' '*.cc' '*.cu' '*.cuh' '*.hip' '*.metal' | wc -l)" -gt 1 ] && duplicated="$duplicated$anchor"$'\n'
    done
    [ -z "$duplicated" ] || reject_with_reason "$duplicated" \
        "$staged_path reuses a Doxygen section anchor another file already defines; prefix it with this file's" \
        "            domain, as in dots_haswell_instructions:"
}

# Rejects `//<`, `///`, `//!<`, `/*<`, `/**<` and `/*!<` trailing code, because no editor shows them on
# hover and the column drifts on every rename; a member gets its own `/** ... */` above it, or the
# type's docblock explains all.
check_member_docs_not_trailing() {
    local trailing
    trailing=$(printf '%s\n' "$staged_added_text" | grep -vE '^\+[[:space:]]*(\*([[:space:]]|$)|/\*|//)' |
        grep -E '(//[/!]?<|///|/\*[*!]?<)' || true)
    [ -z "$trailing" ] || reject_with_reason "$trailing" \
        "$staged_path documents a member with a trailing marker;" \
        "            put a /** ... */ above the member, or fold the explanation into the type's docblock:"
}

# Rejects a plain `//` or `/* */` comment trailing a field or enumerator, because hover shows only a
# comment above the declaration; inside a struct, union or enum body, each gets its own `/** ... */`.
# Type alias tables keep their aligned trailing comments.
check_member_comments_above() {
    local trailing
    trailing=$(scan_staged_file_marking_added_lines '
        depth == 0 && /^[[:space:]]*(typedef[[:space:]]+)?(struct|union|enum)([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?([[:space:]]*:[^{;(]*)?[[:space:]]*\{[[:space:]]*$/ {
            depth = 1; next
        }
        depth > 0 {
            code = $0
            gsub(/"([^"\\]|\\.)*"/, "\"\"", code)
            depth += gsub(/\{/, "{", code) - gsub(/\}/, "}", code)
            if (depth <= 0) { depth = 0; next }
            if (code ~ /\\[[:space:]]*$/ || code ~ /^[[:space:]]*(\/\/|\/\*|\*|using[[:space:]])/) next
            if ((FNR in added) && code ~ /[]A-Za-z0-9_);,][[:space:]]*(\/\/([^\/!]|$)|\/\*[^*])/) print "+" $0
        }' || true)
    [ -z "$trailing" ] || reject_with_reason "$trailing" \
        "$staged_path comments a field or enumerator on its own line's tail, which hover never shows;" \
        "            put a /** ... */ above it, or fold the explanation into the type's docblock:"
}

# Rejects indexing through a cast, `((T *)pointer)[index]`, because the element type and the offset hide inside
# one expression; name a typed pointer first and index that.
check_no_cast_indexing() {
    local chains
    chains=$(scan_staged_file_marking_added_lines '
        (FNR in added) && /\(\([[:space:]]*[A-Za-z_][A-Za-z0-9_ ]*\*+[[:space:]]*\)[^()]*(\([^()]*\))?[^()]*\)[[:space:]]*\[/ {
            print "line " FNR ": " $0
        }' "$staged_code_path")
    [ -z "$chains" ] || reject_with_reason "$chains" \
        "$staged_path indexes through a cast;" \
        "            bind a typed pointer to a named local and index it:"
}

# Rejects an added `#define <codegen_macro_prefix><name>(` missing from .clang-format's `StatementMacros`,
# because every new code-generation macro family goes through review, and the list in the same commit shows it.
check_codegen_macros_are_approved() {
    [ -n "$codegen_macro_prefix" ] || return 0
    case "$staged_path" in c/* | cpp/* | include/*) ;; *) return 0 ;; esac
    local macro_name unapproved=""
    for macro_name in $(printf '%s\n' "$staged_added_text" |
        grep -oE "^\+[[:space:]]*#[[:space:]]*define[[:space:]]+$codegen_macro_prefix[A-Za-z0-9_]+\(" |
        grep -oE "$codegen_macro_prefix[A-Za-z0-9_]+"); do
        case " $approved_codegen_macros " in *[[:space:]]"$macro_name"[[:space:]]*) ;; *) unapproved="$unapproved$macro_name"$'\n' ;; esac
    done
    [ -z "$unapproved" ] || reject_with_reason "$unapproved" \
        "$staged_path defines a code-generation macro family nobody approved;" \
        "            a new one needs Ash's approval, so list it in .clang-format's StatementMacros in the same commit:"
}

# Rejects a tensor shape spelled `[rows x cols]`, `[rows × cols]`, or backticked `rows × cols`, because a
# shape is `@b [rows,columns]`: bold, bracketed, comma-separated, and space-free.
check_shape_spelled_bold_bracketed() {
    local shapes
    shapes=$(printf '%s\n' "$staged_added_text" | grep -E "$added_documentation_line_pattern" |
        grep -E '\[[A-Za-z_|]+ (x|×) [A-Za-z_|]+( (x|×) [A-Za-z_|]+)*\]|\[[A-Za-z_|]+×[A-Za-z_|]+(×[A-Za-z_|]+)*\]|`[A-Za-z_]+ ?× ?[A-Za-z_]+( ?× ?[A-Za-z_]+)*`' || true)
    [ -z "$shapes" ] || reject_with_reason "$shapes" \
        "$staged_path spells a shape with x or ×; write @b [rows,columns]:"
}

# Rejects a tuple of names spelled in backticks, with @c, or with spaces after @b, because a tuple reads
# like a shape: @b (start,stop,limit) beside @b [rows,columns], one token so the command binds all of it.
check_tuple_spelled_bold_parenthesized() {
    local tuples
    tuples=$(printf '%s\n' "$staged_added_text" | grep -E "$added_documentation_line_pattern" |
        grep -E '(`|@c[[:space:]]+)\([A-Za-z_][A-Za-z0-9_]*(, ?[A-Za-z_][A-Za-z0-9_]*)+\)|`\([a-z_][a-z0-9_]*\)`|@c[[:space:]]+\([a-z_][a-z0-9_]*\)|@b[[:space:]]+\([A-Za-z_][A-Za-z0-9_]*, ' || true)
    [ -z "$tuples" ] || reject_with_reason "$tuples" \
        "$staged_path spells a tuple of names apart from a shape; write @b (start,stop,limit) with no spaces:"
}

# Rejects @c or @p before a call whose arguments hold a space, because the command binds one token and
# stops at the space; a call with arguments is a <tt> span, and a formula is plain Unicode prose.
check_call_not_marked() {
    local calls
    calls=$(printf '%s\n' "$staged_added_text" | grep -E "$added_documentation_line_pattern" |
        grep -E '@[cp][[:space:]]+[A-Za-z_][A-Za-z0-9_:.]*\([^)`[:space:]]*[[:space:]]' || true)
    [ -z "$calls" ] || reject_with_reason "$calls" \
        "$staged_path marks a call with arguments, but the command binds one token; write <tt>insert(first, last)</tt>:"
}

# Rejects a math operator glued to an operand, as in Δ×weight(right) or P×V, because prose spaces every
# binary operator. Numeric dimensions such as 16×16, factors such as 4× faster, a unary ≈128, and the
# one-token @b shapes stay tight.
check_math_operators_spaced() {
    local glued
    glued=$(scan_staged_file_marking_added_lines '
        function check_glued(prose, line) {
            gsub(/\047[^\047[:space:]]{1,4}\047/, "Q", prose)
            if (prose ~ /[^[:space:]0-9(](×|·|÷|≤|≥|≠|≈)/ || prose ~ /[0-9](×|·|÷|≤|≥|≠|≈)[^[:space:]0-9,.;:)]/ ||
                prose ~ /[[:space:](](×|·|÷|≠)[^[:space:]]/ || prose ~ /[[:space:](](≤|≥|≈)[^[:space:]0-9]/)
                printf "line %d: %s\n", FNR, line
        }
        /^[[:space:]]*\/\*/ { inside = 1 }
        inside && /@(code|verbatim)/ { in_code = 1 }
        !inside && !/^[[:space:]]*\/\// && index($0, " // ") && (FNR in added) {
            trailing = substr($0, index($0, " // ") + 4); before = substr($0, 1, index($0, " // "))
            if (gsub(/"/, "\"", before) % 2 == 0) { prose = trailing; gsub(/`[^`]*`/, "C", prose); check_glued(prose, $0) }
        }
        (inside && !in_code || /^[[:space:]]*\/\//) && (FNR in added) {
            prose = without_code_spans($0); gsub(/@b[[:space:]]+[^[:space:]]+/, "B", prose)
            check_glued(prose, $0)
        }
        inside && /@end(code|verbatim)/ { in_code = 0 }
        /\*\// { inside = 0; in_code = 0 }')
    [ -z "$glued" ] || reject_with_reason "$glued" \
        "$staged_path glues a math operator to its operands; space it, as in P × V or Δ × weight(right):"
}

# Rejects @par other than `@par Statuses:`, because the sibling projects never title a paragraph: a
# precondition is @pre, and a complexity bound, an algorithm, or an example is a body paragraph whose
# first sentence names it. The one titled paragraph is the list of statuses a fallible function produces.
check_par_absent() {
    local titled
    titled=$(printf '%s\n' "$staged_added_text" | grep -E "$added_documentation_line_pattern" | grep -E '@par([[:space:]]|$)' | grep -vE '@par Statuses:[[:space:]]*$' || true)
    [ -z "$titled" ] || reject_with_reason "$titled" \
        "$staged_path titles a paragraph with @par; write @pre for a precondition, prose for the rest," \
        "            and keep @par for a \`@par Statuses:\` list:"
}

# Rejects a run of trailing // comments inside a @code sample that start at different columns, because
# clang-format never reaches a sample, so its comments drift apart unless kept in one column by hand.
check_code_sample_comments_aligned() {
    local ragged
    ragged=$(scan_staged_file_marking_added_lines '
        function report() { if (run > 1 && ragged && touched) printf "line %d: trailing comments start at different columns\n", first; run = 0; ragged = 0; touched = 0 }
        /@code/ { in_code = 1; report(); next }
        /@endcode/ { in_code = 0; report(); next }
        in_code && /^[[:space:]]*\*[[:space:]]+[^[:space:]\/]/ && index($0, " //") {
            column = index($0, " //")
            if (!run) { first = FNR; expected = column } else if (column != expected) ragged = 1
            ++run; if (FNR in added) touched = 1; next
        }
        { report() }')
    [ -z "$ragged" ] || reject_with_reason "$ragged" \
        "$staged_path lets the trailing comments of a @code sample drift; start them in one column:"
}

# Rejects a formula inside backticks, in TeX `$…$`, or in MathJax `@f$`, because backticks mean code and TeX
# renders only in Doxygen HTML; formulas are plain Unicode prose.
check_formula_not_in_backticks() {
    local formulas
    formulas=$(printf '%s\n' "$staged_added_text" | grep -E "$added_documentation_line_pattern" |
        grep -E '`[^`]*(√|Σ|·|×|²|⟨|‖|ᵢ|ⱼ|ₖ|ᵀ|[^[:space:]^]\^([0-9(]|T[^A-Za-z0-9_])|sqrt\(|\|\|[^|`]+\|\|)[^`]*`|`\[[^]`]*\*[^]`]*\]`|[@\\]f[$[]|\$[A-Za-z(][^$`<]*\$' || true)
    [ -z "$formulas" ] || reject_with_reason "$formulas" \
        "$staged_path puts a formula in backticks or MathJax; write it as plain Unicode prose, as in aᵀ × M × b," \
        "            or as a @verbatim block when it needs more than one line:"
}

# Rejects TeX inside a Markdown code span, like `4 \cdot h` or `n_{kv}`, because a code span renders its
# backslashes and braces literally, while TeX between $ signs renders as math on GitHub.
check_markdown_tex_not_in_code_spans() {
    local spans
    spans=$(scan_staged_file_marking_added_lines '
        /^[[:space:]]*```/ { fenced = !fenced; next }
        fenced || !(FNR in added) { next }
        {
            line = $0
            while (match(line, /`[^`]+`/)) {
                span = substr(line, RSTART, RLENGTH); line = substr(line, RSTART + RLENGTH)
                if (span ~ /\\(cdot|times|frac|sum|prod|sqrt|log|ln|exp|text|mathrm|mathbf|left|right|leq?|geq?|neq?|approx|infty|varepsilon|epsilon|alpha|beta|gamma|delta|sigma|lambda|theta|top|circ|bar|hat|ldots|cdots|lfloor|rfloor|lceil|rceil)([^A-Za-z]|$)/ ||
                    span ~ /(^|[^A-Za-z0-9_])[A-Za-z][_^]\{/) {
                    printf "line %d: %s\n", FNR, span
                    break
                }
            }
        }')
    [ -z "$spans" ] || reject_with_reason "$spans" \
        "$staged_path puts TeX inside a Markdown code span, which renders it literally; write it between \$ signs:"
}

# Rejects a `/**` with no empty line above it, because a docblock reads as the start of something only with
# air above it. A lone `/** @copydoc ... */` line may stack, and an access specifier is exempt, since
# clang-format strips the blank line after it.
check_docblock_preceded_by_blank_line() {
    local cramped
    cramped=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 2; line <= last; ++line)
                if (is_docblock_opener(lines[line]) && (line in added) &&
                    lines[line] !~ /^[[:space:]]*\/\*\* @copydoc [^[:space:]]+ \*\/[[:space:]]*$/ &&
                    lines[line - 1] !~ /^[[:space:]]*$/ &&
                    lines[line - 1] !~ /^[[:space:]]*(public|private|protected):[[:space:]]*$/)
                    printf "line %d: no empty line above the docblock\n", line
        }')
    [ -z "$cramped" ] || reject_with_reason "$cramped" \
        "$staged_path opens a docblock against the line above; every /** takes an empty line above it," \
        "            an opening brace included:"
}

# Rejects a docblock that does not sit directly above the one declaration it documents: one followed by an
# empty line, a closing brace, another docblock, a `#pragma` or `#include`, an explicit instantiation, a
# `static_assert`, or a namespace opener. A note over a group of declarations is a plain `/*  */` block.
check_docblock_documents_a_declaration() {
    local misplaced
    misplaced=$(scan_staged_file_marking_added_lines '
        function names_no_single_declaration(line) {
            return line ~ /^[[:space:]]*$/ || line ~ /^[[:space:]]*\}/ || is_docblock_opener(line) ||
                   line ~ /^[[:space:]]*#[[:space:]]*(pragma|include)/ ||
                   line ~ /^[[:space:]]*(extern[[:space:]]+)?template[[:space:]]+(class|struct)[[:space:]]/ ||
                   line ~ /^[[:space:]]*static_assert[[:space:]]*\(/ ||
                   line ~ /^[[:space:]]*(inline[[:space:]]+)?namespace([[:space:]]+[A-Za-z_:]*)?[[:space:]]*\{/
        }
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) {
                if (!is_docblock_opener(lines[line])) continue
                touched = 0; is_file_header = 0
                for (closing = line; closing <= last; ++closing) {
                    if (closing in added) touched = 1
                    if (lines[closing] ~ /@file/) is_file_header = 1
                    if (lines[closing] ~ /\*\//) break
                }
                following = lines[closing + 1]
                if ((closing + 1) in added) touched = 1
                if (touched && !is_file_header && names_no_single_declaration(following))
                    printf "line %d: docblock above `%s`\n", line, following
                line = closing
            }
        }')
    [ -z "$misplaced" ] || reject_with_reason "$misplaced" \
        "$staged_path puts a docblock where it documents no single declaration; move it onto the one it" \
        "            describes, or make a group note a plain /*  */ block:"
}

# Rejects a file whose header docblock does not open with @file, @author, @date and @brief, contiguous and
# in that order, or whose @file is not its own repo-relative path. The brief comes last so it may hang.
check_file_header_tag_order() {
    local header
    header=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) if (is_docblock_opener(lines[line])) break
            if (line > last) { print "line 1: no header docblock"; exit }
            split("file author date brief", order, " ")
            seen = 0; blank = 0
            for (tagged = line; tagged <= last; ++tagged) {
                if (is_empty_comment_line(lines[tagged])) blank = 1
                if (match(lines[tagged], /@(file|author|date|brief)([^a-z]|$)/)) {
                    tag = substr(lines[tagged], RSTART + 1, RLENGTH - 1); sub(/[^a-z]$/, "", tag)
                    if (tag == "file") {
                        named = lines[tagged]; sub(/^.*@file[[:space:]]*/, "", named); sub(/[[:space:]]+$/, "", named)
                        if (named != "'"$staged_path"'") printf "line %d: @file names %s, not %s\n", tagged, named, "'"$staged_path"'"
                    }
                    ++seen
                    if (seen <= 4 && tag != order[seen]) printf "line %d: @%s where @%s belongs\n", tagged, tag, order[seen]
                    if (blank) printf "line %d: @%s sits below a blank line, outside the tag block\n", tagged, tag
                }
                if (lines[tagged] ~ /\*\//) break
            }
            if (seen < 4) printf "line %d: the header names only %d of @file, @author, @date, @brief\n", line, seen
        }')
    [ -z "$header" ] || reject_with_reason "$header" \
        "$staged_path misorders its file header; write @file, @author, @date, then @brief," \
        "            contiguously, with any prose below them:"
}

# Rejects a `@brief` on a docblock with nothing below it to separate from, because on a lone paragraph the
# tag is noise. `@c`, `@p`, `@b` and `@ref` are inline markup and open nothing.
check_brief_absent_on_lone_paragraph() {
    local lone
    lone=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) {
                if (!is_docblock_opener(lines[line])) continue
                brief = 0; section = 0; blank = 0; touched = 0
                for (closing = line; closing <= last; ++closing) {
                    if (closing in added) touched = 1
                    if (lines[closing] ~ /@brief/) brief = 1
                    if (lines[closing] ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(param|tparam|return|returns|retval|par|sa|see|note|warning|throws|pre|post|file|author|date|section|code)([^a-z]|$)/) section = 1
                    if (is_empty_comment_line(lines[closing])) blank = 1
                    if (lines[closing] ~ /\*\//) break
                }
                if (brief && touched && !section && !blank) printf "line %d: @brief with nothing to separate it from\n", line
                line = closing
            }
        }')
    [ -z "$lone" ] || reject_with_reason "$lone" \
        "$staged_path tags a one-paragraph docblock with @brief; drop the tag, it earns its place" \
        "            only above a body paragraph or a tag section:"
}

# Rejects a docblock that opens with a prose summary and follows it with a body or a tag section but no
# `@brief`, because the tag is what separates the summary from what follows.
check_brief_required_before_section() {
    local missing
    missing=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) {
                if (!is_docblock_opener(lines[line])) continue
                brief = 0; header = 0; section = 0; blank = 0; touched = 0; first = ""
                for (closing = line; closing <= last; ++closing) {
                    if (closing in added) touched = 1
                    text = lines[closing]
                    if (text ~ /@brief/) brief = 1
                    if (text ~ /@file/) header = 1
                    if (text ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(param|tparam|return|returns|retval|par|sa|see|note|warning|throws|pre|post)([^a-z]|$)/) section = 1
                    if (closing > line && is_empty_comment_line(text) && first != "") blank = 1
                    if (first == "") {
                        sub(/^[[:space:]]*(\/\*\*|\*)[[:space:]]*/, "", text); sub(/[[:space:]]*\*\/.*$/, "", text)
                        if (text != "") first = text
                    }
                    if (lines[closing] ~ /\*\//) break
                }
                if (touched && !brief && !header && first != "" && first !~ /^@/ && (section || blank))
                    printf "line %d: a summary and a section, but no @brief\n", line
                line = closing
            }
        }')
    [ -z "$missing" ] || reject_with_reason "$missing" \
        "$staged_path has a docblock whose summary sits above a section with no @brief;" \
        "            the tag is what separates the two:"
}

# Rejects a tag entry running past three lines - `@brief`, `@param`, `@return`, `@note`, `@warning` and the rest -
# because an entry stays short and anything longer moves into an unindented body paragraph below the tags.
check_tag_entries_span_at_most_three_lines() {
    local sprawling
    sprawling=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) {
                if (lines[line] !~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(brief|param|tparam|return|returns|retval|note|warning|sa|see|throws|pre|post)([^a-z]|$)/ || lines[line] ~ /\*\//) continue
                tag = lines[line]; sub(/^[^@]*@/, "", tag); sub(/[^a-z].*$/, "", tag)
                span = 1
                for (continued = line + 1; continued <= last; ++continued) {
                    if (is_empty_comment_line(lines[continued]) || lines[continued] ~ /\*\//) break
                    if (lines[continued] ~ /^[[:space:]]*\*[[:space:]]*@/) break
                    ++span
                }
                if (span > 3 && (line in added)) printf "line %d: @%s runs %d lines\n", line, tag, span
            }
        }')
    [ -z "$sprawling" ] || reject_with_reason "$sprawling" \
        "$staged_path lets a tag entry run past three lines; keep it short and move the rest into an" \
        "            unindented body paragraph below the tags:"
}

# Rejects a tag continuation not hanging exactly 4 past its `@`, and a bullet or numbered-item continuation
# not aligned under the item text, because anything else reads as a new paragraph or as ragged alignment.
check_tag_continuation_hanging_indent() {
    local ragged
    ragged=$(scan_staged_file_marking_added_lines '
        {
            text = $0
            if (is_docblock_opener(text)) { inside = 1; anchor = 0; in_code = 0 }
            if (!inside) next
            if (text ~ /@(code|verbatim)/) { in_code = 1; anchor = 0 }
            if (text ~ /@end(code|verbatim)/) { in_code = 0; next }
            if (text ~ /\*\//) { inside = 0; anchor = 0 }
            if (in_code) next
            if (text ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(brief|param|tparam|return|returns|retval|note|warning|sa|see|throws|pre|post)([^a-z]|$)/) {
                anchor = index(text, "@") + 4; next
            }
            if (text ~ /^[[:space:]]*\*[[:space:]]+(-|[0-9]+\.) /) { match(text, /^[[:space:]]*\*[[:space:]]+(-|[0-9]+\.)[[:space:]]+/); anchor = RLENGTH + 1; next }
            if (is_empty_comment_line(text) || text ~ /^[[:space:]]*\*[[:space:]]*@/ || text ~ /^[[:space:]]*\*\//) { anchor = 0; next }
            if (anchor && (FNR in added)) {
                match(text, /^[[:space:]]*\*[[:space:]]*/)
                if (RLENGTH + 1 != anchor) printf "line %d: continuation starts at column %d, expected %d\n", FNR, RLENGTH + 1, anchor
            }
        }')
    [ -z "$ragged" ] || reject_with_reason "$ragged" \
        "$staged_path misaligns a continuation line; a tag continuation hangs 4 columns past its @," \
        "            a bullet or numbered-item continuation aligns under the item text:"
}

# Rejects a bullet or numbered item running past three lines, because an item that long is a paragraph:
# open it with the item's name as its subject and drop the marker.
check_bullet_spans_at_most_three_lines() {
    local sprawling
    sprawling=$(scan_staged_file_marking_added_lines '
        function report() { if (item_start && item_lines > 3 && item_touched) printf "line %d: item runs %d lines\n", item_start, item_lines; item_start = 0 }
        {
            text = $0
            if (text ~ /^[[:space:]]*\/\*\*?/) { inside = 1; in_code = 0 }
            if (!inside) next
            if (text ~ /@(code|verbatim)/) in_code = 1
            if (text ~ /@end(code|verbatim)/) { in_code = 0; next }
            if (text ~ /\*\// && text !~ /^[[:space:]]*\*[[:space:]]+(-|[0-9]+\.) /) { report(); inside = 0; next }
            if (in_code) next
            if (text ~ /^[[:space:]]*\*[[:space:]]+(-|[0-9]+\.) /) { report(); item_start = FNR; item_lines = 1; item_touched = (FNR in added); if (text ~ /\*\//) { report(); inside = 0 }; next }
            if (item_start && text ~ /^[[:space:]]*\*[[:space:]]+[^[:space:]@]/ && text !~ /^[[:space:]]*\*  [^ ]/) {
                ++item_lines; if (FNR in added) item_touched = 1; next
            }
            report()
        }')
    [ -z "$sprawling" ] || reject_with_reason "$sprawling" \
        "$staged_path writes a list item past three lines; turn it into a paragraph that opens with the" \
        "            item's name, and keep bullets for short entries:"
}

# Rejects a block comment whose brackets disagree with each other or with its content: an opener carrying
# text closes on its last text line, a bare opener takes a bare closer. A block with tags, structural commands
# like `@verbatim` or `@code`, or `Label:` field lines takes bare lines; untagged prose opens on its opener.
check_docblock_brackets_match_content() {
    local shape
    shape=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) {
                if (lines[line] !~ /^[[:space:]]*\/\*/ || lines[line] ~ /\*\//) continue
                documentation = (is_docblock_opener(lines[line]))
                tagged = 0; touched = 0
                for (closing = line; closing <= last; ++closing) {
                    if (closing in added) touched = 1
                    if (lines[closing] ~ /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(brief|param|tparam|return|returns|retval|sa|see|note|warning|throws|pre|post|file|author|date|section|subsection|code|verbatim|par|details|deprecated|warning|li)([^a-z{]|\{|$)/) tagged = 1
                    if (lines[closing] ~ /^[[:space:]]*\*[[:space:]]+[A-Z][A-Za-z]*( [A-Za-z]+)?( [A-Za-z]+)?: /) tagged = 1
                    if (lines[closing] ~ /^[[:space:]]*\*[[:space:]]*(```|@example)/) tagged = 1
                    if (lines[closing] ~ /\*\//) break
                }
                bare_opener = (lines[line] ~ /^[[:space:]]*\/\*\*?[[:space:]]*$/)
                bare_closer = (lines[closing] ~ /^[[:space:]]*\*\/[[:space:]]*$/)
                if (touched) {
                    if (bare_opener != bare_closer) printf "line %d: %s opener but %s closer\n", line, \
                        (bare_opener ? "a bare" : "a text-carrying"), (bare_closer ? "a bare" : "a text-carrying")
                    else if (documentation && tagged && !bare_opener) printf "line %d: tagged docblock without its own /** and */ lines\n", line
                    else if (!tagged && bare_opener) printf "line %d: untagged comment spending lines on bare openers and closers\n", line
                }
                line = closing
            }
        }')
    [ -z "$shape" ] || reject_with_reason "$shape" \
        "$staged_path mismatches a comment's brackets; an opener carrying text closes on the last text line," \
        "            a bare opener takes a bare closer, and only a tagged docblock uses bare lines:"
}

# Rejects an `@section` without an empty comment line directly above and below, because a heading reads as
# one only with air around it; directly under a bare `/**` it needs none above, and takes none.
check_section_surrounded_by_blank_comment_lines() {
    local cramped
    cramped=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line)
                if (lines[line] ~ /@section/ && (line in added)) {
                    if (is_empty_comment_line(lines[line - 1]) && lines[line - 2] ~ /^[[:space:]]*\/\*\*[[:space:]]*$/) printf "line %d: empty comment line between the opener and its @section\n", line
                    else if (lines[line - 1] !~ /^[[:space:]]*(\*|\/\*\*)[[:space:]]*$/) printf "line %d: no empty comment line above the @section\n", line
                    if (!is_empty_comment_line(lines[line + 1])) printf "line %d: no empty comment line below the @section\n", line
                }
        }')
    [ -z "$cramped" ] || reject_with_reason "$cramped" \
        "$staged_path crams an @section against its neighbors; keep one empty comment line" \
        "            above and below every @section heading:"
}

# Rejects a `@par` without an empty comment line directly above, and without one below its list unless the
# docblock ends there, because a titled list reads as one only with air around it.
check_par_surrounded_by_blank_comment_lines() {
    local cramped
    cramped=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line)
                if (lines[line] ~ /^[[:space:]]*\*[[:space:]]*@par([[:space:]]|$)/ && (line in added)) {
                    if (!is_empty_comment_line(lines[line - 1])) printf "line %d: no empty comment line above the @par\n", line
                    below = line + 1
                    while (lines[below] ~ /^[[:space:]]*\*[[:space:]]+-[[:space:]]/ || lines[below] ~ /^[[:space:]]*\*[[:space:]][[:space:]][[:space:]]+[^[:space:]]/) ++below
                    if (!is_empty_comment_line(lines[below]) && lines[below] !~ /^[[:space:]]*\*\/[[:space:]]*$/) printf "line %d: no empty comment line below the @par\n", line
                }
        }')
    [ -z "$cramped" ] || reject_with_reason "$cramped" \
        "$staged_path crams a @par against its neighbors; keep one empty comment line" \
        "            above it, and below its list unless the docblock ends there:"
}

# Rejects an `@verbatim` or `@code` block without an empty comment line above its opener or below its closer,
# because a block reads as set apart only with air around it; a bare `/**` above or a `*/` below also counts.
check_blocks_set_apart() {
    local cramped
    cramped=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) {
                if (!(line in added)) continue
                if (lines[line] ~ /^[[:space:]]*\*[[:space:]]*@(verbatim|code(\{[^}]*\})?)[[:space:]]*$/ && lines[line - 1] !~ /^[[:space:]]*(\*[[:space:]]*|\/\*\*.*)$/)
                    printf "line %d: no empty comment line above the block\n", line
                if (lines[line] ~ /^[[:space:]]*\*[[:space:]]*@end(verbatim|code)[[:space:]]*$/ && lines[line + 1] !~ /^[[:space:]]*\*[[:space:]]*(\/)?[[:space:]]*$/)
                    printf "line %d: no empty comment line below the block\n", line
            }
        }')
    [ -z "$cramped" ] || reject_with_reason "$cramped" \
        "$staged_path crams a @code or @verbatim block against its neighbors; keep one empty comment line" \
        "            above the opener and below the closer:"
}

# Rejects a URL in a docblock outside an `@see` entry, and an `@see` whose URL comes before its title, because
# every reference reads `@see Title: URL` on one line, however long the URL runs.
check_urls_behind_see() {
    local loose
    loose=$(scan_staged_file_marking_added_lines '
        is_docblock_opener($0) { in_docblock = 1 }
        in_docblock && /^[[:space:]]*(\/\*\*|\*)[[:space:]]*@(code|verbatim)/ { in_code = 1 }
        in_docblock && /@end(code|verbatim)/ { in_code = 0; if (/\*\//) in_docblock = 0; next }
        in_docblock && !in_code && (FNR in added) && /https?:\/\// {
            if ($0 ~ /@see[[:space:]]+https?:\/\/[^[:space:]]+[[:space:]]+[^*[:space:]]/) printf "line %d: title after the URL\n", FNR
            else if ($0 !~ /@see[[:space:]]/) printf "line %d: URL outside an @see entry\n", FNR
        }
        in_docblock && /\*\// { in_docblock = 0; in_code = 0 }')
    [ -z "$loose" ] || reject_with_reason "$loose" \
        "$staged_path cites a URL outside a titled @see; write \`@see Title: URL\`:"
}

# Rejects an enum whose enumerators are documented only in part, and a docblock that lists three or more of
# the enumerators of the enum below it, because each value carries its own `/** */` or none does.
check_enumerators_documented_individually() {
    local uneven
    uneven=$(scan_staged_file_marking_added_lines '
        is_docblock_opener($0) { docblock = ""; collecting = 1 }
        collecting { docblock = docblock " " $0; if ($0 ~ /\*\//) { collecting = 0; docblock_end = FNR } }
        !in_enum && $0 !~ /^[[:space:]]*(\*|\/\*|\/\/)/ && /(^|[^A-Za-z0-9_])enum([^A-Za-z0-9_]|$)/ && $0 !~ /;[[:space:]]*$/ {
            in_enum = 1; enum_line = FNR; enum_doc = (docblock_end >= FNR - 1) ? docblock : ""
            documented = 0; bare = 0; touched = 0; names = ""; above_doc = 0
        }
        in_enum {
            if (FNR in added) touched = 1
            if (is_comment_closer($0) && $0 ~ /^[[:space:]]*(\/\*\*|\*)/) { above_doc = 1; next }
            if ($0 ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(=[^,]*)?,?[[:space:]]*(\/\/.*)?$/ && $0 !~ /enum/) {
                name = $0; sub(/^[[:space:]]*/, "", name); sub(/[^A-Za-z0-9_].*$/, "", name)
                names = names " " name
                if (above_doc) ++documented; else ++bare
            }
            if ($0 !~ /^[[:space:]]*(\/\*\*|\*)/) above_doc = 0
            if ($0 ~ /}/) {
                if (touched && documented && bare) printf "line %d: %d enumerators documented, %d bare\n", enum_line, documented, bare
                if (touched && enum_doc != "") {
                    listed = 0; count = split(names, each, " ")
                    for (position = 1; position <= count; ++position) if (enum_doc ~ ("(^|[^A-Za-z0-9_])" each[position] "([^A-Za-z0-9_]|$)")) ++listed
                    if (listed >= 3) printf "line %d: the type docblock lists %d of its enumerators\n", enum_line, listed
                }
                in_enum = 0
            }
        }')
    [ -z "$uneven" ] || reject_with_reason "$uneven" \
        "$staged_path documents enumerators unevenly; give every enumerator its own /** */ line," \
        "            and keep the type docblock to what the enum is for:"
}

# Rejects a `@code` without a `{.lang}` or with `{.txt}`, a `@code` or `@verbatim` left open at the `*/`, and a
# Markdown fence inside a docblock,
# because Doxygen highlights only a named language and an unclosed block swallows the rest of the file.
check_code_block_names_language_and_closes() {
    local malformed
    malformed=$(scan_staged_file_marking_added_lines '
        is_docblock_opener($0) { inside = 1; opened = 0; touched = 0 }
        inside && (FNR in added) { touched = 1 }
        inside && /@(code|verbatim)/ {
            opened = FNR
            if ($0 ~ /@code/ && ($0 !~ /@code\{\.[a-z]+\}/ || $0 ~ /@code\{\.txt\}/) && (FNR in added))
                printf "line %d: @code without a language; plain text and formulas take @verbatim\n", FNR
        }
        inside && /@code.*@endcode/ && (FNR in added) { printf "line %d: inline @code; use @c or backticks inside a sentence\n", FNR }
        inside && /@end(code|verbatim)/ { opened = 0 }
        inside && /```/ && (FNR in added) { printf "line %d: Markdown fence inside a docblock\n", FNR }
        inside && /\*\// {
            if (opened && touched) printf "line %d: block never closed by @endcode or @endverbatim\n", opened
            inside = 0
        }')
    [ -z "$malformed" ] || reject_with_reason "$malformed" \
        "$staged_path has a malformed code block; write @code{.cpp} ... @endcode for code in that language," \
        "            @verbatim ... @endverbatim for formulas and plain text, never a Markdown fence:"
}

# Rejects an aligned table row in a docblock outside `@verbatim`, and backticks or `@c` inside one, because a
# table renders literally in monospace only as verbatim text, where markup would print as characters.
check_tables_inside_verbatim() {
    local misplaced
    misplaced=$(scan_staged_file_marking_added_lines '
        /^[[:space:]]*\/\*/ { inside = 1; verbatim = 0; code = 0 }
        inside && /@verbatim/ { if (closed_at && FNR - closed_at <= 2 && (FNR in added)) printf "line %d: a second @verbatim right after the last; keep one block with an empty line inside\n", FNR; verbatim = 1; next }
        inside && /@endverbatim/ { verbatim = 0; closed_at = FNR; next }
        inside && /@code/ { code = 1 }
        inside && /@endcode/ { code = 0; next }
        inside && !code && (FNR in added) {
            if (!verbatim && $0 ~ /^[[:space:]]*\*[[:space:]].*[^[:space:]*]   +[^[:space:]]/ && $0 !~ /\\[[:space:]]*$/ &&
                $0 !~ /^[[:space:]]*\*[[:space:]]+(- |[0-9]+\. |@)/) printf "line %d: table row outside @verbatim\n", FNR
            if (verbatim && ($0 ~ /`/ || $0 ~ /@(c|p|b)[[:space:]]/)) printf "line %d: markup inside @verbatim prints literally\n", FNR
        }
        inside && /\*\// { inside = 0 }')
    [ -z "$misplaced" ] || reject_with_reason "$misplaced" \
        "$staged_path lays out a table outside @verbatim or marks up text inside it; wrap aligned rows in" \
        "            @verbatim ... @endverbatim, with no backticks or @c inside:"
}

# Rejects `Field: value | Field: value` lines in docblocks, because pipes crowd the facts together; each field
# takes its own `Label: value` line.
check_fields_on_labelled_lines() {
    local piped
    piped=$(scan_staged_file_marking_added_lines '
        /^[[:space:]]*\/\*/ { inside = 1; verbatim = 0 }
        inside && /@(verbatim|code)/ { verbatim = 1 }
        inside && !verbatim && (FNR in added) && /[A-Za-z]: [^|]* \| [A-Z][A-Za-z ]*: / { printf "line %d: %s\n", FNR, $0 }
        inside && /@end(verbatim|code)/ { verbatim = 0 }
        inside && /\*\// { inside = 0 }')
    [ -z "$piped" ] || reject_with_reason "$piped" \
        "$staged_path separates fields with pipes; give each field its own Label: value line:"
}

# Rejects a pipe-table row in a comment of a code file, because a header table is plain columns aligned with
# spaces, which reads the same in an editor, a terminal and a diff; pipe tables belong only in Markdown files.
check_tables_aligned_not_piped() {
    local piped
    piped=$(printf '%s\n' "$staged_added_text" | grep -E '^\+[[:space:]]*(\*|//[/!]?|#)[[:space:]]+\|.*\|[[:space:]]*$' || true)
    [ -z "$piped" ] || reject_with_reason "$piped" \
        "$staged_path draws a pipe table in a comment; pipe tables belong only in Markdown, so align plain" \
        "            columns with spaces, indented 4 past the prose, as in \`*      Instruction   Notes\`:"
}

# Rejects a docblock line or a whole-line `//` comment wider than 100 columns, because prose reads at 100
# while code runs to clang-format's 120. URLs, `@code` and `@verbatim` bodies are exempt, and a macro line is measured
# without the padding clang-format adds before its trailing backslash.
check_prose_comment_width() {
    local wide
    wide=$(scan_staged_file_marking_added_lines '
        {
            text = $0
            if (!inside && text ~ /^[[:space:]]*\/\*([^*]|\*[^\/])*\*\/[[:space:]]*[^[:space:]\\]/) next
            if (text ~ /^[[:space:]]*\/\*/) { inside = 1; in_code = 0 }
            prose = inside || text ~ /^[[:space:]]*\/\//
            if (inside && text ~ /@(code|verbatim)/) in_code = 1
            if (inside && text ~ /@end(code|verbatim)/) in_code = 0
            if (inside && text ~ /\*\//) inside = 0
            if (!prose || in_code || !(FNR in added) || text ~ /https?:\/\//) next
            characters = text
            sub(/[[:space:]]*\\$/, "", characters)
            gsub(/[\200-\277]/, "", characters); gsub(/<\/?tt>/, "`", characters); gsub(/\\[\\<>#@%]|&(lt|gt|amp|quot);/, "x", characters)
            if (length(characters) > 100) printf "line %d: %d columns\n", FNR, length(characters)
        }')
    [ -z "$wide" ] || reject_with_reason "$wide" \
        "$staged_path writes prose past 100 columns; rewrite the sentence to fit, code alone may reach 120:"
}

# Rejects a line that breaks a sentence while the next word would fit under the paragraph's widest line,
# because that stub is an edit nobody re-flowed. A colon ending, a URL, tags, bullets, code blocks, aligned
# rows and `Label:` lines start a new paragraph; a `?` or `!` note marker counts as part of the prefix.
check_prose_paragraph_filled() {
    local underfilled
    underfilled=$(scan_staged_file_marking_added_lines '
        function characters(text) { gsub(/[\200-\277]/, "", text); gsub(/<\/?tt>/, "`", text); gsub(/\\[\\<>#@%]|&(lt|gt|amp|quot);/, "x", text); return length(text) }
        '"$paragraph_room_awk"'
        {
            text = $0
            opens =(text ~ /^[[:space:]]*\/\*/)
            if (opens) { inside = 1; in_code = 0 }
            slashed = !inside && text ~ /^[[:space:]]*\/\//
            if (inside && text ~ /@(code|verbatim)/) in_code = 1
            body = text
            sub(/[[:space:]]*\*\/[[:space:]]*$/, "", body)
            sub(/^[[:space:]]*(\/\*\*?|\*|\/\/\/?)[[:space:]]*/, "", body)
            note_marker = ""; if (match(body, /^[?!][[:space:]]+/)) { note_marker = substr(body, 1, 1); body = substr(body, RLENGTH + 1) }
            flowing = (inside || slashed) && !in_code && body != "" && body !~ /^\||https?:\/\// &&
                body !~ /[^[:space:]]   *[^[:space:]]/ && text !~ /@end(code|verbatim)/ && text !~ /^[[:space:]]*\/\/[[:space:]]{4,}/
            # An inline tag like `@c name` mid-sentence wraps like a word; only block tags open a paragraph.
            continues = flowing && (body !~ /^(@|- |[0-9]+\. |[A-Z][A-Za-z]*( [A-Za-z]+)?( [A-Za-z]+)?: )/ || body ~ /^@(a|b|c|e|p|ref)[[:space:]]/) && !opens
            if (!(continues && previous_flowing && previous_kind == (slashed ? "slashed" : "block") && previous_marker == note_marker))
                report_paragraph_room()
            if (flowing) hold_paragraph_line(FNR, body, characters(text))
            previous_flowing = flowing && text !~ /\*\// && previous_text_ok(text)
            previous_kind = slashed ? "slashed" : "block"; previous_marker = note_marker
            if (inside && text ~ /@end(code|verbatim)/) in_code = 0
            if (inside && text ~ /\*\//) inside = 0
        }
        END { report_paragraph_room() }
        function previous_text_ok(text) { return text !~ /:[[:space:]]*(\*\/)?[[:space:]]*$/ && text !~ /https?:\/\// }')
    [ -z "$underfilled" ] || reject_with_reason "$underfilled" \
        "$staged_path leaves a prose line underfilled; it breaks a sentence while the next word fits" \
        "            under the paragraph's widest line, so pull the word up or re-flow:"
}

# Rejects a plain `/* */` comment above a `#define`, or above an `#if` whose branches all define the same one
# macro, because that comment documents the macro and Doxygen only reads it as `/** */`.
check_macro_docs_use_docblocks() {
    local macro_comments
    macro_comments=$(scan_staged_file_marking_added_lines '
        { lines[FNR] = $0; last = FNR }
        END {
            for (line = 1; line <= last; ++line) {
                if (lines[line] !~ /^\/\*([^*]|$)/) continue
                touched = 0
                for (closing = line; closing <= last; ++closing) { if (closing in added) touched = 1; if (lines[closing] ~ /\*\//) break }
                for (next_line = closing + 1; next_line <= last && lines[next_line] ~ /^[[:space:]]*$/; ++next_line) ;
                target = lines[next_line]; macro = ""
                if (target ~ /^#[[:space:]]*define[[:space:]]+[A-Za-z_]/) {
                    macro = target; sub(/^#[[:space:]]*define[[:space:]]+/, "", macro); sub(/[^A-Za-z0-9_].*$/, "", macro)
                } else if (target ~ /^#[[:space:]]*if/) {
                    depth = 0; names = 0; consistent = 1
                    for (scanned = next_line; scanned <= last; ++scanned) {
                        text = lines[scanned]
                        if (text ~ /^#[[:space:]]*if/) ++depth
                        else if (text ~ /^#[[:space:]]*endif/) { if (--depth == 0) break }
                        else if (depth == 1 && text ~ /^#[[:space:]]*define[[:space:]]+[A-Za-z_]/) {
                            name = text; sub(/^#[[:space:]]*define[[:space:]]+/, "", name); sub(/[^A-Za-z0-9_].*$/, "", name)
                            if (names++ == 0) macro = name; else if (name != macro) consistent = 0
                        } else if (depth == 1 && text !~ /^[[:space:]]*$/ && text !~ /^#[[:space:]]*(elif|else|error|warning)/ && text !~ /^[[:space:]]*(\/\/|\/\*|\*)/) consistent = 0
                    }
                    if (!consistent || scanned - next_line > 40) macro = ""
                }
                if (macro != "" && touched) printf "line %d: documents %s, so it opens with /**\n", line, macro
                line = closing
            }
        }')
    [ -z "$macro_comments" ] || reject_with_reason "$macro_comments" \
        "$staged_path explains a macro in a plain /* */ comment; make it a /** */ docblock so Doxygen" \
        "            attaches it to the macro:"
}

# Rejects a whole-line `//` comment at file, namespace, or `extern "C"` scope, because `//` is for notes inside
# function bodies. A comment above a declaration is a `/** */` docblock, one above anything else is `/* */`.
check_file_scope_comments_use_blocks() {
    local line_comments
    line_comments=$(scan_staged_file_marking_added_lines '
        function report(    target) {
            target = (next_code ~ /^[[:space:]]*#[[:space:]]*(if|else|elif|endif|pragma|include|error|undef)/ || next_code == "") ? "/* */" : "/** */"
            printf "line %d: use %s instead of // here\n", run_start, target
        }
        {
            text = $0
            if (in_block) { if (text ~ /\*\//) in_block = 0; next }
            if (continued) { continued = (text ~ /\\$/); next }
            if (text ~ /^[[:space:]]*\/\// && text !~ /^[[:space:]]*\/\/[[:space:]]*(clang-format|IWYU|NOLINT)/) {
                if (!run_start && kind[depth] != "code" && kind[depth] != "record") { run_start = FNR; run_touched = 0 }
                if (run_start && (FNR in added)) run_touched = 1
                next
            }
            if (text ~ /^[[:space:]]*$/) { if (run_start) { next_code = ""; if (run_touched) report(); run_start = 0 } ; next }
            if (run_start) { next_code = text; if (run_touched) report(); run_start = 0 }
            if (text ~ /^[[:space:]]*#/) { continued = (text ~ /\\$/); next }
            code = text
            gsub(/"([^"\\]|\\.)*"|\047([^\047\\]|\\.)*\047/, "", code)
            sub(/\/\/.*$/, "", code)
            while (match(code, /\/\*/)) {
                rest = substr(code, RSTART + 2)
                if (match(rest, /\*\//)) code = substr(code, 1, index(code, "/*") - 1) substr(rest, RSTART + 2)
                else { code = substr(code, 1, index(code, "/*") - 1); in_block = 1; break }
            }
            gsub(/alignas\([^)]*\)/, "", code)
            statement = statement " " code
            for (position = 1; position <= length(code); ++position) {
                character = substr(code, position, 1)
                if (character == "{") {
                    ++depth
                    if (kind[depth - 1] == "code") kind[depth] = "code"
                    else if (statement ~ /(^|[^A-Za-z0-9_])(class|struct|union|enum)([^A-Za-z0-9_]|$)/ && statement !~ /\)/) kind[depth] = "record"
                    else if (statement ~ /(^|[^A-Za-z0-9_])namespace([^A-Za-z0-9_]|$)|(^|[^A-Za-z0-9_])extern[[:space:]]*(\{|$)/) kind[depth] = "scope"
                    else kind[depth] = "code"
                    statement = ""
                } else if (character == "}") { if (depth > 0) delete kind[depth--]; statement = "" }
                else if (character == ";") statement = ""
            }
        }')
    [ -z "$line_comments" ] || reject_with_reason "$line_comments" \
        "$staged_path writes a // comment outside a function body; document the next declaration with" \
        "            /** */, or explain a preprocessor block or a section with /* */:"
}

# Rejects a plain `/* */` note opening a `#pragma region` or a file-scope `#if`, even past the target pragmas
# that follow it, because a note about a section introduces it from above the line it describes. A note
# followed by another directive documents that directive, and a `Label: ...` note heads a group within.
check_region_note_above_pragma() {
    local inside
    inside=$(scan_staged_file_marking_added_lines '
        pending_line {
            if (!note_closed) { if ($0 ~ /\*\//) note_closed = 1; next }
            if ($0 ~ /^[[:space:]]*$/) next
            if ($0 !~ /^[[:space:]]*#/ && (pending_line in added))
                printf "line %d: note inside the section opened on line %d\n", pending_line, pending_opener
            pending_line = 0
        }
        /^[[:space:]]*#pragma[[:space:]]+region/ { opener_line = FNR; indented_allowed = 1; guard = ""; next }
        /^#[[:space:]]*if(n?def)?[[:space:](!]/ && !opener_line {
            opener_line = FNR; indented_allowed = 0; depth = 1; guard = $0
            if (!sub(/^#[[:space:]]*ifndef[[:space:]]+/, "", guard) && !sub(/^#[[:space:]]*if[[:space:]]+!defined\(/, "", guard)) guard = ""
            sub(/[[:space:])].*$/, "", guard)
            next
        }
        opener_line && guard != "" && $0 ~ ("^#[[:space:]]*define[[:space:]]+" guard "([[:space:]]|$)") { opener_line = 0; guard = ""; next }
        opener_line && !indented_allowed && /^[[:space:]]*#[[:space:]]*if/ { ++depth }
        opener_line && !indented_allowed && /^[[:space:]]*#[[:space:]]*endif/ { if (--depth == 0) { opener_line = 0; next } }
        opener_line && (/^[[:space:]]*$/ || /^[[:space:]]*#/) { guard = ""; next }
        opener_line && (indented_allowed ? /^[[:space:]]*\/\*([^*]|$)/ : /^\/\*([^*]|$)/) &&
            $0 !~ /^[[:space:]]*\/\*[[:space:]]+[A-Z][A-Za-z-]*( [A-Za-z-]+)?( [A-Za-z-]+)?( [A-Za-z-]+)?:[[:space:]]/ {
            pending_line = FNR; pending_opener = opener_line; note_closed = ($0 ~ /\*\//); opener_line = 0; next
        }
        { opener_line = 0 }')
    [ -z "$inside" ] || reject_with_reason "$inside" \
        "$staged_path opens a section with a note inside it; move the note above the #pragma region or #if line:"
}

# Rejects a comment directly below an `#include` with no blank line between, because a note about an include
# reads above it, the way every other comment introduces what follows.
check_include_comment_above() {
    local trailing
    trailing=$(scan_staged_file_marking_added_lines '
        previous ~ /^[[:space:]]*#[[:space:]]*include/ && $0 ~ /^[[:space:]]*(\/\*|\/\/)/ && (FNR in added) {
            printf "line %d: comment below the include on line %d\n", FNR, FNR - 1 }
        { previous = $0 }')
    [ -z "$trailing" ] || reject_with_reason "$trailing" \
        "$staged_path puts a comment below an #include; move it above the include it describes:"
}

# Includes form groups in a fixed order with a blank line between them: the C library, the platform's own
# headers, the C++ standard library, external libraries, sibling projects, then this project's own headers.
# Only headers in this repository are quoted, found beside the including file or anywhere in the index, and
# public ones under `c/`, `cpp/` and `include/` always with the `project_include_prefix`. Includes under an `#if` keep their
# quoting but sit outside the grouping; an include guard is not such an `#if`.
check_include_groups() {
    local misgrouped
    misgrouped=$("$fastest_awk" -v project="$project_include_prefix" -v siblings="$sibling_projects" -v file="$staged_path" '
        BEGIN {
            split("cassert cctype cerrno cfenv cfloat cinttypes climits clocale cmath csetjmp csignal cstdarg " \
                  "cstddef cstdint cstdio cstdlib cstring ctime cuchar cwchar cwctype", names, " ")
            for (n in names) clibrary[names[n]] = 1
            split("dirent.h dlfcn.h errno.h fcntl.h ftw.h poll.h pthread.h sched.h signal.h stdio.h stdlib.h " \
                  "string.h time.h unistd.h io.h windows.h bcrypt.h malloc.h", names, " ")
            for (n in names) platform[names[n]] = 1
            split(siblings, names, "|")
            for (n in names) sibling[names[n]] = 1
            split("C-library platform C++-standard external sibling own", labels, " ")
        }
        NR == FNR { added[$1 + 0]; next }
        guard != "" && NF {
            if ($1 == "#define" && $2 == guard) { --depth; counted[level] = 0 }
            guard = ""
        }
        /^[[:space:]]*#[[:space:]]*if/ { ++depth; counted[++level] = 1; guard = ($1 == "#ifndef") ? $2 : "" }
        /^[[:space:]]*#[[:space:]]*endif/ { depth -= counted[level--] }
        {
            if ($0 ~ /^[[:space:]]*#[[:space:]]*include[[:space:]]*[<"]/) {
                header = $0
                quoted = ($0 ~ /include[[:space:]]*"/)
                sub(/^[^<"]*[<"]/, "", header); sub(/[>"].*$/, "", header)
                root = header; sub(/[\/.].*$/, "", root)
                touched = (FNR in added)
                if (root == project) rank = 6
                else if (header in clibrary) rank = 1
                else if ((header in platform) || header ~ /^(sys|linux|arpa|netinet|asm)\//) rank = 2
                else if (header !~ /[\/.]/) rank = 3
                else if (root in sibling) rank = 5
                else rank = 4
                if (quoted && rank != 5 && rank != 6) {
                    directory = file; sub(/[^\/]*$/, "", directory); found = ""
                    # `dir/../` collapses, so a file one directory down finds a header beside its parent.
                    beside = directory header
                    while (sub(/[^\/.][^\/]*\/\.\.\//, "", beside)) {}
                    search = "git ls-files \":(glob)**/" header "\""
                    if (touched && !system("git cat-file -e \":" beside "\" 2>/dev/null")) found = beside
                    else if (touched) { search | getline found; close(search) }
                    if (touched && found == "")
                        printf "line %d: \"%s\" is not in this repository - write <%s>\n", FNR, header, header
                    if (match(found, "^(c|cpp|include)/" project "/"))
                        printf "line %d: \"%s\" is a public header - write \"%s\"\n", FNR, header, substr(found, RLENGTH - length(project))
                    rank = 6
                }
                if (touched && quoted && rank != 6)
                    printf "line %d: \"%s\" is a %s header - write <%s>\n", FNR, header, labels[rank], header
                if (touched && !quoted && rank == 6)
                    printf "line %d: <%s> is an own header - write \"%s\"\n", FNR, header, header
                if (depth) next
                if (touched && block && rank != block)
                    printf "line %d: a %s header shares its group with %s ones\n", FNR, labels[rank], labels[block]
                if (touched && !block && rank < previous)
                    printf "line %d: a %s group follows a %s group\n", FNR, labels[rank], labels[previous]
                if (!block) block = rank
            }
            else if ($0 !~ /^[[:space:]]*#/) { if (block) previous = block; block = 0 }
        }' "$staged_lines_path" "$staged_text_path")
    [ -z "$misgrouped" ] || reject_with_reason "$misgrouped" \
        "$staged_path misgroups its includes - C library, platform, C++ standard, external, <sibling/...>," \
        "            then \"$project_include_prefix/...\", each group separated by a blank line:"
}

# Rejects a backtick code span broken across two comment lines, because a wrapped expression reads as two
# fragments. Re-flow the prose so the whole span sits on one line.
check_code_span_on_one_line() {
    local broken
    broken=$(scan_staged_file_marking_added_lines '
        /^[[:space:]]*\/\*/ { inside = 1; in_code = 0 }
        {
            comment = inside || $0 ~ /^[[:space:]]*\/\//
            if (inside && $0 ~ /@(code|verbatim)/) in_code = 1
            text = $0; ticks = gsub(/`/, "`", text)
            if (comment && !in_code && ticks % 2 == 1 && (FNR in added)) printf "line %d: unbalanced backtick\n", FNR
            if (inside && $0 ~ /@end(code|verbatim)/) in_code = 0
            if (inside && $0 ~ /\*\//) inside = 0
        }')
    [ -z "$broken" ] || reject_with_reason "$broken" \
        "$staged_path wraps a backtick code span across lines; re-flow so the span stays on one line:"
}

# Rejects a tag section starting directly below a body paragraph, because tags read as their own section
# only with an empty comment line above them. Directly below `@brief` or another tag they need none.
check_tags_separated_from_body() {
    local cramped
    cramped=$(scan_staged_file_marking_added_lines '
        is_docblock_opener($0) { inside = 1; state = "start"; if ($0 ~ /@(brief|param|tparam|return|note|sa|see)/) state = "tag"; next }
        !inside { next }
        /\*\// { inside = 0 }
        /^[[:space:]]*\*[[:space:]]*@(code|verbatim)/ { in_code = 1 }
        in_code { if ($0 ~ /@end(code|verbatim)/) in_code = 0; state = "body"; next }
        is_empty_comment_line($0) { state = "blank"; next }
        /^[[:space:]]*\*[[:space:]]+@(file|author|date|brief|param|tparam|return|returns|retval|note|warning|sa|see|throws|pre|post|deprecated|copydoc|section)([^a-z]|$)/ {
            if ($0 ~ /@(file|author|date|brief|copydoc|section)/) { state = "tag"; next }
            if (state == "body" && (FNR in added)) printf "line %d: tag directly below a body paragraph\n", FNR
            state = "tag"; next
        }
        /^[[:space:]]*\*[[:space:]]{5,}[^[:space:]]/ { if (state != "tag") state = "body"; next }
        /^[[:space:]]*\*[[:space:]]/ { state = "body" }')
    [ -z "$cramped" ] || reject_with_reason "$cramped" \
        "$staged_path starts a tag section right below a body paragraph; put an empty comment line between:"
}

# Rejects a `@param` directly after a `@tparam` group, because a blank comment line separates the template
# parameters from the function parameters.
check_tparams_separated_from_params() {
    local joined
    joined=$(scan_staged_file_marking_added_lines '
        /^[[:space:]]*\*[[:space:]]+@tparam/ { in_tparams = 1; next }
        in_tparams && /^[[:space:]]*\*[[:space:]]+@param/ { if (FNR in added) printf "line %d: @param directly after @tparam\n", FNR; in_tparams = 0; next }
        in_tparams && /^[[:space:]]*\*[[:space:]]{5,}[^[:space:]]/ { next }
        { in_tparams = 0 }')
    [ -z "$joined" ] || reject_with_reason "$joined" \
        "$staged_path runs @param straight after @tparam; put an empty comment line between the groups:"
}

# Rejects a function's own parameter named in its docblock in backticks, or bare when the name contains `_` or a
# digit, because Doxygen links a parameter only as `@p name`. The names come from the declaration below.
check_parameter_references_use_p() {
    local references
    references=$(scan_staged_file_marking_added_lines '
function report_block(    i, text, name, declaration, count, parts, k, candidate, pattern, named) {
    declaration = decl
    gsub(/\/\*[^*]*\*\//, " ", declaration); gsub(/\/\/[^\n]*/, " ", declaration)
    if (declaration ~ /(^|[^A-Za-z0-9_])concept[[:space:]]/) return
    sub(/[{;].*$/, "", declaration)
    if (!match(declaration, /\(.*\)/)) return
    declaration = substr(declaration, RSTART + 1, RLENGTH - 2)
    gsub(/\([^()]*\)/, "", declaration); gsub(/<[^<>]*>/, "", declaration); gsub(/<[^<>]*>/, "", declaration)
    gsub(/=[^,]*/, "", declaration)
    count = split(declaration, parts, ",")
    delete params
    for (k = 1; k <= count; ++k) {
        candidate = parts[k]; sub(/[[:space:]]*(\[[^]]*\])?[[:space:]]*$/, "", candidate)
        if (match(candidate, /[A-Za-z_][A-Za-z0-9_]*$/)) { name = substr(candidate, RSTART, RLENGTH); if (name !~ /^(void|const|int|float|double|char|bool|auto)$/ && !(name in params)) { params[name]; ordered_params[++named] = name } }
    }
    for (i = 1; i <= lines_count; ++i) {
        text = lines[i]
        if (text ~ /@(code|verbatim)/) in_code = 1
        if (text ~ /@end(code|verbatim)/) { in_code = 0; continue }
        if (in_code) continue
        sub(/@(param|tparam)(\[[a-z,]+\])?[[:space:]]+[A-Za-z_][A-Za-z0-9_]*/, "", text)
        gsub(/@b[[:space:]]+\[[^]]*\]/, "", text)
        gsub(/<\/tt>/, "\001", text); gsub(/<tt>[^\001]*\001/, "", text); gsub(/@c[[:space:]]+[^[:space:]]+/, "", text)
        for (k = 1; k <= named; ++k) {
            name = ordered_params[k]
            if (index(text, "`" name "`") && !index(text, "@p `" name "`")) { hits++; if (!(line_numbers[i] in added)) continue; printf "line %d: `%s` should read @p %s\n", line_numbers[i], name, name }
            else if (name ~ /[_0-9]/ && text ~ ("(^|[^@A-Za-z0-9_`p ]|[^@] |^ )" name "([^A-Za-z0-9_`]|$)") && text !~ ("@p " name "([^A-Za-z0-9_]|$)")) { hits++; if (!(line_numbers[i] in added)) continue; printf "line %d: bare %s should read @p %s\n", line_numbers[i], name, name }
        }
    }
}
is_docblock_opener($0) { collecting = 1; lines_count = 0; in_code = 0; decl = ""; reading = 0 }
collecting { lines[++lines_count] = $0; line_numbers[lines_count] = FNR; if ($0 ~ /\*\//) { collecting = 0; reading = 1; decl = ""; next } ; next }
reading {
    if ($0 ~ /^[[:space:]]*$/ || $0 ~ /^[[:space:]]*#/) { reading = 0; next }
    decl = decl " " $0
    if ($0 ~ /[{;]/ || length(decl) > 2000) { reading = 0; report_block() }
}
')
    [ -z "$references" ] || reject_with_reason "$references" \
        "$staged_path names a parameter without @p; write @p name for the function's own parameters:"
}

# Rejects an orphan: a wrapped paragraph or tag entry whose last line holds one or two short words, as in
# "…the tally of calls that reached" / "it.". Reword so the sentence ends on a fuller line.
check_no_orphan_last_line() {
    local orphans
    orphans=$(scan_staged_file_marking_added_lines '
        function body(text) { sub(/^[[:space:]]*(\/\*\*?|\*|\/\/[\/!]?)[[:space:]]?/, "", text); sub(/[[:space:]]*\*\/[[:space:]]*$/, "", text); return text }
        {
            is_comment = ($0 ~ /^[[:space:]]*(\*|\/\/)/ && $0 !~ /^[[:space:]]*\*\//)
            if ($0 ~ /@(code|verbatim)/) in_code = 1
            current_body = is_comment ? body($0) : ""
            inline_tag = (current_body ~ /^[[:space:]]*@(a|b|c|e|p|ref)[[:space:]]/)
            ends_paragraph = !is_comment || current_body ~ /^[[:space:]]*$/ || (current_body ~ /^[[:space:]]*@/ && !inline_tag) || $0 ~ /\*\//
            if (previous_continues && ends_paragraph && (previous_line in added)) {
                words = previous_body; gsub(/^[[:space:]]+/, "", words)
                if (split(words, parts, /[[:space:]]+/) <= 2 && length(words) < 20) printf "line %d: orphan `%s`\n", previous_line, words
            }
            previous_continues = is_comment && !in_code && previous_comment && previous_body != "" && current_body != "" &&
                $0 !~ /^[[:space:]]*\/\/[[:space:]]{4,}/ &&
                (current_body !~ /^[[:space:]]*(@|- |[0-9]+\. |\||[A-Z][A-Za-z]*( [A-Za-z]+)?( [A-Za-z]+)?: )/ || inline_tag) && current_body !~ /[^[:space:]]   *[^[:space:]]/
            previous_comment = is_comment; previous_body = current_body; previous_line = FNR
            if ($0 ~ /@end(code|verbatim)/) in_code = 0
        }')
    [ -z "$orphans" ] || reject_with_reason "$orphans" \
        "$staged_path leaves an orphan of one or two words on a paragraph's last line; reword so it ends fuller:"
}

# Rejects ALL-CAPS emphasis such as MUST or NEVER in comments, because the wording carries the weight.
check_comment_emphasis_lowercase() {
    local capitals
    capitals=$(printf '%s\n' "$staged_added_text" | grep -E "$added_comment_line_pattern" |
        grep -E '(^|[^A-Za-z_])(MUST|NEVER|ONLY|ALWAYS|EVERY|WHOLE|SHOULD|INVALIDAT[A-Z]*|ABOVE|AFTER|ALREADY|ALSO|BEFORE|BETWEEN|BLINDLY|BOTH|CONDITIONALLY|DELIBERATELY|DIFFERENT|EVEN|EXACTLY|EXCEPT|FRESH|HERE|HIGHEST|INSIDE|INVERTED|MOST|NARROWER|NEAREST|ONCE|ORIGINAL|OUTSIDE|REVERSED|SAME|SHORTER|TOTAL|UNSAFE|VALID|VISIBLE|WITHOUT)([^A-Za-z_]|$)' || true)
    [ -z "$capitals" ] || reject_with_reason "$capitals" \
        "$staged_path uses ALL-CAPS emphasis in a comment; lowercase it and let the wording carry the weight:"
}

# Rejects a qualified name like `std::map` bare in docblock prose, because code tokens are marked, with `@c`
# or <tt> as the file already does.
check_qualified_names_marked() {
    local bare
    bare=$(scan_staged_file_marking_added_lines '
        is_docblock_opener($0) { inside = 1; in_code = 0 }
        inside && /@(code|verbatim)/ { in_code = 1 }
        inside && !in_code && (FNR in added) {
            prose = $0
            gsub(/<\/tt>/, "\001", prose); gsub(/<tt>[^\001]*\001/, "", prose); gsub(/@(c|p|ref|sa|see|copydoc|link)[[:space:]]+[^[:space:]]+/, "", prose); gsub(/https?:[^[:space:]]+/, "", prose)
            if (prose ~ /(^|[^A-Za-z0-9_:@])[A-Za-z_][A-Za-z0-9_]*::[A-Za-z_~][A-Za-z0-9_:]*/) printf "line %d: %s\n", FNR, $0
        }
        inside && /@end(code|verbatim)/ { in_code = 0 }
        inside && /\*\// { inside = 0 }')
    [ -z "$bare" ] || reject_with_reason "$bare" \
        "$staged_path writes a qualified name bare in doc prose; mark it with @c or <tt>:"
}

# Rejects a bare `//` line directly above a member or type declaration, because declarations take
# `/** ... */`. A brace stack tells a record scope from a function body, where the same shape is a local.
check_declaration_docs_not_line_comments() {
    local line_comment_docs
    line_comment_docs=$(scan_staged_file_marking_added_lines '
        {
            line = $0
            if (in_comment) { if (match(line, /\*\//)) { line = substr(line, RSTART + 2); in_comment = 0 } else next }
            gsub(/\/\*([^*]|\*[^\/])*\*\//, " ", line)
            if (match(line, /\/\*/)) { line = substr(line, 1, RSTART - 1); in_comment = 1 }
            comment_at = index(line, "//")
            code = comment_at ? substr(line, 1, comment_at - 1) : line
            if (comment_at && substr(line, comment_at + 2, 1) != "/" && code ~ /^[[:space:]]*$/) { pending = $0; pending_line = FNR }
            else if (kind[depth] == "record" && pending &&
                     code ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_:<>,* ]* [A-Za-z_][A-Za-z0-9_]* *([={;]|$)/) {
                if ((pending_line in added) || (FNR in added)) printf "line %d:%s\n", pending_line, pending
                pending = ""
            }
            else if (code !~ /^[[:space:]]*$/) pending = ""
            statement = statement " " code
            for (position = 1; position <= length(code); ++position) {
                character = substr(code, position, 1)
                if (character == "{") {
                    ++depth
                    kind[depth] = (kind[depth - 1] == "code") ? "code" \
                        : (statement ~ /(^|[^A-Za-z0-9_])(class|struct|union|enum)([^A-Za-z0-9_]|$)/) ? "record" \
                        : (statement ~ /(^|[^A-Za-z0-9_])namespace([^A-Za-z0-9_]|$)/) ? "namespace" : "code"
                    statement = ""
                } else if (character == "}") { if (depth > 0) delete kind[depth--]; statement = "" }
                else if (character == ";") statement = ""
            }
        }')
    [ -z "$line_comment_docs" ] || reject_with_reason "$line_comment_docs" \
        "$staged_path documents a declaration with a bare \`//\` comment;" \
        "            use a /** ... */ block, and keep \`//\` for notes inside bodies:"
}

# endregion Doxygen Blocks

# region Binding Docs

# The comment marker whose text is prose, as an awk regex anchored at line start, per binding language.
binding_comment_marker() { # binding_comment_marker <path>
    case "$1" in
    *.rs | *.zig) printf '%s' '^[[:space:]]*//[/!]?' ;;
    *.go) printf '%s' '^[[:space:]]*//' ;;
    *.swift) printf '%s' '^[[:space:]]*///?' ;;
    *.ts | *.mts | *.js | *.mjs | *.cjs) printf '%s' '^[[:space:]]*(/\\*\\*|\\*|//)' ;;
    *.py | *.pyi | *.mojo | python/*.c) printf '%s' '^[[:space:]]*#' ;;
    esac
}

# The staged text whose comments the binding checks read: the file itself, or for the CPython glue, one
# `# `-prefixed line per `doc_*[]` literal line, blank elsewhere, so line numbers still match the file.
binding_prose_text() {
    case "$staged_path" in
    python/*.c)
        printf '%s\n' "$staged_file_text" | "$fastest_awk" '
            /^[[:space:]]*(static[[:space:]]+)?char const doc_[A-Za-z0-9_]*\[\][[:space:]]*=/ { inside = 1; print ""; next }
            inside {
                line = $0
                if (match(line, /"([^"\\]|\\.)*"/)) {
                    text = substr(line, RSTART + 1, RLENGTH - 2)
                    paragraph_end = (text ~ /\\n\\n$/)
                    sub(/(\\n)+$/, "", text); gsub(/\\"/, "\"", text); gsub(/\\\\/, "\\", text)
                    print "# " text (paragraph_end ? "\t" : "")
                } else print ""
                if (line ~ /;[[:space:]]*(\/\/.*)?$/) inside = 0
                next
            }
            { print "" }'
        ;;
    *) printf '%s\n' "$staged_file_text" ;;
    esac
}

# Runs an awk program over the binding prose text with `added[line]` preloaded and `marker` set, and with
# helpers for the comment body, fenced code, and character width shared by every binding check.
scan_binding_prose() { # scan_binding_prose <awk-program>
    local marker
    local prose_path=$staged_text_path
    case "$staged_path" in
    python/*.c)
        prose_path=$results_directory/$ordinal.prose
        [ -f "$prose_path" ] || binding_prose_text > "$prose_path"
        ;;
    esac
    marker=$(binding_comment_marker "$staged_path")
    [ -n "$marker" ] || return 0
    "$fastest_awk" -v marker="$marker" '
        function characters(text) { sub(/\t$/, "", text); gsub(/[\200-\277]/, "", text); return length(text) }
        function comment_body(text) { if (!match(text, marker)) return ""; text = substr(text, RLENGTH + 1); sub(/^[[:space:]]/, "", text); return text }
        function is_comment(text) { return text ~ marker && text !~ /^[[:space:]]*\*\// }
        NR == FNR { added[$1 + 0]; next }
        { commented = is_comment($0); body = commented ? comment_body($0) : ""
          if (commented && body ~ /^[[:space:]]*```/) { in_fence = !in_fence; fence_edge = 1 } else fence_edge = 0
          if (!commented) in_fence = 0 }
        '"$1" "$staged_lines_path" "$prose_path"
}

# Rejects a binding-doc code fence that opens without a language, because a renderer then guesses; name
# it, as in ```sh, ```js or ```text. Rust is exempt, since a bare fence there is a doctest.
check_binding_fences_name_language() {
    local bare
    case "$staged_path" in *.rs) return 0 ;; esac
    bare=$(scan_binding_prose '
        fence_edge && in_fence && (FNR in added) && body ~ /^[[:space:]]*```[[:space:]]*$/ { printf "line %d: %s\n", FNR, $0 }')
    [ -z "$bare" ] || reject_with_reason "$bare" \
        "$staged_path opens a code fence without naming its language; write \`\`\`sh, \`\`\`js, \`\`\`text and so on:"
}

# Rejects a binding comment line past 100 columns, because prose reads at 100 in every language while code
# runs to the formatter's 120. URLs and fenced code are exempt.
check_binding_prose_width() {
    local wide
    wide=$(scan_binding_prose '
        commented && !in_fence && !fence_edge && (FNR in added) && $0 !~ /https?:\/\// && characters($0) > 100 {
            printf "line %d: %d columns\n", FNR, characters($0) }')
    [ -z "$wide" ] || reject_with_reason "$wide" \
        "$staged_path writes a doc or comment line past 100 columns; rewrite the sentence to fit:"
}

# Rejects a binding comment line that breaks a sentence while the next word would fit under the paragraph's
# widest line. Headings, tags, new bullets, fenced code, aligned rows and colon endings start fresh.
check_binding_prose_filled() {
    local underfilled
    underfilled=$(scan_binding_prose '
        '"$paragraph_room_awk"'
        {
            note_marker = ""; if (match(body, /^[?!][[:space:]]+/)) { note_marker = substr(body, 1, 1); body = substr(body, RLENGTH + 1) }
            starts_entry = (body ~ /^([-*+] |[0-9]+\. |@|#|\||[A-Z][A-Za-z]*( [A-Za-z]+)?( [A-Za-z]+)?: )/) || note_marker != previous_marker
            flowing = commented && !in_fence && !fence_edge && body != "" && body !~ /[^[:space:]]   *[^[:space:]]/ &&
                      body !~ /https?:\/\// && body !~ /^[[:space:]]/ && body !~ /^[A-Za-z0-9_.-]+\/[^[:space:]]*$/ &&
                      body !~ /^(swift-tools-version|go:|\+build|@ts-|eslint|nolint|noqa|type: ?ignore|region |endregion|MARK:|-\*-)/
            if (!(flowing && !starts_entry && previous_flowing)) report_paragraph_room()
            if (flowing) hold_paragraph_line(FNR, body, characters($0))
            previous_flowing = flowing && body !~ /:[[:space:]]*(\*\/)?[[:space:]]*$/ && body !~ /^#/ && $0 !~ /\t$/
            previous_marker = note_marker
        }
        END { report_paragraph_room() }')
    [ -z "$underfilled" ] || reject_with_reason "$underfilled" \
        "$staged_path leaves a doc or comment line underfilled; it breaks a sentence while the next word" \
        "            fits under the paragraph's widest line, so pull the word up or re-flow:"
}

# Rejects a parenthetical aside in binding doc prose, because asides read as commas, em-dashes, or a second
# sentence. Parentheses around code spans, math, and a plural "(s)" stay.
check_binding_prose_without_asides() {
    local asides
    asides=$(scan_binding_prose '
        commented && !in_fence && !fence_edge && (FNR in added) {
            prose = body; gsub(/`[^`]*`/, "", prose); gsub(/\[[^]]*\]\([^)]*\)/, "", prose)
            while (match(prose, /(^|[[:space:]])\([A-Za-z][^()]*\)/)) {
                aside = substr(prose, RSTART, RLENGTH); prose = substr(prose, RSTART + RLENGTH)
                if (aside !~ /[=+*\/<>^%]|×|·|−|≤|≥|\(s\)$|^[[:space:]]*\([a-z_]+(, ?[a-z_]+)+\)$/ && prose !~ /^:/) { printf "line %d: %s\n", FNR, aside; break }
            }
        }')
    [ -z "$asides" ] || reject_with_reason "$asides" \
        "$staged_path puts a parenthetical aside in doc prose; rework it into a comma, an em-dash," \
        "            or a second sentence:"
}

# Rejects math notation inside a code span in binding docs, because backticks mean code and formulas read as
# plain Unicode prose: `x^2`, `sqrt(x)`, `||x||` and a shape bracket holding a product.
check_binding_formula_not_in_backticks() {
    local formulas
    formulas=$(scan_binding_prose '
        commented && !in_fence && (FNR in added) &&
        (body ~ /`[^`]*([^[:space:]^]\^([0-9(]|T[^A-Za-z0-9_])|sqrt\(|\|\|[^|`]+\|\|)[^`]*`/ || body ~ /`\[[^]`]*\*[^]`]*\]`/) {
            printf "line %d: %s\n", FNR, body
        }')
    [ -z "$formulas" ] || reject_with_reason "$formulas" \
        "$staged_path puts a formula in a code span; write it as plain Unicode prose, as in aᵀ × M × b:"
}

# Rejects a shape spelled `m × n`, `rows x cols`, or as a tuple after "shape", because shapes read
# `[rows,columns]` in every language.
check_binding_shapes_bracketed() {
    local shapes
    shapes=$(scan_binding_prose '
        commented && !in_fence && (FNR in added) {
            prose = body; gsub(/`[^`]*`/, "", prose)
            dimension = "([mnk]|rows|cols|columns|height|width|depth|count)"
            if (prose ~ ("(^|[^A-Za-z_])" dimension " ?× ?" dimension "([^A-Za-z_]|$)") ||
                prose ~ ("(^|[^A-Za-z_])" dimension " x " dimension "([^A-Za-z_]|$)") ||
                prose ~ /shape[^.]{0,16}\([a-z_]+, ?[a-z_]+(, ?[a-z_]+)*\)/)
                printf "line %d: %s\n", FNR, body
        }')
    [ -z "$shapes" ] || reject_with_reason "$shapes" \
        "$staged_path spells a shape as a product or a tuple; write [rows,columns]:"
}

# Rejects a tag-like continuation not hanging 4 past its marker, and a bullet continuation not aligned under
# its text. Tag-like means Swift `- Parameter:` and its siblings, and TSDoc `@param` and its siblings.
check_binding_continuation_indent() {
    case "$staged_path" in *.swift | *.ts | *.mts | *.js | *.mjs | *.cjs | *.rs) ;; *) return 0 ;; esac
    local ragged
    ragged=$(scan_binding_prose '
        {
            raw = $0
            if (!commented || in_fence || fence_edge) { anchor = 0; next }
            match(raw, marker); raw = substr(raw, RLENGTH + 1); sub(/^[[:space:]]/, "", raw)
            if (raw ~ /^[[:space:]]*$/) { anchor = 0; next }
            if (raw ~ /^@(param|returns|throws|remarks|typeParam|deprecated)[[:space:]]/) { anchor = 5; next }
            if (raw ~ /^ *([-*+]|[0-9]+\.) /) { match(raw, /^ *([-*+]|[0-9]+\.) +/); anchor = RLENGTH + 1; next }
            if (raw ~ /^(@|#)/) { anchor = 0; next }
            if (anchor && (FNR in added)) {
                match(raw, /^ */)
                if (RLENGTH + 1 != anchor) printf "line %d: continuation at column %d of the doc text, expected %d\n", FNR, RLENGTH + 1, anchor
            }
        }')
    [ -z "$ragged" ] || reject_with_reason "$ragged" \
        "$staged_path misaligns a doc continuation; a TSDoc tag hangs 4 past its @, and a bullet, Swift's" \
        "            - Parameter: and - Note: included, aligns its continuation under the bullet text:"
}

# Rejects a tag-like binding entry running past three lines, such as a Swift `- Warning:`, a TSDoc `@param`, or
# a Google `Args:` item, because an entry stays short and the rest belongs in the doc body.
check_binding_tag_entries_span_at_most_three_lines() {
    local sprawling
    sprawling=$(scan_binding_prose '
        {
            raw = $0
            if (!commented || in_fence || fence_edge) { report(); next }
            match(raw, marker); raw = substr(raw, RLENGTH + 1); sub(/^[[:space:]]/, "", raw)
            if (raw ~ /^[[:space:]]*$/) { report(); next }
            if (raw ~ /^- (Parameter|Parameters|Returns|Throws|Warning|Note|Important|Precondition|Postcondition|Complexity|Attention)[ :]/ ||
                raw ~ /^@(param|returns|throws|remarks|typeParam|deprecated)[[:space:]]/ ||
                raw ~ /^    [A-Za-z_][A-Za-z0-9_]* \([^)]*\): /) { report(); entry = FNR; span = 1; touched = (FNR in added); next }
            if (entry && raw ~ /^[[:space:]]{2,}[^[:space:]]/ && raw !~ /^    [A-Za-z_][A-Za-z0-9_]* \(/) { ++span; if (FNR in added) touched = 1; next }
            report()
        }
        function report() { if (entry && span > 3 && touched) printf "line %d: entry runs %d lines\n", entry, span; entry = 0 }
        END { report() }')
    [ -z "$sprawling" ] || reject_with_reason "$sprawling" \
        "$staged_path lets a doc entry run past three lines; keep it short and move the rest into the body:"
}

# Rejects Markdown `**strong**`, `*emphasis*` and `* item` bullets in Rust, Swift and TypeScript docs, because
# the house Markdown spells them `__strong__`, `_emphasis_` and `- item`. Code spans and fences are exempt.
check_binding_markdown_underscored() {
    case "$staged_path" in *.rs | *.swift | *.ts | *.mts | *.js | *.mjs | *.cjs) ;; *) return 0 ;; esac
    local asterisks
    asterisks=$(scan_binding_prose '
        commented && !in_fence && !fence_edge && (FNR in added) {
            prose = body; gsub(/`[^`]*`/, "", prose)
            if (prose ~ /\*\*[^*[:space:]][^*]*\*\*/) printf "line %d: **strong** reads __strong__\n", FNR
            else if (prose ~ /(^|[^*A-Za-z0-9_])\*[^*[:space:]][^*]*[^*[:space:]\\]\*([^*A-Za-z0-9_]|$)/) printf "line %d: *emphasis* reads _emphasis_\n", FNR
            else if (prose ~ /^[[:space:]]*\* /) printf "line %d: * bullet reads - bullet\n", FNR
        }')
    [ -z "$asterisks" ] || reject_with_reason "$asterisks" \
        "$staged_path marks Markdown with asterisks; write __strong__, _emphasis_ and - bullets:"
}

# Rejects ALL-CAPS emphasis such as ONLY or NEVER in binding docs, because emphasis belongs in the wording.
check_binding_emphasis_lowercase() {
    local capitals
    case "$staged_path" in
    *.py | *.pyi)
        capitals=$(printf '%s\n' "$staged_added_text" | grep -nE '(^|[^A-Za-z_])(ONLY|NEVER|ALWAYS|EVERY|WHOLE|MUST|NOT)([^A-Za-z_]|$)' || true) ;;
    *)
        capitals=$(scan_binding_prose '
            commented && !in_fence && (FNR in added) && body ~ /(^|[^A-Za-z_])(ONLY|NEVER|ALWAYS|EVERY|WHOLE|INVALIDAT[A-Z]*|MUST|NOT)([^A-Za-z_]|$)/ {
                printf "line %d: %s\n", FNR, body }') ;;
    esac
    [ -z "$capitals" ] || reject_with_reason "$capitals" \
        "$staged_path uses ALL-CAPS emphasis in a doc; lowercase it and let the wording carry the weight:"
}

# Rejects a Google-style docstring section named `Parameters:` in the CPython glue, because ruff'"'"'s
# google convention and the rest of the ecosystem read `Args:`.
check_python_docstring_sections() {
    local sections
    sections=$(binding_prose_text | grep -nE '^# (Parameters|Arguments|Return|Raise):$' || true)
    [ -z "$sections" ] || reject_with_reason "$sections" \
        "$staged_path names a docstring section outside Google style; use Args:, Returns:, Raises:"
}

# Rejects docstring arguments aligned into a column by hand, as in `    name:     Text`, because such columns
# drift with the first edit; an inline comment keeps its two spaces after a colon.
check_python_arguments_unaligned() {
    local aligned
    aligned=$(printf '%s\n' "$staged_added_text" |
        grep -E '^\+[[:space:]]+[A-Za-z_][A-Za-z0-9_]*( \([^)]*\))?:  +[^[:space:]#]' || true)
    [ -z "$aligned" ] || reject_with_reason "$aligned" \
        "$staged_path aligns docstring arguments into a column by hand; put one space after the colon:"
}

# Rejects a Go method referenced as a call, such as `b.Depth()`, because doc links are `[Type.Method]`;
# a tab-indented line is a code example, which calls as code does.
check_go_method_links_bracketed() {
    local calls
    calls=$(printf '%s\n' "$staged_added_text" | grep -E '^\+[[:space:]]*//' | grep -vE $'^\\+[[:space:]]*//\t' |
        grep -nE '[A-Za-z_]+\.[A-Z][A-Za-z0-9_]*\(\)' || true)
    [ -z "$calls" ] || reject_with_reason "$calls" \
        "$staged_path references a Go method as a call; link it as [Type.Method]:"
}

# Rejects a Go file whose comment directly above `package` sits outside the file named after the package,
# because Go takes one package comment, and the file carrying the package's name is where readers look.
check_go_package_comment_in_package_file() {
    local package_comments
    package_comments=$("$fastest_awk" -v file="${staged_path##*/}" '
        /^\/\// { comment = FNR; next }
        /^package / { if (comment && comment == FNR - 1 && file != $2 ".go") print "line " FNR ": package comment outside " $2 ".go"; exit }
        { comment = 0 }' <<<"$staged_file_text")
    [ -z "$package_comments" ] || reject_with_reason "$package_comments" \
        "$staged_path documents the package outside the file named after it; move the package comment there:"
}

# Rejects a Go file without its `// File: <path>`, `// Author: <author>` and `// Date: <date>` fields, as the
# Python and Rust modules carry them. The package comment ends with them after an empty `//` line, so it
# still opens with "Package <name>"; any other file opens with them, after an optional summary line and
# `//`, then an empty line.
check_go_file_header() {
    local header
    header=$(printf '%s\n' "$staged_file_text" | "$fastest_awk" -v path="$staged_path" '
        { lines[NR] = $0 }
        /^package / && !package_line { package_line = NR }
        END {
            author = "^// Author: [A-Z][^.]*$"
            date = "^// Date: [A-Z][a-z]+ [0-9]+, [0-9][0-9][0-9][0-9]$"
            if (package_line > 1 && lines[package_line - 1] ~ /^\/\//) {
                if (lines[package_line - 3] != "// File: " path || lines[package_line - 2] !~ author || lines[package_line - 1] !~ date || lines[package_line - 4] != "//")
                    print "line " package_line ": the package comment must end with //, // File: " path ", // Author: <author>, // Date: <date>"
            } else {
                first = (lines[1] ~ /^\/\/ [^ ]/ && lines[2] == "//") ? 3 : 1
                if (lines[first] != "// File: " path || lines[first + 1] !~ author || lines[first + 2] !~ date || lines[first + 3] != "")
                    print "line 1: the file must open with an optional summary and //, then // File: " path ", // Author: <author>, // Date: <date>, an empty line"
            }
        }')
    [ -z "$header" ] || reject_with_reason "$header" \
        "$staged_path opens without its file header, the // File:, // Author: and // Date: fields:"
}

# Rejects a Rust file whose leading `//!` module doc does not end with `File: <path>`, `Author:` and `Date:` lines.
check_rust_module_fields() {
    local fields
    fields=$("$fastest_awk" -v path="$staged_path" '
        NR == 1 && !/^\/\/!/ { print "line 1: no //! module doc"; exit }
        /^\/\/!/ { third_last = before_last; before_last = last; last = $0; next }
        {
            if (third_last != "//! File: " path) print "module doc must end with //! File: " path
            else if (before_last !~ /^\/\/! Author: [A-Z]/) print "module doc must follow //! File: with //! Author: <author>"
            else if (last !~ /^\/\/! Date: [A-Z][a-z]+ [0-9]+, [0-9][0-9][0-9][0-9]$/) print "module doc must end with //! Date: <Month D, YYYY>"
            exit
        }' <<<"$staged_file_text")
    [ -z "$fields" ] || reject_with_reason "$fields" \
        "$staged_path opens without the module fields; end its //! doc with File:, Author: and Date: lines:"
}

# Rejects a `#` comment directly above a module- or class-level assignment, because an attribute docstring
# below it is what help() and editors show. Directives, bracketed continuations, runnable tours and dotfile
# tool configs are exempt.
check_python_attributes_use_docstrings() {
    case "${staged_path##*/}" in .* | example.py | setup.py) return 0 ;; esac
    local commented
    commented=$(scan_staged_file_marking_added_lines '
        function indent_of(line) { match(line, /^[[:space:]]*/); return RLENGTH }
        function bracket_balance(line,    opened, closed) {
            gsub(/"[^"]*"|\047[^\047]*\047/, "", line); sub(/#.*/, "", line)
            opened = gsub(/[([{]/, "", line); closed = gsub(/[])}]/, "", line)
            return opened - closed
        }
        {
            if (gsub(/"""/, "&") % 2 == 1) { inside_string = !inside_string; next }
            if (inside_string || /^[[:space:]]*$/) next
            if (/^[[:space:]]*#/) {
                comment_line = FNR
                is_directive = ($0 ~ /^[[:space:]]*#[[:space:]]*(region|endregion|noqa|type:|fmt:|pragma|pyright:|ruff:|mypy:|isort:)/)
                next
            }
            depth = indent_of($0)
            if (bracket_depth == 0) {
                while (scopes > 0 && scope_indent[scopes] >= depth) --scopes
                at_attribute_scope = (scopes == 0 || scope_kind[scopes] == "class")
                if (at_attribute_scope && comment_line == FNR - 1 && !is_directive &&
                    $0 ~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*(:[^=]+)?=[^=]/ &&
                    ((comment_line in added) || (FNR in added)))
                    printf "line %d: %s\n", FNR, $0
                if ($0 ~ /^[[:space:]]*class[[:space:]]/) { scope_indent[++scopes] = depth; scope_kind[scopes] = "class" }
                else if ($0 ~ /^[[:space:]]*(async[[:space:]]+)?def[[:space:]]/) { scope_indent[++scopes] = depth; scope_kind[scopes] = "def" }
            }
            bracket_depth += bracket_balance($0)
            if (bracket_depth < 0) bracket_depth = 0
        }')
    [ -z "$commented" ] || reject_with_reason "$commented" \
        "$staged_path documents an attribute with a # comment above it; write a docstring below it instead:"
}

# Rejects a Python module whose first docstring lacks the `File:`, `Author:` and `Date:` lines, because
# the docstring is the one header Python tooling reads. Dotfiles are tool configuration and exempt.
check_python_module_fields() {
    case "${staged_path##*/}" in .*) return 0 ;; esac
    local fields
    fields=$("$fastest_awk" -v path="$staged_path" '
        NR == 1 && /^#!/ { next }
        !opened && /^[[:space:]]*$/ { next }
        !opened { if ($0 !~ /^"""/) { print "line " NR ": no module docstring"; exit } opened = 1; text = $0; if (NR > 0 && $0 ~ /^""".*"""$/ && length($0) > 6) { closed = 1 } else next }
        opened && !closed { text = text "\n" $0; if ($0 ~ /"""/) closed = 1; else next }
        closed {
            if (text !~ ("\nFile: " path "\n")) print "docstring lacks File: " path
            else if (text !~ /\nAuthor: [A-Z][^\n]*\n/) print "docstring lacks Author:"
            else if (text !~ /\nDate: [A-Z][a-z]+ [0-9]+, [0-9][0-9][0-9][0-9]\n/) print "docstring lacks Date: Month D, YYYY"
            exit
        }' <<<"$staged_file_text")
    [ -z "$fields" ] || reject_with_reason "$fields" \
        "$staged_path opens without the module fields; end its docstring with File:, Author: and Date: lines:"
}

# Rejects a one-space continuation inside a TypeScript or JavaScript docblock, because two spaces align the
# text under the opener's, as in the C headers.
check_tsdoc_continuation_two_spaces() {
    local narrow
    narrow=$(scan_staged_file_marking_added_lines '
        is_docblock_opener($0) { inside = 1 }
        inside && (FNR in added) && /^[[:space:]]*\* [^[:space:]]/ && !/^[[:space:]]*\* \// { printf "line %d:%s\n", FNR, $0 }
        /\*\// { inside = 0 }')
    [ -z "$narrow" ] || reject_with_reason "$narrow" \
        "$staged_path indents a docblock line by one space after its *; use two, as the C headers do:"
}

# Rejects a TypeScript, JavaScript or Swift file whose first block is not `@file <path>`, `@author`, `@date` and
# `@brief` in that order, because the header reads the same as a C header does. A shebang may come first.
check_tsdoc_file_header() {
    local header
    header=$("$fastest_awk" -v path="$staged_path" '
        NR == 1 && /^#!/ { shebang_lines = 1; next }
        { header_line = NR - shebang_lines }
        header_line == 1 && $0 != "/**" { print "line " NR ": header must open with /**"; exit }
        header_line == 2 && $0 != " *  @file " path { print "line " NR ": header must read *  @file " path; exit }
        header_line == 3 && $0 !~ /^ \*  @author [A-Z]/ { print "line " NR ": @author expected"; exit }
        header_line == 4 && $0 !~ /^ \*  @date [A-Z][a-z]+ [0-9]+, [0-9][0-9][0-9][0-9]$/ { print "line " NR ": @date Month D, YYYY expected"; exit }
        header_line == 5 { if ($0 !~ /^ \*  @brief [A-Z]/) print "line " NR ": @brief expected"; exit }' <<<"$staged_file_text")
    [ -z "$header" ] || reject_with_reason "$header" \
        "$staged_path opens without its header: @file <path>, @author, @date, @brief:"
}

# Rejects `@brief` below the file header of a TypeScript or JavaScript file, because TSDoc and JSDoc take the
# first sentence as the summary and know no `@brief`.
check_tsdoc_brief_only_in_header() {
    local briefs
    briefs=$(scan_staged_file_marking_added_lines '
        /\*\// && !header_closed { header_closed = 1; next }
        header_closed && (FNR in added) && /^[[:space:]]*\*[[:space:]]*@brief/ { printf "line %d:%s\n", FNR, $0 }')
    [ -z "$briefs" ] || reject_with_reason "$briefs" \
        "$staged_path uses @brief below the file header; let the first sentence be the summary:"
}

# Rejects a `//` comment directly above a top-level TypeScript declaration, because editors show only
# `/** */` TSDoc on hover.
check_tsdoc_above_declarations() {
    local line_comments
    line_comments=$(scan_staged_file_marking_added_lines '
        /^\/\/[^\/]/ || /^\/\/$/ { comment_line = FNR; comment = $0; next }
        comment_line == FNR - 1 && /^(export[[:space:]]+)?(default[[:space:]]+)?(declare[[:space:]]+)?(abstract[[:space:]]+)?(async[[:space:]]+)?(function|class|enum|interface|type|const|let|var)[[:space:]]/ {
            if ((comment_line in added) || (FNR in added)) printf "line %d:%s\n", comment_line, comment
        }
        { comment_line = 0 }')
    [ -z "$line_comments" ] || reject_with_reason "$line_comments" \
        "$staged_path documents a declaration with a bare \`//\` comment; use a /** ... */ TSDoc block:"
}

# Rejects JSDoc `{type}` braces and a `@param` without its ` - `, because the signature carries the types
# and TSDoc separates the name with a hyphen.
check_tsdoc_tag_syntax() {
    local jsdoc_tags
    jsdoc_tags=$(printf '%s\n' "$staged_added_text" | grep -E "$added_docblock_line_pattern" |
        grep -nE '@(param|returns?)[[:space:]]+\{|@param[[:space:]]+[[:alnum:]_]+[[:space:]]+[^-]' || true)
    [ -z "$jsdoc_tags" ] || reject_with_reason "$jsdoc_tags" \
        "$staged_path uses JSDoc tag syntax;" \
        "            write \`@param name - text\` and \`@returns text\`, without {type} braces:"
}

# Rejects `name()` in TypeScript doc prose, because references are `{@link name}`; example lines, which
# end in `;` or assign, are exempt.
check_tsdoc_references_linked() {
    local call_references
    call_references=$(printf '%s\n' "$staged_added_text" | grep -E "$added_docblock_line_pattern" |
        grep -vE '(;|=)[[:space:]]*(//.*)?$|[[:space:]]=[[:space:]]' |
        grep -nE '(^|[^[:alnum:]_.`{])[[:alpha:]_][[:alnum:]_]*\(\)' || true)
    [ -z "$call_references" ] || reject_with_reason "$call_references" \
        "$staged_path references a function as a call in a doc;" \
        "            write {@link name} for an export, or wrap a method call in backticks:"
}

# Rejects a `// Title:` pseudo-heading, because Go doc headings are `// # Title`.
check_go_doc_headings_hash_prefixed() {
    local pseudo_headings
    pseudo_headings=$(printf '%s\n' "$staged_added_text" | grep -nE '^\+[[:space:]]*// [A-Z][A-Za-z ]*:$' || true)
    [ -z "$pseudo_headings" ] || reject_with_reason "$pseudo_headings" \
        "$staged_path uses a Go pseudo-heading ending in a colon;" \
        "            write a doc heading as \`// # Title\` with blank comment lines around it:"
}

# Rejects an exported name spelled as a call in a Go comment, because doc links are `[Name]`.
check_go_doc_links_bracketed() {
    local call_references
    call_references=$(printf '%s\n' "$staged_added_text" | grep -E '^\+[[:space:]]*//' |
        grep -nE '(^|[^[:alnum:]_.[])[A-Z][[:alnum:]_]*[a-z][[:alnum:]_]*\(' || true)
    [ -z "$call_references" ] || reject_with_reason "$call_references" \
        "$staged_path references an exported Go name as a call;" \
        "            link it as [Name] or [Type.Method] instead:"
}

# endregion Binding Docs

# region Comments and Prose

# ASCII "->" arrows inside comments & docstrings - prose uses the Unicode arrow (→). Lines quoting
# code, in a span, a fence or an @code block, are the one legitimate use, so they are exempt.
#
# The arrow is the shape worth matching mechanically, not the whole rule. Prose in this project reads
# as typeset text rather than as source: ≤ ≥ ≠ ≈ × ÷ ± − for relations and arithmetic, … for an
# ellipsis, ⁰¹²³ and ₀₁₂₃ for indices and exponents, ∈ ∉ ⊆ ∪ ∩ ∅ for set talk, ∞ for a bound that has
# none, and │ ├ └ ─ for a tree a diagram would otherwise draw in pipes and dashes. A rule can only
# name the one case it can spot without arguing; the rest is the author's to reach for.
check_ascii_arrows() {
    local arrows comment_opener
    case "$staged_path" in
    *.py | *.pyi | *.mojo) comment_opener='#' ;;
    *.md) comment_opener='^[[:space:]]*#|^[[:space:]]*\*([[:space:]]|$)' ;;
    *) comment_opener='\/\/|\/\*|^[[:space:]]*\*([[:space:]]|$)' ;;
    esac
    arrows=$(scan_staged_file_marking_added_lines '
        { body = $0; sub(/^[[:space:]]*(\/\/[\/!]?|#|\*)?[[:space:]]*/, "", body) }
        body ~ /^```/ { inside_fence = !inside_fence; next }
        /@(code|verbatim)/ { inside_code = 1 }
        /@end(code|verbatim)/ { inside_code = 0; next }
        !inside_fence && !inside_code && (FNR in added) {
            prose = without_code_spans($0); gsub(/"(\\.|[^"\\])*"/, "\"\"", prose); gsub(/@c[[:space:]]+[^[:space:]]+/, "C", prose)
            if (prose ~ /(('"$comment_opener"').*(<->|->|<-([^-]|$)))/) printf "line %d: %s\n", FNR, $0
        }')
    [ -z "$arrows" ] || reject_with_reason "$arrows" \
        "$staged_path writes an arrow as '->', '<-' or '<->' in a comment - prose takes → ← ↔, and the same goes for ≤ ≥ ≠ × … ∈:"
}

# Rejects a Unicode arrow glued to a neighbour in prose, because `FP8 → FP16` reads as a relation and
# `FP8→FP16` as one token. Code spans, fences and @code or @verbatim blocks are exempt.
check_unicode_arrows_spaced() {
    local glued
    glued=$(scan_staged_file_marking_added_lines '
        { body = $0; sub(/^[[:space:]]*(\/\/[\/!]?|#|\*)?[[:space:]]*/, "", body) }
        body ~ /^```/ { inside_fence = !inside_fence; next }
        /@(code|verbatim)/ { inside_code = 1 }
        /@end(code|verbatim)/ { inside_code = 0; next }
        !inside_fence && !inside_code && (FNR in added) {
            prose = without_code_spans($0)
            if (prose ~ /[^[:space:]](→|←|↦|↔)|(→|←|↦|↔)[^[:space:]]/) printf "line %d: %s\n", FNR, $0
        }')
    [ -z "$glued" ] || reject_with_reason "$glued" \
        "$staged_path glues a Unicode arrow to its neighbours; write a space on each side, as in FP8 → FP16:"
}

# Rejects a backtick in a docblock, because Doxygen renders it literally; `//` comments keep backticks.
check_docblock_without_backticks() {
    local spans
    spans=$(scan_staged_file_marking_added_lines '
        /^[[:space:]]*\/\*[*!]/ { inside = 1 }
        inside && /@(code|verbatim)/ { inside_code = 1 }
        (FNR in added) && /`/ && ((inside && !inside_code) || /^[[:space:]]*\/\/[\/!]/) { printf "line %d: %s\n", FNR, $0 }
        inside && /@end(code|verbatim)/ { inside_code = 0 }
        /\*\// { inside = 0; inside_code = 0 }')
    [ -z "$spans" ] || reject_with_reason "$spans" \
        "$staged_path puts a backtick span in a docblock; write @c name, @p parameter, <tt>span</tt> or @code{.language}:"
}

# Rejects a comment line that is only a `Usage:`, `Commands:` or `Example usage:` label, because a sentence
# introduces a code block and the block names its language. Python sections and Go, checked apart, are exempt.
check_usage_label_absent() {
    local labels
    case "$staged_path" in *.py | *.pyi | *.go) return 0 ;; esac
    labels=$(printf '%s\n' "$staged_added_text" |
        grep -nE '^\+[[:space:]]*(\*|//[/!]?|#)[[:space:]]*(Usage|Commands|Example usage|Examples?|Invocation|Or locally|Run)( [a-z]+)?:[[:space:]]*$' || true)
    [ -z "$labels" ] || reject_with_reason "$labels" \
        "$staged_path labels a code block with a pseudo-heading; introduce it with a sentence ending in a colon:"
}

# Rejects two empty comment lines in a row, because one empty line separates paragraphs and a second
# only stretches the block.
check_empty_comment_lines_single() {
    local doubled
    doubled=$(scan_staged_file_marking_added_lines '
        {
            marker = ""; if (match($0, /^[[:space:]]*(\*|\/\/\/?!?)[[:space:]]*$/)) { marker = $0; gsub(/[[:space:]]/, "", marker) }
            if (marker != "" && marker == previous_marker && ((FNR in added) || ((FNR - 1) in added))) printf "line %d: a second empty comment line\n", FNR
            previous_marker = marker
        }')
    [ -z "$doubled" ] || reject_with_reason "$doubled" \
        "$staged_path leaves two empty comment lines in a row; keep one between paragraphs:"
}

# Comments describe what the code is, never what it was. Git holds the history.
check_backward_references() {
    local history
    history=$(printf '%s\n' "$staged_added_text" |
        grep -iE '(//|/\*|^\+[[:space:]]*\*).*\b(used to be|no longer|was formerly|previously|as before)\b' || true)
    [ -z "$history" ] || reject_with_reason "$history" \
        "$staged_path has a backward-looking comment - describe the present, git holds the history:"
}

# A design justified by another project's design ages into a lie the moment that project moves.
check_sibling_justification() {
    local excuses
    # Naming a sibling as a dependency, an oracle or a data source is fine, and excused first, as is an
    # include's trailing list of the symbols it brings in.
    excuses=$(printf '%s\n' "$staged_added_text" |
        grep -E '(//|/\*|^\+[[:space:]]*\*)' |
        grep -vE '^\+[[:space:]]*#[[:space:]]*include[[:space:]]*[<"][^>"]*[>"][[:space:]]*//[[:space:]]*`[^`]*`(,[[:space:]]*`[^`]*`)*[[:space:]]*$' |
        grep -iE "$sibling_projects" |
        grep -viE '\b(ships?|provides?|supplies|computes?|generates?|depends? on|vendored|submodule|requires?|installs?|see|@see)\b' |
        grep -iE '\b(match(es|ing)?|mirrors?|mimics?|borrow(s|ed)?|follow(s|ing)?|same|like|takes|convention|idiom|shape|split|the way|sibling)\b' || true)
    [ -z "$excuses" ] || reject_with_reason "$excuses" \
        "$staged_path justifies a decision by another repo - state what this code does and why:"
}

# Rejects `Dtype` in any name or prose, and a miscased proper name in a comment, because each name has one
# spelling: DType, NVIDIA, NumPy, AArch64, x86, NEON, SVE, RVV.
check_proper_names_capitalized() {
    local miscased
    miscased=$({
        printf '%s\n' "$staged_added_text" | grep -E '^\+.*([A-Za-z_]Dtype|\bDtype\b)'
        printf '%s\n' "$staged_added_text" | grep -E '^\+[[:space:]]*(//|/\*|\*|#)' |
            sed -E 's/`[^`]*`//g; s#https?://[^[:space:]]*##g' |
            grep -E '\b(Nvidia|Aarch64|X86|Neon|Sve|Rvv)\b|(^|[^[:alnum:]_./])numpy([^[:alnum:]_./]|$)'
    } || true)
    [ -z "$miscased" ] || reject_with_reason "$miscased" \
        "$staged_path miscases a name; write DType, NVIDIA, NumPy, AArch64, x86, NEON, SVE and RVV:"
}

# endregion Comments and Prose

# region C and C++ Idioms

# Rejects an abbreviation from `abbreviations_refused`, such as `hi` or `lo` for register halves, because
# names and prose spell words out. A bare one in a comment always fires; in code only a name new since HEAD
# fires, so touching a line never forces a rename the commit is not about. A path HEAD lacks, whether new or a
# rename git cannot pair, is weighed against every name in HEAD's headers, as it reuses the library's types.
# A capitalized macro the file does not define, like the kernel's `RISCV_HWPROBE_EXT_ZABHA`, belongs to another
# project and never fires, as do literal contents, names the standard qualifies as `std::align_val_t`, and names
# under `third_party_identifier_prefixes`.
check_abbreviations_spelled_out() {
    local abbreviated previous_text
    previous_text=$(git show "HEAD:$staged_path" 2> /dev/null) ||
        previous_text=${head_header_names:=$(git grep -h -o -w -E '[A-Za-z_][A-Za-z0-9_]*' HEAD -- include | sort -u)}
    abbreviated=$("$fastest_awk" -v abbreviations="$abbreviations_refused" -v third_party="$third_party_identifier_prefixes" '
        BEGIN {
            count = split(abbreviations, words, " "); for (word = 1; word <= count; ++word) banned[words[word]] = 1
            prefix_count = split(third_party, prefixes, " ")
        }
        function is_third_party(token,    prefix) {
            for (prefix = 1; prefix <= prefix_count; ++prefix) if (index(token, prefixes[prefix]) == 1) return 1
            return 0
        }
        function has_banned_segment(token,    segments, total, segment) {
            total = split(token, segments, "_")
            for (segment = 1; segment <= total; ++segment) if (tolower(segments[segment]) in banned) return 1
            return 0
        }
        FILENAME == ARGV[1] {
            line = $0
            while (match(line, /[A-Za-z_][A-Za-z0-9_]*/)) { existing[substr(line, RSTART, RLENGTH)] = 1; line = substr(line, RSTART + RLENGTH) }
            next
        }
        FILENAME == ARGV[2] {
            line = $0
            if (match(line, /^[[:space:]]*#[[:space:]]*define[[:space:]]+[A-Za-z_][A-Za-z0-9_]*/)) {
                macro = substr(line, RSTART, RLENGTH); sub(/.*define[[:space:]]+/, "", macro); defined[macro] = 1
            }
            while (match(line, /[A-Za-z_][A-Za-z0-9_]*/)) { declared[substr(line, RSTART, RLENGTH)] = 1; line = substr(line, RSTART + RLENGTH) }
            next
        }
        FILENAME == ARGV[3] { original[FNR] = substr($0, 2); next }
        {
            prose = ($0 ~ /^\+[[:space:]]*(\*([[:space:]]|$)|\/\*|\/\/)/)
            line = substr($0, 2); previous = ""
            if (prose) { gsub(/"[^"]*"/, "", line); gsub(/`[^`]*`/, "", line); gsub(/<\/tt>/, "\001", line); gsub(/<tt>[^\001]*\001/, "", line); gsub(/@[pc][[:space:]]+[^[:space:]]+/, "", line) }
            while (match(line, /[A-Za-z_][A-Za-z0-9_]*/)) {
                token = substr(line, RSTART, RLENGTH); accessor = substr(line, 1, RSTART - 1); line = substr(line, RSTART + RLENGTH)
                standard = accessor == "::" && previous == "std"; previous = token
                if (!has_banned_segment(token) || accessor ~ /(\.|->)$/ || standard || is_third_party(token)) continue
                if (token == toupper(token) && !(token in defined)) continue
                if (prose && (token in declared || token == toupper(token))) continue
                if ((prose && token !~ /_/) || !(token in existing)) { print "    " token ": " original[FNR]; break }
            }
        }' <(printf '%s\n' "$previous_text") \
        "$staged_code_path" \
        <(printf '%s\n' "$staged_added_text") "$staged_added_unquoted_path" || true)
    [ -z "$abbreviated" ] || reject_with_reason "$abbreviated" \
        "$staged_path abbreviates a word this project spells out; write \`high\`, \`low\`, \`accumulator\`, and so on:"
}

# Template parameters are private names; public aliases belong inside the instantiated type.
check_template_parameter_names() {
    local names
    names=$(scan_staged_file_marking_added_lines '
        function check_parameter(    declaration, words, count, name) {
            declaration = parameter
            sub(/=.*/, "", declaration)
            gsub(/\.\.\./, " ", declaration)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", declaration)
            count = split(declaration, words, /[[:space:]]+/)
            name = words[count]
            if (changed && count > 1 && name ~ /^[A-Za-z_][A-Za-z0-9_]*$/ && name !~ /_$/)
                printf "line %d: %s\n", FNR, declaration
            parameter = ""; changed = 0
        }
        {
            code = $0
            while (code != "") {
                if (!depth) {
                    if (!match(code, /(^|[^A-Za-z0-9_])template[[:space:]]*</)) break
                    code = substr(code, RSTART + RLENGTH)
                    depth = 1; parameter = ""; changed = 0
                }
                character = substr(code, 1, 1); code = substr(code, 2)
                if (FNR in added) changed = 1
                if (character == "<") ++depth
                else if (character == ">") {
                    if (!--depth) { check_parameter(); continue }
                }
                else if (character == "," && depth == 1) { check_parameter(); continue }
                parameter = parameter character
            }
            if (depth) parameter = parameter " "
        }' "$staged_code_path")
    [ -z "$names" ] || reject_with_reason "$names" \
        "$staged_path exposes a template parameter name; append an underscore and define public aliases inside:"
}

# Rejects a split string literal whose non-final fragment lacks a trailing `//`, because clang-format
# restitches unpinned fragments into a staircase.
check_split_string_literal_pinned() {
    local unpinned
    unpinned=$(scan_staged_file_marking_added_lines '
        (FNR in added) && ((FNR - 1) in added) && previous ~ /"[[:space:]]*$/ && previous !~ /\/\/[[:space:]]*$/ &&
            $0 ~ /^[[:space:]]*"/ { print FNR - 1 ": " previous }
        { previous = $0 }')
    [ -z "$unpinned" ] || reject_with_reason "$unpinned" \
        "$staged_path splits a string literal without a trailing \`//\` pin;" \
        "            end every fragment but the last with \`\" //\`:"
}

# A `bool` parameter that steers behaviour reads as `f(x, true)` at the call site, which tells the
# reader nothing. Name the states in an enum, ideally a scoped one backed by `bool`.
check_boolean_parameters() {
    local switches
    # A single-argument `explicit` constructor wraps a boolean VALUE rather than selecting behaviour,
    # and a `fallback` is the value an unset setting reads as, not a switch.
    switches=$(printf '%s\n' "$staged_added_text" |
        grep -E '\b(bool)[[:space:]]+[a-z_][a-z_0-9]*[[:space:]]*[,)]' |
        grep -vE '\b(is|has|was|can|should|contains|empty|equals)_?' |
        grep -vE '\bbool[[:space:]]+fallback\b' |
        grep -vE 'explicit[[:space:]]+[a-z_][a-z_0-9]*\([[:space:]]*bool[[:space:]]+[a-z_][a-z_0-9]*\)' || true)
    [ -z "$switches" ] || reject_with_reason "$switches" \
        "$staged_path takes a bool parameter that selects behaviour - name the states in an enum:"
}

# A discarded result binds to a `[[maybe_unused]]` variable. The cast composes with nothing and
# reads as hiding something.
check_void_discards() {
    local casts
    casts=$(grep -E '(^|[^A-Za-z0-9_])\(void\)[[:space:]]*[A-Za-z_:(]' "$staged_added_code_path" || true)
    [ -z "$casts" ] || reject_with_reason "$casts" \
        "$staged_path casts a result to void - bind it to a [[maybe_unused]] variable instead:"
}

# Per-thread state belongs to an object that owns it. A thread_local is global mutable state in its
# worst form, and one whose type has a destructor emits a per-translation-unit initializer that the
# Mach-O linker rejects outright.
check_thread_local() {
    local threaded
    threaded=$(printf '%s\n' "$staged_added_text" |
        grep -vE "$added_comment_line_pattern" |
        grep -E '\bthread_local\b' || true)
    [ -z "$threaded" ] || reject_with_reason "$threaded" \
        "$staged_path declares a thread_local - hand the state to an object that owns it:"
}

# Rejects `std::filesystem` in the library and its bindings, because it throws, allocates paths behind the
# caller's back, and is missing or partial on several targets the bindings ship to; only the test, benchmark
# and tool harnesses may include `<filesystem>`.
check_filesystem_in_harnesses_only() {
    local reached
    reached=$(printf '%s\n' "$staged_added_text" |
        grep -vE "$added_comment_line_pattern" |
        grep -E '\bstd::filesystem\b|#[[:space:]]*include[[:space:]]*<filesystem>' || true)
    [ -z "$reached" ] || reject_with_reason "$reached" \
        "$staged_path uses std::filesystem in library code - it is allowed only in test/, bench/ and tools/ harnesses:"
}

# Rejects the standard containers, `std::pair` and `std::tuple` in the library and its bindings, because the
# containers allocate through the global heap behind the caller's back and throw when it runs out, and a pair
# or a tuple hides what each member means behind `first` and `get<1>`; only the harnesses may use them.
check_std_collections_in_harnesses_only() {
    local reached baseline_path
    for baseline_path in $std_collections_baseline_paths; do
        [ "$staged_path" != "$baseline_path" ] || return 0
    done
    reached=$(printf '%s\n' "$staged_added_text" |
        grep -vE "$added_comment_line_pattern" |
        grep -E '\bstd::(vector|pair|tuple|deque|list|forward_list|map|multimap|set|multiset|unordered_map|unordered_multimap|unordered_set|unordered_multiset|queue|priority_queue|stack|valarray)\b|#[[:space:]]*include[[:space:]]*<(vector|deque|list|forward_list|map|set|unordered_map|unordered_set|queue|stack|valarray)>' ||
        true)
    [ -z "$reached" ] || reject_with_reason "$reached" \
        "$staged_path uses a standard container, std::pair or std::tuple in library code - name a struct, take" \
        "            the caller's buffer or allocator, or move the code to a test/, bench/ or tools/ harness:"
}

# `_t` marks a materialized type and `_k` a materialized constant. A concept names a requirement
# rather than a type, and a class or variable template names a family rather than one member of it, so
# none wears a suffix - the alias or constant that instantiates the template is what carries it.
check_type_suffixes() {
    local concepts templates variables
    concepts=$(printf '%s\n' "$staged_added_text" | grep -E '^\+[[:space:]]*concept[[:space:]]+[A-Za-z_]+_t\b' || true)
    [ -z "$concepts" ] || reject_with_reason "$concepts" \
        "$staged_path suffixes a concept with '_t' - a concept names a requirement, not a type, so it takes no suffix:"
    templates=$(scan_staged_file_marking_added_lines '
        /^[[:space:]]*#/ { next }
        {
            code = $0
            gsub(/"([^"\\]|\\.)*"/, "", code)
            if (!pending && match(code, /(^|[^A-Za-z0-9_])template[[:space:]]*</)) {
                code = substr(code, RSTART + RLENGTH - 1)
                pending = 1; angles = 0; changed = 0; declaration = ""
            }
            if (!pending) next
            if (angles || substr(code, 1, 1) == "<") {
                changed = changed || (FNR in added)
                for (position = 1; position <= length(code); ++position) {
                    character = substr(code, position, 1)
                    if (character == "<") ++angles
                    else if (character == ">" && --angles == 0) break
                }
                if (angles) next
                code = substr(code, position + 1)
            }
            declaration = declaration " " code
            changed = changed || (FNR in added)
            header = declaration
            sub(/[;{].*$/, "", header)
            if (header ~ /(^|[^A-Za-z0-9_])(struct|class)[[:space:]]+[A-Za-z_][A-Za-z0-9_:]*_t([[:space:]]|$|[<:])/) {
                if (changed) printf "line %d: %s\n", FNR, declaration
                pending = 0
            }
            else if (declaration ~ /[;{}]/ || declaration ~ /^[[:space:]]*(using|typedef|inline|static|void|auto)[[:space:]]/) pending = 0
        }' "$staged_code_path" || true)
    [ -z "$templates" ] || reject_with_reason "$templates" \
        "$staged_path suffixes a class template with '_t' - the template stays bare and the alias that materializes it carries the suffix:"
    variables=$(printf '%s\n' "$staged_added_text" | "$fastest_awk" '
        function suffixed(line) { return line ~ /constexpr[[:space:]][^=(]*[[:space:]][A-Za-z0-9_]*_[kt][[:space:]]*=/ }
        /^\+[[:space:]]*template[[:space:]]*</ { if (suffixed($0)) print; else pending = 1; next }
        pending && suffixed($0) { print; pending = 0; next }
        pending && /\{[[:space:]]*$/ { pending = 0; next }
        pending && /^\+[[:space:]]*(typename|class |std::|requires|[A-Za-z_]+ [A-Za-z_]+_|>)/ { next }
        { pending = 0 }')
    [ -z "$variables" ] || reject_with_reason "$variables" \
        "$staged_path suffixes a variable template with '_k' or '_t' - the template stays bare, like \`template <typename type_> constexpr bool bounded\`:"
}

# A header's @date is when the file was created, not when it was last touched. Git records every edit
# since; the header records the one fact git cannot show without archaeology.
check_header_date() {
    local rewritten
    rewritten=$("$fastest_awk" '
        /^-[^-].*@date/ { value = $0; sub(/^.*@date[[:space:]]+/, "", value); removed[value] = $0 }
        /^\+[^+].*@date/ { value = $0; sub(/^.*@date[[:space:]]+/, "", value); added[value] = 1 }
        END { for (value in removed) if (!(value in added)) print removed[value] }' "$staged_diff_path" || true)
    [ -z "$rewritten" ] || reject_with_reason "$rewritten" \
        "$staged_path rewrites the @date in its header - that is the creation date, and git holds the edits:"
}

# `@retval` names one return value per line and binds the FIRST token as that value, so a line opening
# with prose renders a nonsense value column - the same trap `check_section_ids` guards below. This
# codebase lists the outcomes in a `@par Statuses:` list, so the tag is unused.
check_retval() {
    local retval
    retval=$(printf '%s\n' "$staged_added_text" | grep -E '@retval\b' || true)
    [ -z "$retval" ] || reject_with_reason "$retval" \
        "$staged_path uses @retval - list the outcomes under @par Statuses: instead:"
}

# Nothing is deprecated: a symbol either exists or it was removed. Carrying a shim past a breaking
# release means every consumer keeps two spellings alive, and neither ever wins.
check_deprecations() {
    local deprecations
    deprecations=$(printf '%s\n' "$staged_added_text" | grep -iE '@deprecated|#\[deprecated' || true)
    [ -z "$deprecations" ] || reject_with_reason "$deprecations" \
        "$staged_path adds a deprecation - remove the symbol instead, and say so in the commit:"
}

# Rejects `macro_rules!`, because every per-type impl is written out explicitly.
check_rust_macros_absent() {
    local macros
    macros=$(printf '%s\n' "$staged_added_text" | grep -nE 'macro_rules!' || true)
    [ -z "$macros" ] || reject_with_reason "$macros" \
        "$staged_path adds a \`macro_rules!\`;" "            write each impl out explicitly instead:"
}

# Rejects list mutation and self-referencing `set`, because a variable is written once. A `foreach` may
# still append to the list it builds, since CMake has no way to map a list in one `set`, and a
# `TRANSFORM` into an `OUTPUT_VARIABLE` defines a new list rather than mutating its source.
check_cmake_variable_written_once() {
    local mutated
    mutated=$(scan_staged_file_marking_added_lines '
        { sub(/#.*/, "") }
        /^[[:space:]]*foreach[[:space:]]*\(/ { ++loops }
        /^[[:space:]]*endforeach[[:space:]]*\(/ { --loops }
        (FNR in added) && !(loops > 0 && /^[[:space:]]*list[[:space:]]*\([[:space:]]*APPEND[[:space:]]/) { print FNR ":" $0 }' |
        grep -E '^[0-9]+:[[:space:]]*(list[[:space:]]*\([[:space:]]*(APPEND|PREPEND|INSERT|REMOVE_ITEM|REMOVE_AT|REMOVE_DUPLICATES|TRANSFORM|FILTER)[[:space:]]|set[[:space:]]*\([[:space:]]*([A-Za-z0-9_]+)[[:space:]].*\$\{\3\})' |
        grep -vE 'list[[:space:]]*\([[:space:]]*TRANSFORM[[:space:]].*[[:space:]]OUTPUT_VARIABLE[[:space:]]' || true)
    [ -z "$mutated" ] || reject_with_reason "$mutated" \
        "$staged_path mutates a variable after defining it;" \
        "            define it once, and select per-configuration items with generator expressions:"
}

# Rejects CMake spellings the projects agreed on: parsed arguments through `PARSE_ARGV <n> arg`, functions under the
# project prefix, lowercase locals, loop variables and internals with a trailing underscore, uppercase non-cache names
# only for CMake's own, a sibling's options, the published values or third-party inputs, and caches written once.
check_cmake_conventions() { # check_cmake_conventions <path> <staged-text> <added-line-numbers>
    local findings
    findings=$("$fastest_awk" -v path="$1" -v prefix="$project_include_prefix" -v siblings="$sibling_projects" \
        -v published=" $cmake_published_variables $cmake_third_party_variables " '
        function hit(rule, message) {
            if (!(rule in messages)) { order[++rules] = rule; messages[rule] = message }
            if (++hits[rule] <= 5) found[rule] = found[rule] first ": " opening "\n"
        }
        function judge(    name, arguments, tokens, count, variable, cached, forced, index_) {
            match(bare, /[A-Za-z_][A-Za-z0-9_]*/); name = tolower(substr(bare, RSTART, RLENGTH))
            arguments = substr(bare, index(bare, "(") + 1)
            sub(/\)[[:space:]]*$/, "", arguments); sub(/^[[:space:]]+/, "", arguments)
            count = split(arguments, tokens, /[[:space:]]+/)
            if (index(code, "${${")) hit("indirect", "reads a name through `${${`; return through an output parameter")
            if (name == "macro") hit("macro", "defines a `macro()`; write a `function()`")
            if (name == "cmake_parse_arguments" && arguments !~ /^PARSE_ARGV[[:space:]]+[0-9]+[[:space:]]+arg( |$)/)
                hit("parse", "parses arguments other than through `PARSE_ARGV <n> arg`")
            if (name == "function" && (index(tokens[1], prefix "_") != 1 || tokens[1] ~ /_$/))
                hit("function", "names a function without the `" prefix "_` prefix or with a trailing `_`")
            if (name == "foreach" && tokens[1] !~ /_$/) hit("foreach", "names a loop variable without a trailing `_`")
            if (name != "set" || tokens[1] ~ /^(\$|ENV\{)/) return
            variable = tokens[1]
            for (index_ = 2; index_ <= count; ++index_) {
                cached = cached || tokens[index_] == "CACHE"
                forced = forced || tokens[index_] == "FORCE"
            }
            if (cached && forced) hit("force", "forces a cache entry, which is written once")
            if (cached) return
            if (variable ~ /^[a-z_](.*[^_])?$/) hit("lowercase", "sets a lowercase local without a trailing `_`")
            if (variable ~ /^[A-Z]/ && variable !~ "^(CMAKE|" toupper(siblings) ")_" &&
                !index(published, " " variable " "))
                hit("uppercase", "sets an uppercase name outside CMake, the siblings, and the published and third-party lists")
        }
        NR == FNR { added[$1 + 0]; next }
        {
            line_code = ""; line_bare = ""
            for (position = 1; position <= length($0); ++position) {
                character = substr($0, position, 1)
                if (character == "\\") {
                    line_code = line_code substr($0, position, 2)
                    if (!quoted) line_bare = line_bare substr($0, position, 2)
                    ++position; continue
                }
                if (character == "\"") quoted = !quoted
                else if (character == "#" && !quoted) break
                else if (character == "(" && !quoted) ++depth
                else if (character == ")" && !quoted) --depth
                line_code = line_code character
                if (!quoted || character == "\"") line_bare = line_bare character
            }
            if (!open) {
                if (line_bare !~ /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(/) { depth = 0; next }
                open = 1; first = FNR; opening = $0; code = ""; bare = ""; touched = 0
            }
            code = code " " line_code; bare = bare " " line_bare; touched = touched || (FNR in added)
            if (depth <= 0) { if (touched) judge(); open = 0; depth = 0 }
        }
        END {
            for (index_ = 1; index_ <= rules; ++index_)
                printf "pre-commit: %s %s:\n%s", path, messages[order[index_]], found[order[index_]]
        }' \
        "$3" "$2")
    [ -z "$findings" ] && return 0
    printf '%s\n' "$findings"
    return 1
}

# Rejects hand-built RPATHs, because full-path link items already land in the build RPATH.
check_cmake_rpath_derived() {
    local manual
    manual=$(printf '%s\n' "$staged_added_text" | sed -E 's,#.*$,,' |
        grep -nE '(BUILD_RPATH|INSTALL_RPATH|BUILD_WITH_INSTALL_RPATH|-Wl,-rpath)' || true)
    [ -z "$manual" ] || reject_with_reason "$manual" \
        "$staged_path builds an RPATH by hand;" \
        "            link the library by its full path and let CMake derive the RPATH:"
}

# Rejects a test/ or bench/ header opening any file-scope namespace but the one its directory names, because
# `bench/*.hpp` opens `<project_namespace>::bench` and nothing else. A `.h` counts once it holds C++, and an
# enclosing project namespace or `std` may reopen to specialize a template that lives there.
check_harness_namespace_matches_directory() {
    local expected_namespace foreign
    case "$staged_path" in
    test/*.h | bench/*.h)
        grep -qE '(^|[^A-Za-z0-9_])(namespace|template|class)[[:space:]]' <<< "$staged_file_text" || return 0
        ;;
    esac
    expected_namespace="${project_namespace}::${staged_path%/*}"
    expected_namespace=${expected_namespace//\//::}
    case "$staged_path" in
    *.hpp | *.cuh)
        if ! grep -qE "^namespace ${expected_namespace} \{" <<< "$staged_file_text"; then
            reject_with_reason "" "$staged_path does not open \`namespace $expected_namespace {\` in one piece;" \
                "            spell the namespace its directory names on a single line"
            return 0
        fi
        ;;
    esac
    foreign=$("$fastest_awk" -v expected="$expected_namespace" '
        continued { continued = ($0 ~ /\\$/); next }
        /^[[:space:]]*#/ { continued = ($0 ~ /\\$/); next }
        {
            code = $0
            gsub(/"([^"\\]|\\.)*"/, "", code)
            if (depth == 0 && match(code, /(^|[^A-Za-z0-9_])namespace([[:space:]]+[A-Za-z_][A-Za-z0-9_:]*)?[[:space:]]*\{/)) {
                name = substr(code, RSTART, RLENGTH)
                sub(/^.*namespace[[:space:]]*/, "", name)
                sub(/[[:space:]]*\{$/, "", name)
                ++opened
                is_specialization_home = (name == "std" || index(expected, name "::") == 1)
                if (name != expected && !is_specialization_home) printf "line %d: namespace %s\n", NR, (name == "" ? "<anonymous>" : name)
            }
            depth += gsub(/\{/, "{", code) - gsub(/\}/, "}", code)
        }
        END { if (!opened) print "no namespace at all" }' "$staged_code_path")
    [ -z "$foreign" ] || reject_with_reason "$foreign" \
        "$staged_path opens a file-scope namespace other than \`$expected_namespace\`;" \
        "            wrap its contents in the namespace its directory names, and open no other:"
}

# Rejects punctuation in a `#pragma region` name, because clang-format reflows the spacing around it and the
# region stops pairing with its `endregion`. Words, digits and spaces survive.
check_region_label_plain() {
    local punctuated
    punctuated=$(printf '%s\n' "$staged_added_text" |
        grep -E '#pragma (region|endregion)[[:space:]]+[^[:space:]]' |
        grep -vE '#pragma (region|endregion)[[:space:]]+[A-Za-z0-9_]+([[:space:]]+[A-Za-z0-9_]+)*[[:space:]]*$' || true)
    [ -z "$punctuated" ] || reject_with_reason "$punctuated" \
        "$staged_path punctuates a '#pragma region' name, which clang-format reflows until the region" \
        "            and its endregion stop pairing; use words and spaces only:"
}

# Rejects `#pragma mark`, because `#pragma region` is the section marker and folds in more editors.
check_regions_not_pragma_mark() {
    local marks
    marks=$(printf '%s\n' "$staged_added_text" | grep -E '#pragma mark' || true)
    [ -z "$marks" ] || reject_with_reason "$marks" \
        "$staged_path uses '#pragma mark'; write '#pragma region <Name>':"
}

# Rejects two string-literal fragments on one line, because that is exactly what clang-format's
# `BreakStringLiterals` leaves behind; a trailing `//` pins a deliberate split, as for `"\x9F" "e"`. A raw
# string is one literal, whatever quotes it holds.
check_string_fragments_one_per_line() {
    local fragments
    fragments=$("$fastest_awk" 'NR == FNR { fragmented[FNR] = ($0 ~ /"[[:space:]]*"[[:space:]]+"/ && $0 !~ /\/\//); next } fragmented[FNR]' \
        "$staged_added_unquoted_path" <(printf '%s\n' "$staged_added_text") || true)
    [ -z "$fragments" ] || reject_with_reason "$fragments" \
        "$staged_path leaves two string-literal fragments on one line; put each fragment on its own line," \
        "            or pin a deliberate split with a trailing // naming why:"
}

# Rejects an unqualified `memcpy` call in C++, because the standard only promises the name inside `std::`, and a
# raw byte copy should say it is one. A type before the name, rather than a statement keyword, makes the line a
# declaration of a function called `memcpy`, which is not a call.
check_memcpy_qualified() {
    local copies
    copies=$(printf '%s\n' "$staged_added_text" |
        grep -vE "$added_comment_line_pattern" |
        "$fastest_awk" '{
            rest = $0
            while (match(rest, /(^|[^:[:alnum:]_])memcpy[[:space:]]*\(/)) {
                lead = substr(rest, RSTART, RLENGTH) ~ /^memcpy/ ? "" : substr(rest, 1, RSTART)
                rest = substr(rest, RSTART + RLENGTH)
                sub(/[[:space:]*&]+$/, "", lead)
                word = match(lead, /[[:alnum:]_]+$/) ? substr(lead, RSTART, RLENGTH) : ""
                if (lead ~ />$/ || (word != "" && word !~ /^(return|else|do|case|throw|co_return|co_yield|co_await)$/)) continue
                print
                next
            }
        }' || true)
    [ -z "$copies" ] || reject_with_reason "$copies" \
        "$staged_path calls unqualified memcpy; write std::memcpy for a genuine byte copy, or prefer" \
        "            assignment or std::bit_cast where the types should survive:"
}

# Rejects a raw operating-system predefine outside `identity_headers`, because each is read there once into the
# `_OS_*_` identity. Compiler predefines like `__clang__` are read raw wherever they matter.
check_platform_identity_once() {
    case " $identity_headers " in *" $staged_path "*) return 0 ;; esac
    case "$staged_path" in probes/*) return 0 ;; esac
    local raw
    raw=$(predefines="__linux__ __APPLE__ _WIN32 _WIN64 WIN32 \
        __FreeBSD__ __CYGWIN__ __ANDROID__ __wasi__ __EMSCRIPTEN__ __MACH__ \
        $platform_predefines_refused" scan_staged_file_marking_added_lines '
        BEGIN {
            names = ENVIRON["predefines"]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", names); gsub(/[[:space:]]+/, "|", names)
            names = "(^|[^A-Za-z0-9_])(" names ")([^A-Za-z0-9_]|$)"
        }
        (FNR in added) && $0 ~ names { printf "line %d: %s\n", FNR, $0 }' "$staged_code_path")
    [ -z "$raw" ] || reject_with_reason "$raw" \
        "$staged_path reads a raw platform predefine; test the ${macro_prefix}_OS_*_" \
        "            identity $identity_headers derives:"
}

# Rejects `#ifdef` or a positive `defined` of an `_OS_`, `_ARCH_`, `_HAS_`, `_WITH_`, `_ALLOW_` or `_TARGET_`
# switch or of `_DEBUG`, because each holds 0 or 1 and `defined` is true either way. A `!defined` default passes,
# and so does a guard an `#error` follows, as the identity region's override guard.
check_switches_tested_by_value() {
    local switches="${macro_prefix}_((OS|ARCH|HAS|WITH|ALLOW|TARGET)_|DEBUG([^A-Za-z0-9_]|$))" tested
    tested=$(pattern="(^|[^A-Za-z0-9_])defined[[:space:]]*[(]?[[:space:]]*$switches|#[[:space:]]*ifdef[[:space:]]+$switches" \
        defaulted="![[:space:]]*defined[[:space:]]*[(]?[[:space:]]*$switches" scan_staged_file_marking_added_lines '
        {
            first = FNR; fresh = (FNR in added); text = $0
            while (text ~ /\\[[:space:]]*$/ && (getline continuation) > 0) {
                if (FNR in added) fresh = 1
                sub(/\\[[:space:]]*$/, " ", text); text = text continuation
            }
        }
        text ~ /^[[:space:]]*$/ { next }
        text ~ /^[[:space:]]*#[[:space:]]*error/ { held = ""; next }
        {
            if (held != "") print held
            held = ""; probe = text; gsub(ENVIRON["defaulted"], "", probe)
            if (fresh && probe ~ ENVIRON["pattern"]) held = "line " first ": " text
        }
        END { if (held != "") print held }' "$staged_code_path")
    [ -z "$tested" ] || reject_with_reason "$tested" \
        "$staged_path tests a ${macro_prefix}_ switch with defined or #ifdef, which is true at 0 too; test it with #if:"
}

# Rejects a `_USE_`, `_IS_`, `_ON_`, `_DETECT_`, `_DEFINED_` or `_AVOID_` macro, because a build choice is a
# `_WITH_`, `_ALLOW_` or `_TARGET_` switch and a platform fact an `_OS_`, `_ARCH_` or `_HAS_` one.
check_macro_families() {
    local outside
    outside=$(printf '%s\n' "$staged_added_text" |
        grep -E "(^|[^A-Za-z0-9_]|-D)${macro_prefix}_(USE|IS|ON|DETECT|DEFINED|AVOID)_" || true)
    [ -z "$outside" ] || reject_with_reason "$outside" \
        "$staged_path names a macro family outside the vocabulary; use a _WITH_, _ALLOW_ or _TARGET_ switch," \
        "            or an _OS_, _ARCH_ or _HAS_ fact:"
}

# endregion C and C++ Idioms

# region Formatters

# Rejects clang-format drift on the staged hunks of a C, C++, CUDA, HIP or Metal file, because `.clang-format` is
# the law; like `git clang-format --staged`, it leaves untouched lines alone.
check_clang_format_on_changed_lines() {
    command -v clang-format > /dev/null 2>&1 && [ -f .clang-format ] || return 0
    clang-format --dry-run -Werror --assume-filename="$staged_path" $(< "$staged_ranges_path") \
        < "$staged_text_path" > /dev/null 2>&1 && return 0
    reject_with_reason "" "$staged_path is not clang-format clean on its changed lines;" \
        "            run: git clang-format --staged, or clang-format -i $staged_path for the whole file, then restage"
}

# Rejects cmake-format drift on the whole staged file, because `.cmake-format.py` is the law. The index holds what
# the commit records, while the working tree may carry the next group's edits.
check_cmake_format_clean() {
    command -v cmake-format > /dev/null 2>&1 && [ -f .cmake-format.py ] || return 0
    cmake-format -c .cmake-format.py --check "$staged_text_path" > /dev/null 2>&1 && return 0
    reject_with_reason "" "$staged_path is not cmake-format clean;" "            run: cmake-format -i $staged_path"
}

# Rejects gofmt drift on the staged content; it skips without gofmt.
check_gofmt_clean() {
    command -v gofmt > /dev/null 2>&1 || return 0
    [ -z "$(printf '%s\n' "$staged_file_text" | gofmt -l)" ] && return 0
    reject_with_reason "" "$staged_path is not gofmt clean;" "            run: gofmt -w $staged_path"
}

# Rejects rustfmt drift in the Rust files as staged, not as they sit in the working tree, because `rustfmt.toml`
# is the law; `rustfmt_command` names the toolchain that understands it, as in `cargo +nightly fmt`, and the
# check skips without that toolchain or a crate.
check_rustfmt_clean() {
    local toolchain=${rustfmt_command#cargo }
    toolchain=${toolchain%fmt}
    [ -f Cargo.toml ] && rustfmt $toolchain --version > /dev/null 2>&1 || return 0
    local edition staged_rust_path drifted=""
    edition=$(sed -n 's/^edition = "\(.*\)"/\1/p' Cargo.toml)
    for staged_rust_path in $(git diff --cached --name-only --find-renames --diff-filter=ACMR -- '*.rs'); do
        # Reading stdin, `--check` prints its diff yet exits 0, so the diff itself is the verdict.
        [ -z "$(rustfmt $toolchain --edition "$edition" --config-path rustfmt.toml \
            --check < "$results_directory/index/$staged_rust_path" 2> /dev/null)" ] || drifted="$drifted $staged_rust_path"
    done
    [ -z "$drifted" ] || reject_with_reason "" "staged Rust files are not rustfmt clean:$drifted;" \
        "            run: $rustfmt_command"
}

# Rejects Rust imports out of the standard library, external crates, own crate order, or without a blank line
# between those groups and after the last one, which rustfmt leaves alone. It reads the whole source from stdin.
check_rust_use_groups() { # check_rust_use_groups <own-crate> <path> < source
    local findings
    findings=$("$fastest_awk" -v own="$1" -v path="$2" -v quote="'" '
        BEGIN { literal = "r#*\"|\"|" quote "(\\\\.|[^" quote "\\\\])" quote "|//|/\\*" }
        function blanks(width) { return sprintf("%" width "s", "") }
        function count(text, bracket) { return gsub(bracket, "", text) }
        function group(root) {
            if (root == "std" || root == "core" || root == "alloc") return 0
            return root == own || root == "crate" || root == "self" || root == "super" ? 2 : 1
        }
        function blank(from, to,   line) {
            for (line = from; line < to; ++line) if (source[line] ~ /[^[:space:]]/) return 0
            return 1
        }
        {
            source[NR] = $0
            text = $0; masked = ""; plain = 0
            while (text != "") {
                if (depth) {
                    if (!match(text, /\/\*|\*\//)) break
                    depth += substr(text, RSTART, 2) == "/*" ? 1 : -1
                    taken = RSTART + 1
                } else if (closer != "" && !raw) {
                    if (!match(text, /^([^"\\]|\\.)*"/)) break
                    closer = ""; taken = RLENGTH
                } else if (closer != "") {
                    if (!(taken = index(text, closer))) break
                    taken += length(closer) - 1; closer = ""
                } else if (match(text, literal)) {
                    masked = masked substr(text, 1, RSTART - 1)
                    token = substr(text, RSTART, RLENGTH); text = substr(text, RSTART); taken = RLENGTH
                    if (token == "//") break
                    if (token == "/*") depth = 1
                    else if (token ~ /"$/) { raw = token ~ /^r/; closer = "\"" substr(token, 2, RLENGTH - 2) }
                } else { plain = 1; break }
                masked = masked blanks(taken); text = substr(text, taken + 1)
            }
            code[NR] = masked (plain ? text : blanks(length(text)))
        }
        END {
            for (line = 1; line <= NR; ++line) {
                if (!match(code[line], /^ *(pub(\([^)]*\))? +)?use +(::)?[A-Za-z0-9_]+/)) continue
                head = substr(code[line], 1, RLENGTH); rest = substr(code[line], RLENGTH + 1)
                root = head; sub(/^.*[ :]/, "", root)
                for (end = line; !index(rest, ";") && end < NR; rest = code[++end]) {}
                start = line
                while (start > 1 && code[start - 1] ~ /\][[:space:]]*$/) {
                    candidate = start; nesting = 0
                    while (candidate > 1) {
                        --candidate
                        nesting += count(code[candidate], "]") - count(code[candidate], "\\[")
                        if (nesting == 0) break
                    }
                    if (code[candidate] !~ /^[[:space:]]*#\[/) break
                    start = candidate
                }
                match(head, /^ */)
                ++uses; starts[uses] = start; ends[uses] = end; indents[uses] = RLENGTH; roots[uses] = root
            }
            for (use = 1; use <= uses; ++use) {
                category = group(roots[use]); after = source[ends[use] + 1]; gsub(/^[[:space:]]+|[[:space:]]+$/, "", after)
                if (use < uses && indents[use + 1] == indents[use] && blank(ends[use] + 1, starts[use + 1])) {
                    if (group(roots[use + 1]) < category)
                        printf "%s:%d: order imports as standard library, external crates, own crate\n", path, starts[use]
                    if (group(roots[use + 1]) != category && ends[use] + 1 == starts[use + 1])
                        printf "%s:%d: separate import groups with a blank line\n", path, ends[use]
                } else if (ends[use] < NR && after != "" && after != "}")
                    printf "%s:%d: add a blank line after the last import\n", path, ends[use]
            }
        }')
    [ -z "$findings" ] && return 0
    echo "pre-commit: $2 breaks the Rust import groups - standard library, external crates, then the own crate," \
        "a blank line apart:"
    printf '%s\n' "$findings" | head -5
    return 1
}

# Rejects ruff format drift that rewrites an added line or inserts beside one, because `pyproject.toml` is the
# law and legacy lines migrate on their own schedule. It skips without ruff, and on a syntax error, which the
# lint check reports.
check_ruff_format_on_added_lines() {
    command -v ruff > /dev/null 2>&1 || return 0
    local formatted drift
    formatted=$(ruff format --force-exclude --stdin-filename "$staged_path" - < "$staged_text_path" 2> /dev/null) || return 0
    drift=$(diff -U0 "$staged_text_path" <(printf '%s\n' "$formatted") | "$fastest_awk" '
        NR == FNR { added[$1 + 0]; next }
        /^@@/ {
            split($2, range, ",")
            start = -range[1]
            count = (range[2] == "") ? 1 : range[2] + 0
            touching = count == 0 && (start in added || (start + 1) in added)
            for (line = start; line < start + count; ++line) if (line in added) touching = 1
        }
        touching && /^[-+@]/' "$staged_lines_path" -)
    [ -z "$drift" ] || reject_with_reason "$drift" \
        "$staged_path is not ruff-format clean on its added lines; run: ruff format $staged_path," \
        "            or edit them as it would:"
}

# Rejects a ruff lint finding on an added line, because `pyproject.toml` is the law and legacy lines migrate
# on their own schedule. A syntax error fires wherever ruff places it, as an unclosed bracket surfaces at the
# end of the file. It skips without ruff.
check_ruff_lint_on_added_lines() {
    command -v ruff > /dev/null 2>&1 || return 0
    local findings
    findings=$(ruff check --quiet --force-exclude --output-format=concise --stdin-filename "$staged_path" - \
        < "$staged_text_path" 2> /dev/null |
        "$fastest_awk" -F: 'NR == FNR { added[$1 + 0]; next } ($2 + 0) in added || $4 == " invalid-syntax"' \
            "$staged_lines_path" -)
    [ -z "$findings" ] || reject_with_reason "$findings" \
        "$staged_path has ruff lint findings on its added lines; run: ruff check --fix $staged_path," \
        "            or fix them by hand:"
}

# Rejects swift-format lint findings, because `.swift-format` is the law; it skips without swift-format.
check_swift_format_clean() {
    command -v swift-format > /dev/null 2>&1 && [ -f .swift-format ] || return 0
    local staged_swift_paths
    staged_swift_paths=$(git diff --cached --name-only --find-renames --diff-filter=ACMR -- '*.swift')
    [ -n "$staged_swift_paths" ] || return 0
    swift-format lint --strict $staged_swift_paths > /dev/null 2>&1 && return 0
    reject_with_reason "" "staged Swift changes are not swift-format clean;" "            run: swift-format -i <files>"
}

# Rejects taplo drift on staged TOML, because `.taplo.toml` is the law; it skips without taplo or its config.
check_taplo_clean() {
    command -v taplo > /dev/null 2>&1 && [ -f .taplo.toml ] || return 0
    local staged_toml_paths=()
    while IFS= read -r -d '' toml_path; do staged_toml_paths+=("$toml_path"); done \
        < <(git diff --cached --name-only -z --find-renames --diff-filter=ACMR -- '*.toml')
    [ ${#staged_toml_paths[@]} -gt 0 ] || return 0
    taplo fmt --check "${staged_toml_paths[@]}" > /dev/null 2>&1 && return 0
    reject_with_reason "" "staged TOML is not taplo clean;" "            run: taplo fmt"
}

# Rejects dprint drift, because `.dprint.json` is the law; it skips without dprint or its config.
check_dprint_clean() {
    command -v dprint > /dev/null 2>&1 && [ -e .dprint.json ] || return 0
    local staged_json_yaml_paths=()
    while IFS= read -r -d '' json_yaml_path; do staged_json_yaml_paths+=("$json_yaml_path"); done \
        < <(git diff --cached --name-only -z --find-renames --diff-filter=ACMR -- '*.json' '*.jsonc' '*.yml' '*.yaml')
    [ ${#staged_json_yaml_paths[@]} -gt 0 ] || return 0
    dprint check "${staged_json_yaml_paths[@]}" > /dev/null 2>&1 && return 0
    reject_with_reason "" "staged JSON or YAML is not dprint clean;" "            run: dprint fmt"
}

# Rejects unsorted top-level settings keys, `cSpell.words`, and extension recommendations, because a
# case-insensitive order gives every addition one place to go. Whole-line `//` comments are the only JSONC
# these files carry; it skips without jq.
check_editor_settings_sorted() {
    command -v jq > /dev/null 2>&1 || return 0
    local unsorted_list_count
    unsorted_list_count=$(printf '%s\n' "$staged_file_text" | sed -E 's,^[[:space:]]*//.*$,,' |
        jq --arg path "$staged_path" '
            [ (if ($path | endswith("settings.json")) then keys_unsorted else empty end),
              (.["cSpell.words"], .recommendations, .unwantedRecommendations | select(. != null)) ]
            | map(select(. != sort_by(ascii_downcase))) | length' 2> /dev/null)
    [ "${unsorted_list_count:-0}" = 0 ] || reject_with_reason "" \
        "$staged_path has unsorted top-level keys, cSpell.words or extension recommendations;" \
        "            sort them case-insensitively"
}

# Rejects `zig fmt` drift on staged Zig files, because `zig fmt` is the law; it skips without zig.
check_zig_fmt_clean() {
    command -v zig > /dev/null 2>&1 || return 0
    local staged_zig_paths=()
    while IFS= read -r -d '' zig_path; do staged_zig_paths+=("$zig_path"); done \
        < <(git diff --cached --name-only -z --find-renames --diff-filter=ACMR -- '*.zig')
    [ ${#staged_zig_paths[@]} -gt 0 ] || return 0
    zig fmt --check "${staged_zig_paths[@]}" > /dev/null 2>&1 && return 0
    reject_with_reason "" "staged Zig changes are not zig-fmt clean;" "            run: zig fmt ${staged_zig_paths[*]}"
}

# Rejects `mojo format` drift on a staged Mojo file; `mojo format` has no check mode, so a copy is formatted
# and compared at 120 columns. It skips without mojo.
check_mojo_format_clean() {
    command -v mojo > /dev/null 2>&1 || return 0
    local formatted_directory formatted_copy
    formatted_directory=$(mktemp -d) && formatted_copy="$formatted_directory/copy.mojo"
    printf '%s\n' "$staged_file_text" > "$formatted_copy"
    mojo format -q -l 120 "$formatted_copy" > /dev/null 2>&1
    printf '%s\n' "$staged_file_text" | diff -q - "$formatted_copy" > /dev/null 2>&1 ||
        reject_with_reason "" "$staged_path is not mojo-format clean;" "            run: mojo format -l 120 $staged_path"
    rm -rf "$formatted_directory"
}

# endregion Formatters

# region All Files

# Compiled byte-code, caches and build output never belong in the tree. This one is a belt to
# .gitignore's braces: a `git add -f` or a stale index entry still gets caught here.
check_generated_artifacts() {
    case "$staged_path" in
    *.pyc | *.pyo | *__pycache__* | *.egg-info* | .pytest_cache/* | wheelhouse/* | dist/*)
        echo "pre-commit: $staged_path is generated output and must not be committed"
        rejection_count=$((rejection_count + 1))
        ;;
    esac
}

# CI workflows - every job and every step carries a `name:`. An unnamed step renders as its raw
# command in the Actions UI, and job names are what branch protection's required checks reference,
# so an anonymous one can't be pinned. Names are structure, not lines, so unlike the checks above
# this validates the whole staged file - the workflows are small and already conform.
check_workflow_names() {
    local nameless
    nameless=$(
        printf '%s\n' "$staged_file_text" | "$fastest_awk" '
            # Jobs: two-space keys under the top-level `jobs:` section, named by a four-space `name:`.
            /^jobs:[[:space:]]*$/ { in_jobs = 1; next }
            in_jobs && /^[^ #]/ { in_jobs = 0 }
            in_jobs && /^  [A-Za-z_][A-Za-z0-9_-]*:[[:space:]]*$/ {
                if (job != "" && !job_named) printf "line %d: job `%s` has no name\n", job_line, job
                job = substr($1, 1, length($1) - 1); job_line = NR; job_named = 0
            }
            in_jobs && /^    name:/ { job_named = 1 }
            # Steps: list items two deeper than their `steps:`, named inline or by a key two deeper.
            /^[[:space:]]*steps:[[:space:]]*$/ { steps_at = index($0, "steps:") - 1; item_at = steps_at + 2; pending = 0; next }
            steps_at {
                indent = match($0, /[^ ]/) - 1
                if ($0 ~ /^[[:space:]]*(#|$)/) next
                if (indent <= steps_at) { if (pending) printf "line %d: unnamed step\n", pending; steps_at = 0; next }
                if (indent == item_at && substr($0, item_at + 1, 2) == "- ") {
                    if (pending) printf "line %d: unnamed step\n", pending
                    pending = ($0 ~ /^[[:space:]]*- name:/) ? 0 : NR
                } else if (pending && indent == item_at + 2 && $0 ~ /^[[:space:]]*name:/) pending = 0
            }
            END {
                if (job != "" && !job_named) printf "line %d: job `%s` has no name\n", job_line, job
                if (pending) printf "line %d: unnamed step\n", pending
            }
        '
    )
    [ -z "$nameless" ] || reject_with_reason "$nameless" \
        "$staged_path has CI jobs or steps without a name - the Actions UI and required" \
        "            checks reference them by it, so every job and step must carry one:"
}

# Rejects an added banner ruler outside Markdown: a comment that opens or closes on a run of `---`, `===`, `####`,
# `////`, `***` or horizontal box-drawing strokes, a line of such runs around an optional label, or a string literal
# that prints one. Box corners and verticals stay free for diagrams, a `|` line for Markdown tables, and YAML keeps
# its `---` document marker. Reads `+` lines, or a whole diff, from stdin.
check_banners() { # check_banners <path> < added-lines
    case "$1" in
    *.c | *.h | *.cc | *.cpp | *.cxx | *.hpp | *.hxx | *.cu | *.cuh | *.hip | *.metal | *.pml | *.py | *.pyi | *.pyx | \
        *.rs | *.go | *.zig | *.mojo | *.js | *.mjs | *.cjs | *.ts | *.mts | *.tsx | *.swift | *.java | *.kt | *.cs | \
        *.toml | *.yml | *.yaml | *.cmake | *CMakeLists.txt | *.sh) ;;
    *) return 0 ;;
    esac
    local rulers
    rulers=$("$fastest_awk" -v path="$1" -v quote="'" '
        BEGIN {
            stroke = "(─|━|┄|┅|┈|┉|╌|╍|═)"
            run = "(---+|===+|####+|////+|\\*\\*\\*+|" stroke stroke stroke "+)"
            marker = "^(#|//|/\\*|\\*|--|;)[!/*<]?[ \t]*"
            printed = "(----+|====+|####+|" stroke stroke stroke "+)"
            literal = "[\"" quote "][ \t]*" printed "|" printed "[ \t]*[\"" quote "]"
        }
        /^\+/ {
            text = substr($0, 2); sub(/^[ \t]+/, "", text); sub(/[ \t\r]+$/, "", text)
            if (text == "---" && path ~ /\.ya?ml$/) next
            if (text ~ ("^" run "([ \t].*[ \t]" run ")?$") || text ~ (marker run "[ \t]*(\\*/)?([ \t]|$)") ||
                (text ~ marker && text ~ ("[ \t]" run "[ \t]*(\\*/)?$")) || (text ~ literal && text !~ /\|/))
                print
        }')
    [ -z "$rulers" ] && return 0
    echo "pre-commit: $1 adds a banner ruler; name a section with #pragma region or # region, or a plain sentence:"
    printf '%s\n' "$rulers" | head -5
    return 1
}

# Rejects an in-band `// clang-format off|on` or `# cmake-format: off|on` line, because a file must format
# clean as a whole; the line anchor lets prose name the directive.
check_formatter_toggles_absent() {
    local toggles
    toggles=$(printf '%s\n' "$staged_added_text" |
        grep -nE '^\+[[:space:]]*(//[[:space:]]*clang-format[[:space:]]+(on|off)|#[[:space:]]*cmake-format:[[:space:]]*(on|off))[[:space:]]*$' || true)
    [ -z "$toggles" ] || reject_with_reason "$toggles" \
        "$staged_path disables a formatter in-band;" \
        "            teach .clang-format or .cmake-format.py the construct instead of fencing a region off:"
}

# Rejects two or more spaces after `.`, `!` or `?` before a capital, because prose uses one space between
# sentences. Lines tagged `nk-nolint: spacing` and C-family literal contents, which are data, are exempt.
check_single_space_between_sentences() {
    local doubled
    doubled=$(grep -v 'nk-nolint: spacing' "$staged_added_unquoted_path" |
        sed -E 's,^\+,,; s,^[[:space:]]*(//[/!]?|#|\*),,' |
        grep -nE '[.!?]  +[A-Z]' || true)
    [ -z "$doubled" ] || reject_with_reason "$doubled" \
        "$staged_path double-spaces between sentences;" "            use a single space after . ! or ?:"
}

