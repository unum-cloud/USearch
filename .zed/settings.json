// Zed workspace settings for USearch, mirroring .vscode/settings.json and the
// repo's .clang-format / .cmake-format.py / pyproject.toml / .swift-format.
//
// Top-level keys stay sorted. Whitespace follows .editorconfig and .clang-format - 4 spaces, a final newline, no
// trailing whitespace - and the Git, outline and project panels dock left, although Git's defaults to the right.
{
  // Languages Zed doesn't ship built-in.
  "auto_install_extensions": {
    "cmake": true,
    "toml": true,
    "swift": true,
    "csharp": true,
    "java": true
  },
  "ensure_final_newline_on_save": true,
  // Keep the project panel, search, and file-watcher out of the heavy dirs.
  // Hiding the submodules trims only Zed's own indexing - clangd reads them
  // off disk through the compilation database. `data` symlinks into the 12 TB
  // share, which the scanner must not walk.
  "file_scan_exclusions": [
    "**/.git",
    "**/build",
    "**/build_*",
    "**/_deps",
    "**/.build",
    "**/prebuilds",
    "**/target",
    "**/obj",
    "**/node_modules",
    "**/data",
    "**/numkong",
    "**/stringzilla",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/.cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.mypy_cache",
    "**/Testing",
    "**/tmp",
    "**/*.log"
  ],
  // No CUDA grammar here, so highlight the kernels as C++; clangd covers the
  // rest through the `-xcuda` rule in .clangd.
  "file_types": {
    "C++": ["*.cu", "*.cuh"]
  },
  "format_on_save": "on",
  "git_panel": {
    "dock": "left"
  },
  "hard_tabs": false,
  "languages": {
    // clang-format from PyPI, floored at 22 - the release that understands
    // this repo's BinPackLongBracedList / InsertNewlineAtEOF keys.
    "C": {
      "formatter": {
        "external": {
          "command": "uvx",
          "arguments": ["clang-format>=22", "--style=file", "--assume-filename=a.cpp"]
        }
      }
    },
    "C++": {
      "formatter": {
        "external": {
          "command": "uvx",
          "arguments": ["clang-format>=22", "--style=file", "--assume-filename=a.cpp"]
        }
      }
    },
    // cmake-format with the repo profile in .cmake-format.py.
    "CMake": {
      "formatter": {
        "external": {
          "command": "uvx",
          "arguments": ["--from", "cmakelang", "cmake-format", "-c", ".cmake-format.py", "-"]
        }
      }
    },
    // ruff formats and sorts imports per pyproject.toml; pyright types.
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "format_on_save": "on",
      "formatter": [
        {
          "code_actions": {
            "source.organizeImports.ruff": true
          }
        },
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    },
    "Go": {
      "format_on_save": "on"
    },
    // Java formatting is intentionally off, as in .vscode.
    "Java": {
      "format_on_save": "off",
      "tab_size": 4
    },
    "JavaScript": {
      "tab_size": 4,
      "prettier": {
        "single_quote": true,
        "use_tabs": false,
        "tab_width": 4
      }
    },
    "TypeScript": {
      "tab_size": 4,
      "prettier": {
        "single_quote": true,
        "use_tabs": false,
        "tab_width": 4
      }
    },
    // YAML at 2 spaces per .editorconfig.
    "YAML": {
      "tab_size": 2,
      "prettier": {
        "single_quote": true,
        "tab_width": 2
      }
    },
    // Needs `swift-format` on PATH; comment out if it isn't installed.
    "Swift": {
      "formatter": {
        "external": {
          "command": "swift-format",
          "arguments": ["format", "--configuration", ".swift-format", "-"]
        }
      }
    },
    // remark-math keeps the $...$ LaTeX in the design docs intact; plain
    // remark escapes subscript underscores and breaks equations on save.
    // --no-install pins to repo-local node_modules, which package.json does
    // not ship yet: `npm install -D remark-cli remark-gfm remark-math`.
    "Markdown": {
      "formatter": {
        "external": {
          "command": "npx",
          "arguments": [
            "--no-install",
            "remark",
            "--quiet",
            "--use",
            "remark-gfm",
            "--use",
            "remark-math",
            "-s",
            "emphasis:'_',strong:'_',bullet:'-'"
          ]
        }
      }
    }
  },
  "lsp": {
    // The compilation database is settled by .clangd, not here: a
    // --compile-commands-dir flag would override it and desynchronise the
    // two editors. --query-driver lets clangd interrogate the host and CUDA
    // drivers for their built-in system headers.
    "clangd": {
      "arguments": [
        "--background-index",
        "--clang-tidy",
        "--header-insertion=never",
        "--query-driver=/usr/bin/g++*,/usr/bin/gcc*,/usr/bin/clang*,/usr/local/cuda*/bin/nvcc,/opt/homebrew/opt/llvm/bin/clang*"
      ]
    },
    // Optional native deps aren't always importable in the editor.
    "pyright": {
      "settings": {
        "python": {
          "analysis": {
            "diagnosticSeverityOverrides": {
              "reportMissingImports": "none"
            }
          }
        }
      }
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "remove_trailing_whitespace_on_save": true,
  "tab_size": 4
}
