{
  "indentWidth": 2,
  "lineWidth": 120,
  "newLineKind": "lf",
  "includes": ["**/*.{json,jsonc,yaml,yml,md}"],
  "excludes": [
    "**/.git/",
    "**/.pixi/",
    "**/.venv/",
    "**/.zig-cache/",
    "**/build*/",
    "**/dist/",
    "**/node_modules/",
    "**/package-lock.json",
    "**/prebuilds/",
    "**/target/",
    "**/zig-out/",
    "data/",
    "forkunion/",
    "numkong/",
    "smashtable/",
    "stringzilla/"
  ],
  "markdown": {
    "textWrap": "maintain",
    "strongKind": "underscores",
    "table.cellPadding": "align",
    "codeBlock.skipFormat": true,
    "html.skipFormat": true
  },
  "plugins": [
    "https://plugins.dprint.dev/json-0.23.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/markdown-0.26.0.wasm"
  ]
}
